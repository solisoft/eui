/target/
*.log
.DS_Store
/crates/*/fuzz/target/
/crates/*/fuzz/corpus/
/crates/*/fuzz/artifacts/
# A Soli app's publisher key, generated on first serve; never committed.
**/config/eui_publisher.pkcs8

# A Soli app's environment: never committed.
**/.env
**/.env.*
!**/.env.example

# Album art fetched from a catalogue at runtime: a cache, never committed.
examples/demo-app/public/covers/
# Pictures fetched from x.com for the feed, cached as PNG the same way.
examples/demo-app/public/x/
# What the tracker's Play button mixes: generated, never committed.
examples/demo-app/public/tracker/
