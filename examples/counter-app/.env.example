# Needle (the `music` component) reads its catalogue from Spotify when these
# are set, and from its own generated one when they are not. Copy this file
# to `.env` — Soli loads it once at server boot — and fill in a client from
# https://developer.spotify.com/dashboard.
#
# Client credentials: search, artist, record. No user, no consent screen.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The market a top-tracks list is chosen for. Defaults to FR.
SPOTIFY_MARKET=FR

# Playing on a device you already have open (Spotify Connect, Premium
# only) needs your account, not just the app's. Click "connect account" in
# the player: it opens the consent screen, and the page Spotify comes back
# to hands you the line to paste here. It is good for months.
#
# Do that link from `soli serve examples/counter-app --port 8888`: a
# packaged desktop build refuses every browser request at its launcher
# gate, the callback included. Once the line below is set, the packaged
# app needs no route — it only spends the token.
SPOTIFY_REFRESH_TOKEN=

# Where Spotify sends the browser back. It must read exactly the same on
# the developer dashboard, and since April 2025 Spotify accepts only HTTPS
# or the loopback IP — `localhost` is refused, `127.0.0.1` is not. The
# installed app pins its port to 8888 for this reason.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/spotify/callback

# An access token pasted by hand instead, if you have one. It expires in
# an hour; the refresh token above is the durable way.
SPOTIFY_USER_TOKEN=
