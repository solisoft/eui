      "9": {"a": 556, "f": [0,519,-454,3,519,-610,444,-704,320,-704,3,169,-704,60,-560,60,-424,3,60,-329,134,-257,230,-257,3,296,-257,347,-284,393,-342,3,349,-139,261,-27,160,-27,3,129,-27,110,-39,110,-57,3,110,-66,135,-97,135,-118,3,135,-151,109,-176,75,-176,3,35,-176,7,-145,7,-102,3,7,-34,71,15,160,15,3,361,15,519,-245,519,-454,4,0,424,-531,3,424,-407,356,-316,264,-316,3,201,-316,166,-359,166,-434,3,166,-553,230,-662,319,-662,3,383,-662,424,-611,424,-531,4]}
    }
  }
end

def score(src, opts)
  width = opts["width"] ?? 600
  if opts["page"] == "a4"
    sheets = score_pages(src, opts)["pages"]
    return column({"gap": 6, "width": width}, sheets.map { |sheet| score_sheet(sheet, width) })
  end
  sp = opts["staff_space"] ?? 8
  engraved = score_layout(src, float(width) / sp, {})
  score_band_column(engraved, sp, opts, width, int(Math.ceil(engraved["height"] * sp)))
end

def score_a4()
  space = 25.4 * 5.0 / 72.0
  {"w": 210.0 / space, "h": 297.0 / space, "left": 10.0 / space, "right": 10.0 / space, "top": 5.0 / space, "bottom": 12.0 / space, "indent": 15.0 / space, "foot": 6.0 / space}
end

def score_pages(src, opts)
  paper = score_a4()
  width = opts["width"] ?? 600
  sp = float(width) / paper["w"]
  line_w = paper["w"] - paper["left"] - paper["right"]
  engraved = score_layout(src, line_w, {"page_h": paper["h"], "top": paper["top"], "bottom": paper["bottom"], "left": paper["left"], "indent": paper["indent"], "gap": 12.0})
  height = int(paper["h"] * sp)
  sheets = engraved["pages"].map { |pg| score_band_column(engraved, sp, opts.merge({"page_index": pg["index"]}), width, height) }
  {"engraved": engraved, "sp": sp, "pages": sheets, "height": height}
end

def score_sheet(sheet, width)
  {"k": "box", "s": {"bg": "surface.raised", "shadow": 2, "width": width, "border": 1, "border_color": "border.subtle"}, "c": [sheet]}
end

def score_layout(src, width_ss, layout)
  return score_engrave_page(src, width_ss, layout) unless defined("eui_score_layout")

  laid = eui_score_layout(src, width_ss, layout)
  throw laid["error"] unless laid["error"].nil?
  laid
end

def score_engrave(src, width_ss)
  score_engrave_page(src, width_ss, {})
end

def score_engrave_page(src, width_ss, layout)
  # The same source at the same width is engraved once: a click, an arrow
  # or the playhead changes what is lit, not the engraving. The answer is
  # never changed after it is made, so it can be handed out again.
  key = src + "|" + str(width_ss) + "|" + str(layout["page_h"]) + "|" + str(layout["left"]) + "|" + str(layout["indent"]) + "|" + str(layout["top"]) + "|" + str(layout["bottom"]) + "|" + str(layout["gap"])
  hit = score_memo_get("engraving", key)
  return hit unless hit.nil?

  engraved = score_engrave_fresh(src, width_ss, layout)
  engraved["memo_key"] = key
  score_memo_put("engraving", key, engraved, 8)
end

def score_memo_get(kind, key)
  store = SCORE_MEMO[kind]
  return nil if store.nil?

  store["v"][key]
end

def score_memo_put(kind, key, value, size)
  SCORE_MEMO[kind] = {"v": {}, "order": []} unless SCORE_MEMO.has_key(kind)
  store = SCORE_MEMO[kind]
  unless store["v"].has_key(key)
    store["order"].push(key)
    if store["order"].length > size
      gone = store["order"][0]
      store["order"] = range(1, store["order"].length).map { |k| store["order"][k] }
      store["v"].delete(gone)
    end
  end
  store["v"][key] = value
  value
end

def score_engrave_fresh(src, width_ss, layout)
  parsed = score_parse(src)
  return score_engrave_many(parsed, width_ss, layout) if parsed["staves"].length > 1

  bars = score_measures(parsed["events"])
  score_lyrics_assign(bars, parsed["staves"][0]["lyrics"])
  score_beams(bars)
  score_columns(bars, score_shortest(bars))
  left = layout["left"] ?? 0.0
  indent = layout["indent"] ?? 0.0
  systems = score_break(bars, width_ss, indent)
  # A line after the first opens with its bar number, set just left of the
  # staff as LilyPond sets it. Paper has a margin for it to stand in; a
  # screen has none, so music that takes more than one line there gives
  # up the room the widest number needs, and is broken again in what is left.
  if layout["left"].nil? && systems.length > 1
    left = score_text_width(str(bars[-1]["number"]), "regular", score_em(-2.0)) + 0.2
    width_ss -= left
    for bar in bars
      bar["bar_drawn"] = nil
      bar["open_repeat"] = nil
    end
    systems = score_break(bars, width_ss, indent)
  end
  score_place(systems, width_ss, left, indent)
  score_curves(parsed, systems)
  score_marks(systems)
  head = score_header_lines(parsed["header"], width_ss)
  pages = score_stack(systems, layout, head)
  bottom = 0.0
  for sys in systems
    bottom = sys["bottom"] if sys["bottom"] > bottom
  end
  {"systems": systems, "height": bottom + 1.0, "width": width_ss, "left": left, "header": head, "pages": pages, "paper": layout["page_h"], "numbered": score_numbered(layout)}
end

def score_whole()
  26880
end

def score_engrave_many(parsed, width_ss, layout)
  staves = parsed["staves"]
  all_bars = staves.map { |stf| score_measures(stf["events"]) }
  count = all_bars[0].length
  for bars, si in all_bars
    score_refuse("staff #{si + 1} has #{bars.length} bars and the first has #{count}: every staff has the same bars", 0) if bars.length != count
    for bar, k in bars
      score_refuse("bar #{k + 1} is not as long in staff #{si + 1} as in the first", 0) if bar["length"] * (bar["span"] ?? 1) != all_bars[0][k]["length"] * (all_bars[0][k]["span"] ?? 1)
    end
  end
  flat = []
  for bars, si in all_bars
    score_lyrics_assign(bars, staves[si]["lyrics"])
    score_beams(bars)
    flat = flat + bars
  end
  shortest = score_shortest(flat)
  for bars in all_bars
    score_columns(bars, shortest)
  end
  master = range(0, count).map { |k| score_master_bar(all_bars.map { |bars| bars[k] }, shortest) }
  # Room on the left for the names and for the brace or the bracket.
  deco = score_groups_width(parsed["groups"], staves.length)
  em = score_em(0.0)
  names = staves.map { |stf| (stf["props"] ?? {})["instrumentName"] ?? "" } + parsed["groups"].map { |g| g["name"] }
  shorts = staves.map { |stf| (stf["props"] ?? {})["shortInstrumentName"] ?? "" } + parsed["groups"].map { |g| g["short"] }
  name_w = names.map { |nm| nm == "" ? 0.0 : score_text_width(nm, "regular", em) + 1.0 }.reduce(fn(acc, w) score_max(acc, w), 0.0)
  short_w = shorts.map { |nm| nm == "" ? 0.0 : score_text_width(nm, "regular", em) + 1.0 }.reduce(fn(acc, w) score_max(acc, w), 0.0)
  left = layout["left"] ?? 0.0
  # On paper the names may hang into the left margin, as LilyPond's do:
  # the first line keeps its indent unless they need more than it and the
  # margin together; a screen has no margin to hang them in.
  indent = score_max(layout["indent"] ?? 0.0, deco + name_w - left)
  rest = score_max(deco, deco + short_w - left)
  systems = score_break(master, width_ss, indent, rest)
  score_place(systems, width_ss, left, indent, rest)
  outer = []
  for sys, si in systems
    score_spread(sys)
    staff_systems = []
    for stf, s in staves
      ss = {"bars": sys["bars"].map { |mb| mb["staff_bars"][s] }, "staff_index": s}
      for key in ["left", "prefix", "right", "bar_end", "k", "courtesy"]
        ss[key] = sys[key]
      end
      if si + 1 < systems.length && (sys["courtesy"] ?? 0.0) > 0.0
        ss["courtesy_bar"] = score_courtesy_of(systems[si + 1]["bars"][0]["staff_bars"][s])
      end
      staff_systems.push(ss)
    end
    # The opening lines up across the staves: every key starts after the
    # widest clef, every metre after the widest key.
    clef_w = 0.0
    key_w = 0.0
    for ss in staff_systems
      first = ss["bars"][0]
      clef_w = score_max(clef_w, score_glyph(score_clef_glyph(first["clef"]))["advance"])
      key_w = score_max(key_w, first["fifths"] == 0 ? 0.0 : score_key_width(first["fifths"]))
    end
    for ss in staff_systems
      ss["clef_w"] = clef_w
      ss["key_w"] = key_w
    end
    outer.push({"staves": staff_systems, "bars": staff_systems[0]["bars"], "left": sys["left"], "right": sys["right"], "first_line": si == 0})
  end
  for s in range(0, staves.length)
    lines = outer.map { |o| o["staves"][s] }
    score_curves(parsed, lines)
    score_marks(lines)
  end
  for o in outer
    score_stack_staves(o, parsed["groups"], staves)
  end
  head = score_header_lines(parsed["header"], width_ss)
  pages = score_stack(outer, layout, head)
  bottom = 0.0
  for o in outer
    for ss, s in o["staves"]
      ss["top"] = o["top"] + o["offsets"][s]
      ss["page"] = o["page"]
    end
    bottom = o["bottom"] if o["bottom"] > bottom
  end
  {"systems": outer, "height": bottom + 1.0, "width": width_ss, "left": left, "header": head, "pages": pages, "paper": layout["page_h"], "numbered": score_numbered(layout)}
end

def score_master_bar(staff_bars, shortest)
  first = staff_bars[0]
  mb = {}
  for key in first.keys
    # Spaced by its own columns, every staff's, not the first staff's voices'.
    mb[key] = first[key] unless ["items", "cols", "poly"].includes?(key)
  end
  mb["staff_bars"] = staff_bars
  starts = []
  for sb in staff_bars
    for ev in sb["items"]
      starts.push(ev["start"]) unless starts.includes?(ev["start"])
    end
  end
  starts = starts.sort()
  length = first["length"] * (first["span"] ?? 1)
  cols = []
  for at, ci in starts
    upto = ci + 1 < starts.length ? starts[ci + 1] : length
    col = {"k": "col", "start": at, "ticks": upto - at, "ideal": nil, "left": 0.0, "right": 0.0, "members": []}
    for sb in staff_bars
      items = sb["items"]
      for ev, j in items
        next unless ev["start"] == at

        col["members"].push(ev)
        own = ev["ticks"] * (ev["mm"] ?? 1)
        # A note that sounds on past the next column is spaced, here, as
        # the time to that column, as LilyPond spaces a held note.
        want = own <= upto - at ? ev["ideal"] : score_duration_space(upto - at, shortest)
        col["ideal"] = col["ideal"].nil? ? want : score_min(col["ideal"], want)
        col["left"] = score_max(col["left"], ev["left"])
        after = j + 1 < items.length ? items[j + 1]["start"] : length
        col["right"] = score_max(col["right"], ev["right"]) if after == upto
      end
    end
    cols.push(col)
  end
  mb["items"] = cols
  mb
end

def score_spread(sys)
  for mb in sys["bars"]
    content0 = mb["items"].length > 0 ? mb["items"][0]["x"] - 1.2 - mb["items"][0]["left"] : mb["x0"]
    for sb in mb["staff_bars"]
      for key in ["x0", "x1", "bar_drawn", "open_repeat", "open_repeat_x"]
        sb[key] = mb[key]
      end
    end
    for col in mb["items"]
      for ev in col["members"]
        ev["x"] = col["x"] + (ev["shift"] ?? 0.0)
      end
    end
    for sb in mb["staff_bars"]
      items = sb["items"]
      if items.length == 1 && items[0]["k"] == "rest" && (items[0]["full"] == true || items[0]["ticks"] == sb["length"])
        items[0]["x"] = (content0 + mb["x1"]) / 2.0 - score_glyph("restWhole")["advance"] / 2.0
        items[0]["whole_bar"] = true
        items[0]["span0"] = content0
        items[0]["span1"] = mb["x1"]
      end
    end
  end
  for s in range(0, sys["bars"][0]["staff_bars"].length)
    score_stems_beams(sys["bars"].map { |mb| mb["staff_bars"][s] })
  end
end

def score_groups_width(groups, count)
  widest = 0.0
  for g in groups
    next if g["kind"] == "none"

    widest = score_max(widest, (g["depth"] + 1) * 1.6)
  end
  widest + (count > 1 ? 0.3 : 0.0)
end

def score_stack_staves(sys, groups, staves)
  reaches = sys["staves"].map { |ss| score_reach(ss) }
  offsets = [0.0]
  for s in range(1, reaches.length)
    offsets.push(score_max(offsets[s - 1] + 9.0, offsets[s - 1] + reaches[s - 1][1] + 1.0 - reaches[s][0]))
  end
  sys["offsets"] = offsets
  sys["reach"] = [reaches[0][0], offsets[-1] + reaches[-1][1]]
  sys["groups"] = groups
  sys["names"] = staves.map { |stf| sys["first_line"] ? ((stf["props"] ?? {})["instrumentName"] ?? "") : ((stf["props"] ?? {})["shortInstrumentName"] ?? "") }
  for ss, s in sys["staves"]
    through = groups.any? { |g| (g["kind"] == "brace" || g["kind"] == "bracket") && g["first"] <= s && s < g["last"] }
    ss["connect_down"] = through ? offsets[s + 1] - offsets[s] - 4.0 : 0.0
  end
end

def score_glyphs()
  SCORE_MEMO["glyphs"] = smufl_glyph_table() unless SCORE_MEMO.has_key("glyphs")
  SCORE_MEMO["glyphs"]
end

def score_glyph(name)
  score_glyphs()[name]
end

def score_letters()
  SCORE_MEMO["letters"] = letter_glyph_table() unless SCORE_MEMO.has_key("letters")
  SCORE_MEMO["letters"]
end

def score_em(font_size)
  2.2 * Math.exp(font_size * 0.1155245300933242)
end

def score_text_width(words, weight, em)
  face = score_letters()[weight]
  total = 0
  for ch in words.chars()
    total += face.has_key(ch) ? face[ch]["a"] : 250
  end
  total * em / 1000.0
end

def score_draw_text(paths, ink, words, weight, x, y, em, sp)
  face = score_letters()[weight]
  k = em / 1000.0
  at = x
  for ch in words.chars()
    if face.has_key(ch)
      g = face[ch]
      paths.push(score_fill_k(ink, g["f"], at, y, k, sp)) if g["f"].length > 0
      at += g["a"] * k
    else
      at += 0.25 * em
    end
  end
  at
end

def score_header_lines(header, width)
  rows = [
    [ ["", "regular", 0.0], [header["dedication"] ?? "", "regular", 0.0], ["", "regular", 0.0] ],
    [ ["", "bold", 4.0], [header["title"] ?? "", "bold", 4.0], ["", "bold", 4.0] ],
    [ ["", "bold", 1.0], [header["subtitle"] ?? "", "bold", 1.0], ["", "bold", 1.0] ],
    [ ["", "bold", -1.0], [header["subsubtitle"] ?? "", "bold", -1.0], ["", "bold", -1.0] ],
    [ [header["poet"] ?? "", "regular", 0.0], [header["instrument"] ?? "", "bold", 1.0], [header["composer"] ?? "", "regular", 0.0] ],
    [ [header["meter"] ?? "", "regular", 0.0], ["", "regular", 0.0], [header["arranger"] ?? "", "regular", 0.0] ]
  ]
  out = []
  y = 0.0
  prev_descent = 0.0
  for row in rows
    tallest = 0.0
    for cell in row
      tallest = score_max(tallest, score_em(cell[2])) if cell[0] != ""
    end
    next if tallest == 0.0

    ascent = 0.72 * tallest
    y = out.length == 0 ? score_title_pad() + ascent : score_max(y + 3.5, y + prev_descent + ascent + 0.3)
    cells = []
    for cell, ci in row
      next if cell[0] == ""

      em = score_em(cell[2])
      w = score_text_width(cell[0], cell[1], em)
      x = 0.0
      x = (width - w) / 2.0 if ci == 1
      x = width - w if ci == 2
      cells.push({"text": cell[0], "weight": cell[1], "em": em, "x": x})
    end
    out.push({"y": y, "cells": cells})
    prev_descent = 0.25 * tallest
  end
  {"lines": out, "bottom": out.length == 0 ? 0.0 : y + prev_descent + score_title_pad()}
end

def score_title_pad()
  2.0
end

def score_fill_k(ink, cmds, ox, oy, k, sp)
  out = [5, ink]
  i = 0
  n = cmds.length
  while i < n
    c = cmds[i]
    out.push(c)
    args = [2, 2, 4, 6, 0][c]
    for jj in 0..args
      v = cmds[i + 1 + jj]
      out.push(score_r((jj % 2 == 0 ? ox + v * k : oy + v * k) * sp))
    end
    i += 1 + args
  end
  out
end

def score_max(u, v)
  u > v ? u : v
end

def score_min(u, v)
  u < v ? u : v
end

def score_mod(u, m)
  (u % m + m) % m
end

def score_log2(v)
  Math.log(float(v)) / Math.log(2.0)
end

def score_refuse(what, at)
  throw "score: #{what} (at character #{at})"
end

def score_tokens(src)
  cs = src.chars()
  out = []
  i = 0
  n = cs.length
  while i < n
    ch = cs[i]
    if ch == " " || ch == "\n" || ch == "\t" || ch == "\r"
      i += 1
    elsif ch == "%"
      while i < n && cs[i] != "\n"
        i += 1
      end
    elsif ch == "\\" && i + 1 < n && cs[i + 1] == "\\"
      # `\\` between the voices of `<< { … } \\ { … } >>`.
      out.push({"t": "\\\\", "v": "\\\\", "at": i})
      i += 2
    elsif ch == "\\" && i + 1 < n && "<>!".contains(cs[i + 1])
      # The hairpins: `\<`, `\>`, and `\!` that ends one.
      out.push({"t": "cmd", "v": cs[i + 1], "at": i})
      i += 2
    elsif ch == "\\"
      jj = i + 1
      word = ""
      while jj < n && score_letter?(cs[jj])
        word += cs[jj]
        jj += 1
      end
      score_refuse("a backslash with no command after it", i) if word == ""
      out.push({"t": "cmd", "v": word, "at": i})
      i = jj
      if word == "addlyrics"
        lyr = score_lyric_tokens(cs, i, out[-1]["at"])
        out.push({"t": "lyrics", "v": lyr["items"], "at": out[-1]["at"]})
        i = lyr["i"]
      end
    elsif ch == "\""
      jj = i + 1
      word = ""
      while jj < n && cs[jj] != "\""
        word += cs[jj]
        jj += 1
      end
      score_refuse("a string that is never closed", i) if jj >= n
      out.push({"t": "str", "v": word, "at": i})
      i = jj + 1
    elsif "{}<>[]()~|.=*-^_!#".contains(ch)
      out.push({"t": ch, "v": ch, "at": i})
      i += 1
    elsif score_digit?(ch)
      jj = i
      word = ""
      while jj < n && (score_digit?(cs[jj]) || cs[jj] == "/")
        word += cs[jj]
        jj += 1
      end
      out.push({"t": "num", "v": word, "at": i})
      i = jj
    elsif score_letter?(ch)
      jj = i
      word = ""
      while jj < n && score_letter?(cs[jj])
        word += cs[jj]
        jj += 1
      end
      marks = 0
      while jj < n && (cs[jj] == "'" || cs[jj] == ",")
        marks += cs[jj] == "'" ? 1 : -1
        jj += 1
      end
      out.push({"t": "word", "v": word, "marks": marks, "at": i})
      i = jj
    else
      score_refuse("'#{ch}' is not part of the notation this reads", i)
    end
  end
  out
end

def score_lyric_tokens(cs, i, at)
  n = cs.length
  while i < n && (cs[i] == " " || cs[i] == "\n" || cs[i] == "\t" || cs[i] == "\r")
    i += 1
  end
  score_refuse("\\addlyrics wants a { block } of words", at) unless i < n && cs[i] == "{"
  i += 1
  items = []
  while true
    while i < n && (cs[i] == " " || cs[i] == "\n" || cs[i] == "\t" || cs[i] == "\r")
      i += 1
    end
    score_refuse("a block of lyrics that is never closed", at) if i >= n
    break if cs[i] == "}"

    if cs[i] == "%"
      while i < n && cs[i] != "\n"
        i += 1
      end
    elsif cs[i] == "\""
      jj = i + 1
      word = ""
      while jj < n && cs[jj] != "\""
        word += cs[jj]
        jj += 1
      end
      score_refuse("a string that is never closed", i) if jj >= n
      items.push({"s": word, "quoted": true, "at": i})
      i = jj + 1
    else
      score_refuse("a { inside lyrics is not read: they are words, -- and __", i) if cs[i] == "{"
      score_refuse("'\\' inside lyrics is not read: they are words, -- and __", i) if cs[i] == "\\"
      jj = i
      word = ""
      while jj < n && !" \n\t\r{}\"".contains(cs[jj])
        word += cs[jj]
        jj += 1
      end
      items.push({"s": word, "quoted": false, "at": i})
      i = jj
    end
  end
  {"items": items, "i": i + 1}
end

def score_syllables(items, at)
  out = []
  for it in items
    if !it["quoted"] && (it["s"] == "--" || it["s"] == "__")
      score_refuse("#{it["s"]} wants a syllable before it", it["at"]) if out.length == 0
      out[-1][it["s"] == "--" ? "hyphen" : "extend"] = true
      next
    end
    skip = !it["quoted"] && it["s"] == "_"
    out.push({"text": skip ? "" : it["s"], "hyphen": false, "extend": false})
  end
  score_refuse("\\addlyrics with no words in it", at) if out.length == 0
  out
end

def score_attach_lyrics(toks, i, staves)
  while i < toks.length && toks[i]["t"] == "cmd" && toks[i]["v"] == "addlyrics"
    at = toks[i]["at"]
    score_refuse("\\addlyrics follows a staff's music", at) if staves.length == 0
    score_refuse("one verse of lyrics a staff is what this sets", at) if staves[-1].has_key("lyrics")
    staves[-1]["lyrics"] = score_syllables(toks[i + 1]["v"], at)
    i += 2
  end
  i
end

def score_letter?(ch)
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(ch)
end

def score_digit?(ch)
  "0123456789".contains(ch)
end

def score_pitch_name(word)
  return nil if word.length == 0

  step = "cdefgab".index_of(word.chars()[0])
  return nil if step < 0

  rest = word.length > 1 ? word.substring(1, word.length) : ""
  alter = nil
  alter = 0 if rest == ""
  alter = 1 if rest == "is"
  alter = 2 if rest == "isis"
  alter = -1 if rest == "es"
  alter = -2 if rest == "eses"
  alter = -1 if rest == "s" && (step == 2 || step == 5)
  alter = -2 if rest == "ses" && (step == 2 || step == 5)
  return nil if alter.nil?

  {"step": step, "alter": alter}
end

def score_resolve(name, marks, ref)
  return name["step"] + 7 * marks if ref.nil?

  ref_step = score_mod(ref, 7)
  d = ref - ref_step + name["step"]
  d -= 7 if d - ref > 3
  d += 7 if ref - d > 3
  d + 7 * marks
end

def score_parse(src)
  toks = score_tokens(src)
  st = {"header": {}, "counter": 0, "notes": 0}
  i = score_preamble(toks, 0, st)
  # `\\score { … \\layout { } \\midi { } }`, as LilyPond files are written:
  # the music, and blocks that say how to print it and play it, which this
  # engraver does not need.
  in_score = i < toks.length && toks[i]["t"] == "cmd" && toks[i]["v"] == "score"
  if in_score
    score_refuse("\\score wants a { block }", toks[i]["at"]) unless i + 1 < toks.length && toks[i + 1]["t"] == "{"
    i = score_preamble(toks, i + 2, st)
  end
  staves = []
  groups = []
  i = score_part(toks, i, st, staves, groups, 0)
  i = score_attach_lyrics(toks, i, staves)
  if in_score
    while i < toks.length && toks[i]["t"] == "cmd" && ["layout", "midi", "header"].includes?(toks[i]["v"])
      if toks[i]["v"] == "header"
        i = score_header(toks, i, st)
      else
        i = score_skip_block(toks, i + 1)
      end
    end
    score_refuse("a \\score block that is never closed", 0) if i >= toks.length || toks[i]["t"] != "}"
    i += 1
  end
  score_refuse("'#{toks[i]["v"]}' after the end of the music", toks[i]["at"]) if i < toks.length
  {"header": st["header"], "staves": staves, "groups": groups, "events": staves[0]["events"]}
end

def score_preamble(toks, i, st)
  while i < toks.length && toks[i]["t"] == "cmd" && (toks[i]["v"] == "version" || toks[i]["v"] == "header")
    if toks[i]["v"] == "version"
      i += 2
    else
      i = score_header(toks, i, st)
    end
  end
  i
end

def score_skip_block(toks, i)
  score_refuse("a { block } was expected", i < toks.length ? toks[i]["at"] : 0) if i >= toks.length || toks[i]["t"] != "{"
  depth = 0
  while i < toks.length
    depth += 1 if toks[i]["t"] == "{"
    depth -= 1 if toks[i]["t"] == "}"
    i += 1
    break if depth == 0
  end
  i
end

def score_double?(toks, i, kind)
  i + 1 < toks.length && toks[i]["t"] == kind && toks[i + 1]["t"] == kind && toks[i + 1]["at"] == toks[i]["at"] + 1
end

def score_part(toks, i, st, staves, groups, depth)
  score_refuse("there is no music", 0) if i >= toks.length
  tk = toks[i]
  if tk["t"] == "cmd" && tk["v"] == "new"
    kind = i + 1 < toks.length ? toks[i + 1]["v"] : ""
    score_refuse("\\new #{kind} is not drawn: a Staff, a PianoStaff, a GrandStaff, a StaffGroup or a ChoirStaff is", tk["at"]) unless kind == "Staff" || SCORE_GROUPS.has_key(kind)
    i += 2
    i += 2 if i + 1 < toks.length && toks[i]["t"] == "=" && toks[i + 1]["t"] == "str"
    props = {}
    i = score_with(toks, i, props) if i < toks.length && toks[i]["t"] == "cmd" && toks[i]["v"] == "with"
    return score_staff(toks, i, st, staves, props) if kind == "Staff"

    score_refuse("\\new #{kind} wants its staves between << and >>", tk["at"]) unless score_double?(toks, i, "<")
    return score_group(toks, i, st, staves, groups, depth, SCORE_GROUPS[kind], props)
  end
  return score_group(toks, i, st, staves, groups, depth, "none", {}) if score_double?(toks, i, "<")

  score_staff(toks, i, st, staves, {})
end

def score_group(toks, i, st, staves, groups, depth, kind, props)
  at = toks[i]["at"]
  i += 2
  first = staves.length
  while i < toks.length && !score_double?(toks, i, ">")
    score_refuse("two voices in one staff are not drawn: give each its own \\new Staff", toks[i]["at"]) unless toks[i]["t"] == "cmd" && toks[i]["v"] == "new"
    i = score_part(toks, i, st, staves, groups, depth + 1)
    i = score_attach_lyrics(toks, i, staves)
  end
  score_refuse("a << that is never closed by >>", at) if i >= toks.length
  score_refuse("<< >> with no staff in it", at) if staves.length == first
  groups.push({"kind": kind, "first": first, "last": staves.length - 1, "depth": depth, "name": props["instrumentName"] ?? "", "short": props["shortInstrumentName"] ?? ""})
  i + 2
end

def score_with(toks, i, props)
  at = toks[i]["at"]
  score_refuse("\\with wants a { block }", at) unless i + 1 < toks.length && toks[i + 1]["t"] == "{"
  i += 2
  while i < toks.length && toks[i]["t"] != "}"
    i = score_staff_prop(toks, i, props, "\\with")
  end
  score_refuse("a \\with block that is never closed", at) if i >= toks.length
  i + 1
end

def score_staff_prop(toks, i, props, what)
  tk = toks[i]
  ok = tk["t"] == "word" && ["instrumentName", "shortInstrumentName", "midiInstrument", "midiMaximumVolume", "midiPanPosition"].includes?(tk["v"]) && i + 1 < toks.length && toks[i + 1]["t"] == "="
  score_refuse("#{what} sets instrumentName, shortInstrumentName, midiInstrument, midiMaximumVolume or midiPanPosition, not '#{tk["v"]}'", tk["at"]) unless ok
  i += 2
  i += 1 if i < toks.length && toks[i]["t"] == "#"
  if tk["v"] == "midiMaximumVolume" || tk["v"] == "midiPanPosition"
    # A number, as Scheme writes one: `#0.8`, `#-0.5`, `#1`.
    sign = 1.0
    if i < toks.length && toks[i]["t"] == "-"
      sign = -1.0
      i += 1
    end
    score_refuse("#{tk["v"]} wants a number", tk["at"]) unless i < toks.length && toks[i]["t"] == "num" && !toks[i]["v"].contains("/")
    value = float(toks[i]["v"])
    i += 1
    if i + 1 < toks.length && toks[i]["t"] == "." && toks[i + 1]["t"] == "num" && toks[i + 1]["at"] == toks[i]["at"] + 1
      digits = toks[i + 1]["v"]
      tenths = 1.0
      for _ in range(0, digits.length)
        tenths = tenths * 10.0
      end
      value += float(digits) / tenths
      i += 2
    end
    props[tk["v"]] = sign * value
    return i
  end
  score_refuse("#{tk["v"]} wants a \"string\"", tk["at"]) unless i < toks.length && toks[i]["t"] == "str"
  props[tk["v"]] = toks[i]["v"]
  i + 1
end

def score_staff(toks, i, base, staves, props)
  st = {"ref": nil, "base": 4, "dots": 0, "events": [], "notes": base["notes"], "items": base["counter"], "header": base["header"], "props": props}
  if i < toks.length && toks[i]["t"] == "cmd" && toks[i]["v"] == "relative"
    pitch = i + 1 < toks.length ? toks[i + 1] : nil
    name = pitch.nil? ? nil : score_pitch_name(pitch["v"])
    score_refuse("\\relative wants a pitch", toks[i]["at"]) if name.nil? || pitch["t"] != "word"
    st["ref"] = score_resolve(name, pitch["marks"], nil)
    i += 2
  end
  braced = i < toks.length && toks[i]["t"] == "{"
  i += 1 if braced
  i = score_music(toks, i, st)
  if braced
    score_refuse("a '{' that is never closed", 0) if i >= toks.length || toks[i]["t"] != "}"
    i += 1
  end
  base["counter"] = st["items"]
  base["notes"] = st["notes"]
  staves.push({"events": st["events"], "props": st["props"]})
  i
end

def score_header(toks, i, st)
  fields = ["dedication", "title", "subtitle", "subsubtitle", "poet", "instrument", "composer", "meter", "arranger", "piece", "opus", "copyright"]
  at = toks[i]["at"]
  i += 1
  score_refuse("\\header wants a { block }", at) if i >= toks.length || toks[i]["t"] != "{"
  i += 1
  while i < toks.length && toks[i]["t"] != "}"
    name = toks[i]
    score_refuse("a header field is a name, = and a string", name["at"]) unless name["t"] == "word" && i + 2 < toks.length && toks[i + 1]["t"] == "=" && toks[i + 2]["t"] == "str"
    score_refuse("the header field '#{name["v"]}' is not one a title page prints", name["at"]) unless fields.includes?(name["v"])
    st["header"][name["v"]] = toks[i + 2]["v"]
    i += 3
  end
  score_refuse("a \\header that is never closed", at) if i >= toks.length
  i + 1
end

def score_music(toks, i, st)
  evs = st["events"]
  while i < toks.length
    tk = toks[i]
    kind = tk["t"]
    break if kind == "}"

    if kind == "cmd"
      i = score_command(toks, i, st)
    elsif kind == "<" && score_twin?(toks, i, "<")
      i = score_voices(toks, i, st)
    elsif kind == "word" || kind == "<"
      i = score_note(toks, i, st)
    elsif kind == "|"
      i += 1
    elsif kind == "~"
      last = score_last_note(evs, tk)
      last["tie"] = true
      i += 1
    elsif kind == "-" || kind == "^" || kind == "_"
      i = score_postfix(toks, i, st)
    elsif kind == "(" || kind == ")" || kind == "[" || kind == "]"
      last = score_last_note(evs, tk)
      key = {"(": "slur_on", ")": "slur_off", "[": "beam_on", "]": "beam_off"}[kind]
      last[key] = true
      i += 1
    else
      score_refuse("'#{tk["v"]}' is not expected here", tk["at"])
    end
  end
  i
end

def score_twin?(toks, i, sign)
  i + 1 < toks.length && toks[i]["t"] == sign && toks[i + 1]["t"] == sign && toks[i + 1]["at"] == toks[i]["at"] + 1
end

def score_voices(toks, i, st)
  open_at = toks[i]["at"]
  i += 2
  start_ref = st["ref"]
  after_ref = nil
  voice = 1
  st["events"].push({"k": "voices", "at": open_at})
  while true
    score_refuse("<< wants { music } \\\\ { music } >>", open_at) unless i < toks.length && toks[i]["t"] == "{"
    st["ref"] = start_ref
    st["voice"] = voice
    i = score_music(toks, i + 1, st)
    score_refuse("a voice that is never closed", open_at) if i >= toks.length
    i += 1
    after_ref = st["ref"] if voice == 1
    if i < toks.length && toks[i]["t"] == "\\\\"
      score_refuse("two voices on a staff are what this draws", toks[i]["at"]) if voice == 2
      st["events"].push({"k": "voice_next", "at": toks[i]["at"]})
      voice += 1
      i += 1
    elsif score_twin?(toks, i, ">")
      i += 2
      break
    else
      score_refuse("<< { … } \\\\ { … } >> is not closed with >>", open_at)
    end
  end
  score_refuse("<< { … } >> with one voice: write the voices apart with \\\\", open_at) if voice < 2
  st["voice"] = nil
  st["ref"] = after_ref
  st["events"].push({"k": "voices_end", "at": open_at})
  i
end

def score_postfix(toks, i, st)
  tk = toks[i]
  dir = {"-": 0, "^": -1, "_": 1}[tk["t"]]
  score_refuse("'#{tk["v"]}' wants something after it: -. -> -- ^\"text\"", tk["at"]) if i + 1 >= toks.length
  nxt = toks[i + 1]
  if nxt["t"] == "str"
    last = score_last_item(st["events"], tk)
    last["texts"] = (last["texts"] ?? []) + [ {"text": nxt["v"], "dir": dir == 0 ? 1 : dir} ]
    return i + 2
  end
  if nxt["t"] == "cmd"
    if SCORE_SCRIPTS.has_key(nxt["v"])
      score_add_script(score_last_note(st["events"], tk), nxt["v"], dir)
      return i + 2
    end
    return score_command(toks, i + 1, st)
  end
  name = {".": "staccato", ">": "accent", "-": "tenuto", "^": "marcato", "!": "staccatissimo", "_": "portato"}[nxt["t"]]
  score_refuse("'#{tk["v"]}#{nxt["v"]}' is not an articulation this draws", tk["at"]) if name.nil?
  score_add_script(score_last_note(st["events"], tk), name, dir)
  i + 2
end

def score_add_script(ev, name, dir)
  ev["scripts"] = (ev["scripts"] ?? []) + [ {"name": name, "dir": dir} ]
end

def score_last_item(evs, tk)
  last = evs.length > 0 ? evs[-1] : nil
  score_refuse("'#{tk["v"]}' must follow a note or a rest", tk["at"]) if last.nil? || (last["k"] != "note" && last["k"] != "rest")
  last
end

def score_last_note(evs, tk)
  last = evs.length > 0 ? evs[-1] : nil
  score_refuse("'#{tk["v"]}' must follow a note", tk["at"]) if last.nil? || last["k"] != "note"
  last
end

def score_command(toks, i, st)
  tk = toks[i]
  word = tk["v"]
  # The first voice carries the staff's changes, as the bars are its; the
  # second only fills them.
  if st["voice"] == 2 && ["clef", "key", "time", "bar", "tempo", "break", "pageBreak", "repeat", "alternative", "compressEmptyMeasures"].includes?(word)
    score_refuse("\\#{word} belongs to the staff: write it in the first voice", tk["at"])
  end
  arg = i + 1 < toks.length ? toks[i + 1] : nil
  evs = st["events"]
  if word == "clef"
    score_refuse("\\clef wants a name", tk["at"]) if arg.nil?
    clef = {"treble": "treble", "violin": "treble", "G": "treble", "bass": "bass", "F": "bass", "alto": "alto", "C": "alto"}[arg["v"]]
    score_refuse("the clef '#{arg["v"]}' is not one this draws (treble, bass, alto)", arg["at"]) if clef.nil?
    evs.push({"k": "clef", "v": clef, "at": tk["at"]})
    return i + 2
  end
  if word == "key"
    mode = i + 2 < toks.length ? toks[i + 2] : nil
    name = arg.nil? ? nil : score_pitch_name(arg["v"])
    score_refuse("\\key wants a pitch and \\major or \\minor", tk["at"]) if name.nil? || mode.nil? || mode["t"] != "cmd"
    score_refuse("the mode '#{mode["v"]}' is not \\major or \\minor", mode["at"]) unless mode["v"] == "major" || mode["v"] == "minor"
    fifths = [0, 2, 4, -1, 1, 3, 5][name["step"]] + 7 * name["alter"]
    fifths -= 3 if mode["v"] == "minor"
    score_refuse("a key of #{fifths} fifths has no signature", tk["at"]) if fifths > 7 || fifths < -7
    evs.push({"k": "key", "fifths": fifths, "at": tk["at"]})
    return i + 3
  end
  if word == "time"
    parts = arg.nil? ? [] : arg["v"].split("/")
    score_refuse("\\time wants a fraction like 3/4", tk["at"]) if parts.length != 2
    num = int(parts[0])
    den = int(parts[1])
    score_refuse("\\time #{arg["v"]} is not a metre this draws", arg["at"]) unless num > 0 && num < 13 && [1, 2, 4, 8, 16].includes?(den)
    evs.push({"k": "time", "n": num, "d": den, "at": tk["at"]})
    return i + 2
  end
  if word == "bar"
    score_refuse("\\bar wants a string", tk["at"]) if arg.nil? || arg["t"] != "str"
    score_refuse("the bar line \"#{arg["v"]}\" is not one this draws (|, ||, |., .|:, :|., :|.|:)", arg["at"]) unless ["|", "||", "|.", ".|:", ":|.", ":|.|:"].includes?(arg["v"])
    evs.push({"k": "bar", "v": arg["v"], "at": tk["at"]})
    return i + 2
  end
  if word == "tempo"
    return score_tempo(toks, i, st)
  end
  # Dynamics, hairpins and the articulations named by a command, on the
  # note or the rest before them.
  if SCORE_DYNAMICS.includes?(word)
    score_last_item(evs, tk)["dyn"] = word
    return i + 1
  end
  if word == "<" || word == ">"
    score_last_item(evs, tk)["hairpin"] = word
    return i + 1
  end
  if word == "!"
    score_last_item(evs, tk)["hairpin_end"] = true
    return i + 1
  end
  if SCORE_SCRIPTS.has_key(word)
    score_add_script(score_last_note(evs, tk), word, 0)
    return i + 1
  end
  # A line or a page that must end at the next bar line, as the engraver
  # would not have ended it.
  if word == "break" || word == "pageBreak"
    evs.push({"k": "break", "page": word == "pageBreak", "at": tk["at"]})
    return i + 1
  end
  # `\\set Staff.instrumentName = "…"` and its two kin.
  if word == "set"
    ok = i + 3 < toks.length && toks[i + 1]["t"] == "word" && toks[i + 1]["v"] == "Staff" && toks[i + 2]["t"] == "."
    score_refuse("\\set sets Staff.instrumentName, Staff.shortInstrumentName or Staff.midiInstrument", tk["at"]) unless ok
    st["props"] = st["props"] ?? {}
    return score_staff_prop(toks, i + 3, st["props"], "\\set Staff")
  end
  if word == "tuplet" || word == "times"
    return score_tuplet(toks, i, st, word)
  end
  if word == "repeat"
    return score_repeat(toks, i, st)
  end
  if word == "alternative"
    return score_alternative(toks, i, st)
  end
  # LilyPond prints a run of whole-bar rests bar by bar unless asked to
  # gather it into one bar with a count; these two ask.
  if word == "compressEmptyMeasures"
    evs.push({"k": "compress", "at": tk["at"]})
    return i + 1
  end
  if word == "compressMMRests"
    evs.push({"k": "compress", "at": tk["at"]})
    score_refuse("\\compressMMRests wants a { block }", tk["at"]) if arg.nil? || arg["t"] != "{"
    i = score_music(toks, i + 2, st)
    score_refuse("a \\compressMMRests block that is never closed", tk["at"]) if i >= toks.length || toks[i]["t"] != "}"
    return i + 1
  end
  score_refuse("\\#{word} is not a command this reads", tk["at"])
end

def score_repeat(toks, i, st)
  tk = toks[i]
  ok = i + 3 < toks.length && toks[i + 1]["t"] == "word" && toks[i + 1]["v"] == "volta" && toks[i + 2]["t"] == "num" && toks[i + 3]["t"] == "{"
  score_refuse("\\repeat wants volta, a count and a { block } — the others are not drawn", tk["at"]) unless ok
  st["events"].push({"k": "repeat_start", "at": tk["at"]})
  alts_before = st["alts"] ?? 0
  i = score_music(toks, i + 4, st)
  score_refuse("a \\repeat block that is never closed", tk["at"]) if i >= toks.length || toks[i]["t"] != "}"
  i += 1
  if i < toks.length && toks[i]["t"] == "cmd" && toks[i]["v"] == "alternative"
    i = score_alternative(toks, i, st)
  end
  st["events"].push({"k": "repeat_end", "at": tk["at"]}) if (st["alts"] ?? 0) == alts_before
  i
end

def score_alternative(toks, i, st)
  tk = toks[i]
  score_refuse("\\alternative wants a { block } of { endings }", tk["at"]) if i + 1 >= toks.length || toks[i + 1]["t"] != "{"
  i += 2
  endings = []
  while i < toks.length && toks[i]["t"] == "{"
    endings.push(i)
    depth = 0
    jj = i
    while jj < toks.length
      depth += 1 if toks[jj]["t"] == "{"
      depth -= 1 if toks[jj]["t"] == "}"
      break if depth == 0

      jj += 1
    end
    i = jj + 1
  end
  score_refuse("an \\alternative with no endings", tk["at"]) if endings.length == 0
  score_refuse("an \\alternative that is never closed", tk["at"]) if i >= toks.length || toks[i]["t"] != "}"
  close_at = i
  for start, k in endings
    last = k == endings.length - 1
    st["events"].push({"k": "volta_start", "label": str(k + 1) + ".", "at": toks[start]["at"]})
    stop = score_music(toks, start + 1, st)
    st["events"].push({"k": "repeat_end", "at": toks[start]["at"]}) unless last
    st["events"].push({"k": "volta_end", "closed": !last, "at": toks[start]["at"]})
  end
  st["alts"] = (st["alts"] ?? 0) + 1
  close_at + 1
end

def score_tuplet(toks, i, st, word)
  tk = toks[i]
  ok = i + 1 < toks.length && toks[i + 1]["t"] == "num" && toks[i + 1]["v"].contains("/")
  score_refuse("\\#{word} wants a ratio, like 3/2, and a { block }", tk["at"]) unless ok
  parts = toks[i + 1]["v"].split("/")
  n = int(parts[0])
  d = int(parts[1])
  if word == "times"
    n = int(parts[1])
    d = int(parts[0])
  end
  score_refuse("a tuplet of #{n} in the time of #{d} is not one this draws", tk["at"]) unless n >= 2 && n <= 12 && d >= 1 && d <= 12 && n != d
  score_refuse("a tuplet inside a tuplet is not drawn", tk["at"]) unless st["tuplet"].nil?
  i += 2
  span = 0
  if i < toks.length && toks[i]["t"] == "num"
    base = int(toks[i]["v"])
    score_refuse("a tuplet's span is a note value: 1, 2, 4, 8 or 16", toks[i]["at"]) unless [1, 2, 4, 8, 16].includes?(base)
    span = score_whole() / base
    i += 1
  end
  score_refuse("\\#{word} wants a { block }", tk["at"]) if i >= toks.length || toks[i]["t"] != "{"
  st["tuplets"] = (st["tuplets"] ?? 0) + 1
  st["tuplet"] = {"id": st["tuplets"], "n": n, "d": d, "span": span, "used": 0}
  i = score_music(toks, i + 1, st)
  score_refuse("a tuplet that is never closed", tk["at"]) if i >= toks.length || toks[i]["t"] != "}"
  st["tuplet"] = nil
  i + 1
end

def score_tempo(toks, i, st)
  tk = toks[i]
  i += 1
  mark = {"k": "tempo", "text": "", "base": 0, "bpm": 0, "at": tk["at"]}
  if i < toks.length && toks[i]["t"] == "str"
    mark["text"] = toks[i]["v"]
    i += 1
  end
  if i < toks.length && toks[i]["t"] == "num"
    base = int(toks[i]["v"])
    score_refuse("\\tempo wants a note value, = and a number, like 4 = 120", tk["at"]) unless [1, 2, 4, 8, 16].includes?(base) && i + 2 < toks.length && toks[i + 1]["t"] == "=" && toks[i + 2]["t"] == "num"
    mark["base"] = base
    mark["bpm"] = int(toks[i + 2]["v"])
    score_refuse("a tempo of #{mark["bpm"]} is not one anybody plays", tk["at"]) unless mark["bpm"] >= 10 && mark["bpm"] <= 400
    i += 3
  end
  score_refuse("\\tempo wants words, a beat or both", tk["at"]) if mark["text"] == "" && mark["bpm"] == 0
  st["events"].push(mark)
  i
end

def score_note(toks, i, st)
  tk = toks[i]
  pitches = []
  rest = nil
  if tk["t"] == "<"
    i += 1
    ref = st["ref"]
    first = nil
    while i < toks.length && toks[i]["t"] == "word"
      name = score_pitch_name(toks[i]["v"])
      score_refuse("'#{toks[i]["v"]}' is not a note name", toks[i]["at"]) if name.nil?
      d = score_resolve(name, toks[i]["marks"], ref)
      ref = d unless ref.nil?
      first = d if first.nil?
      pitches.push({"d": d, "alter": name["alter"]})
      i += 1
    end
    score_refuse("a chord that is never closed", tk["at"]) if i >= toks.length || toks[i]["t"] != ">"
    score_refuse("an empty chord", tk["at"]) if pitches.length == 0
    st["ref"] = first unless st["ref"].nil?
    i += 1
  else
    word = tk["v"]
    if word == "r" || word == "R" || word == "s"
      # `s`, a spacer: time and nothing drawn, where a second voice is silent.
      score_refuse("a spacer s is for the second voice of << \\\\ >>", tk["at"]) if word == "s" && st["voice"] != 2
      rest = word
    else
      name = score_pitch_name(word)
      score_refuse("'#{word}' is not a note name", tk["at"]) if name.nil?
      d = score_resolve(name, tk["marks"], st["ref"])
      st["ref"] = d unless st["ref"].nil?
      pitches.push({"d": d, "alter": name["alter"]})
    end
    i += 1
  end
  if i < toks.length && toks[i]["t"] == "num"
    base = int(toks[i]["v"])
    score_refuse("the duration #{toks[i]["v"]} is not one this draws (1, 2, 4, 8, 16, 32)", toks[i]["at"]) unless [1, 2, 4, 8, 16, 32].includes?(base)
    st["base"] = base
    st["dots"] = 0
    i += 1
    while i < toks.length && toks[i]["t"] == "."
      st["dots"] = st["dots"] + 1
      i += 1
    end
  end
  count = 1
  if i < toks.length && toks[i]["t"] == "*"
    score_refuse("a * count is for whole-bar rests, R1*4", toks[i]["at"]) unless rest == "R"
    score_refuse("a * wants a count, R1*4", toks[i]["at"]) unless i + 1 < toks.length && toks[i + 1]["t"] == "num" && !toks[i + 1]["v"].contains("/")
    count = int(toks[i + 1]["v"])
    score_refuse("a count of bars is at least one", toks[i]["at"]) if count < 1
    i += 2
  end
  base = st["base"]
  dots = st["dots"]
  ticks = score_whole() / base
  add = ticks
  for _ in 0..dots
    score_refuse("too many dots for a 1/#{base}", tk["at"]) if add % 2 == 1
    add = add / 2
    ticks += add
  end
  ev = {"k": "note", "pitches": pitches, "base": base, "dots": dots, "ticks": ticks, "at": tk["at"], "i": st["items"]}
  unless st["voice"].nil?
    score_refuse("a run of bars' rest is the staff's: write it outside << \\\\ >>", tk["at"]) if count > 1
    ev["voice"] = st["voice"]
  end
  tup = st["tuplet"]
  unless tup.nil?
    # In a tuplet a note lasts d/n of what it says. A span starts a new
    # group, drawn with its own number, each time the last is full.
    score_refuse("a whole-bar rest cannot be in a tuplet", tk["at"]) if rest == "R"
    if tup["span"] > 0 && tup["used"] >= tup["span"]
      st["tuplets"] = st["tuplets"] + 1
      tup["id"] = st["tuplets"]
      tup["used"] = 0
    end
    score_refuse("a 1/#{base} cannot be cut #{tup["n"]} ways", tk["at"]) unless (ticks * tup["d"]) % tup["n"] == 0
    ev["ticks"] = ticks * tup["d"] / tup["n"]
    ev["tuplet"] = {"id": tup["id"], "n": tup["n"], "d": tup["d"]}
    tup["used"] = tup["used"] + ev["ticks"]
  end
  st["items"] = st["items"] + 1
  if rest.nil?
    ev["n"] = st["notes"]
    st["notes"] = st["notes"] + 1
  else
    ev["k"] = "rest"
    ev["full"] = rest == "R"
    ev["count"] = count
    ev["spacer"] = true if rest == "s"
  end
  st["events"].push(ev)
  i
end

def score_clef_mid(clef)
  {"treble": 13, "bass": 1, "alto": 7}[clef]
end

def score_key_alters(fifths)
  out = [0, 0, 0, 0, 0, 0, 0]
  sharps = [3, 0, 4, 1, 5, 2, 6]
  flats = [6, 2, 5, 1, 4, 0, 3]
  for k in 0..score_max(fifths, -fifths)
    if fifths > 0
      out[sharps[k]] = 1
    else
      out[flats[k]] = -1
    end
  end
  out
end

def score_measures(events)
  clef = "treble"
  fifths = 0
  tn = 4
  td = 4
  bars = []
  cur = nil
  pos = 0
  seen = {}
  alters = score_key_alters(0)
  tied = {}
  tempo = nil
  volta_open = nil
  tuplet_bar = {}
  # Ticks from the start of the piece, and where each bar starts: what the
  # second voice of `<< \\\\ >>` finds its bars by (`score_voice_two`).
  tick_at = 0
  poly = nil
  # A run of whole-bar rests, R1*4, is one bar with a count when the music
  # asked to compress them, and that many bars of a rest each when not —
  # LilyPond's default.
  compress = events.any? { |ev| ev["k"] == "compress" }
  flat = []
  for ev in events
    if ev["k"] == "rest" && (ev["count"] ?? 1) > 1 && !compress
      for _ in range(0, ev["count"])
        flat.push(ev.merge({"count": 1}))
      end
    else
      flat.push(ev)
    end
  end
  for ev in flat
    kind = ev["k"]
    # A tempo mark belongs to the note or rest it is written before.
    if kind == "tempo"
      tempo = ev
      next
    end
    next if kind == "compress"

    if kind == "voices"
      poly = {"from": tick_at, "voice": 1}
      next
    end
    if kind == "voice_next"
      poly["voice"] = 2
      poly["to"] = tick_at
      poly["at"] = poly["from"]
      poly["seen"] = {}
      poly["seen_bar"] = -1
      poly["tied"] = {}
      next
    end
    if kind == "voices_end"
      score_refuse("the voices of << \\\\ >> are not as long as each other", ev["at"]) unless poly["at"] == poly["to"]
      poly = nil
      next
    end
    if !poly.nil? && poly["voice"] == 2
      score_voice_two(bars, ev, poly)
      next
    end
    if cur.nil?
      cur = {"clef": clef, "fifths": fifths, "time": [tn, td], "items": [], "bar": "|", "changes": {}, "length": tn * score_whole() / td, "tick0": tick_at}
      cur["volta_in"] = volta_open unless volta_open.nil?
      bars.push(cur)
      pos = 0
      seen = {}
    end
    if kind == "break"
      score_refuse("a \\break goes at a bar line", ev["at"]) if pos > 0
      score_refuse("a \\break before any music", ev["at"]) if bars.length < 2
      ending = bars[-2]
      ending["brk"] = ev["page"] || ending["brk"] == "page" ? "page" : "line"
      next
    end
    if kind == "repeat_start"
      score_refuse("a repeat starts at a bar line", ev["at"]) if pos > 0
      cur["start_repeat"] = true
      next
    end
    if kind == "volta_start"
      score_refuse("an alternative starts at a bar line", ev["at"]) if pos > 0
      volta_open = ev["label"]
      cur["volta_in"] = volta_open
      cur["volta_first"] = true
      next
    end
    if kind == "volta_end"
      ended_before = pos == 0 && bars.length > 1
      ending = ended_before ? bars[-2] : cur
      ending["volta_last"] = true
      ending["volta_closed"] = ev["closed"]
      volta_open = nil
      # The empty bar the next notes will fill is past the ending.
      cur["volta_in"] = nil if ended_before
      next
    end
    if kind == "repeat_end"
      if pos == 0 && bars.length > 1
        bars[-2]["bar"] = ":|."
      elsif pos > 0
        cur["bar"] = ":|."
        cur["length"] = pos
        cur = nil
      else
        score_refuse("an end repeat before any music", ev["at"])
      end
      next
    end
    if kind == "clef" || kind == "key" || kind == "time"
      score_refuse("\\#{kind} in the middle of a bar", ev["at"]) if pos > 0
      if kind == "clef"
        clef = ev["v"]
        cur["clef"] = clef
        cur["changes"]["clef"] = true
      elsif kind == "key"
        cur["changes"]["key_from"] = fifths
        fifths = ev["fifths"]
        cur["fifths"] = fifths
        cur["changes"]["key"] = true
      else
        tn = ev["n"]
        td = ev["d"]
        cur["time"] = [tn, td]
        cur["length"] = tn * score_whole() / td
        cur["changes"]["time"] = true
      end
      alters = score_key_alters(fifths)
      next
    end
    if kind == "bar"
      if pos == 0 && bars.length > 1
        bars[-2]["bar"] = ev["v"]
      elsif pos > 0
        cur["bar"] = ev["v"]
        cur["length"] = pos
        cur = nil
      elsif ev["v"] == ".|:"
        # A start repeat before the first note: LilyPond draws it at the
        # start of the first line, after the clef, key and time — where
        # `\repeat volta` from the very start draws nothing.
        cur["open_bar"] = true
      else
        score_refuse("a bar line before any music", ev["at"])
      end
      next
    end
    if (ev["count"] ?? 1) > 1
      score_refuse("a run of bars' rest lasts a whole bar each: in #{tn}/#{td} write R and the bar's length", ev["at"]) unless pos == 0 && ev["ticks"] == cur["length"]
      ev["mm"] = ev["count"]
      cur["span"] = ev["count"]
    end
    score_refuse("a note runs past the bar line (bar #{bars.length})", ev["at"]) if pos + ev["ticks"] > cur["length"]
    ev["start"] = pos
    ev["bar"] = bars.length - 1
    unless ev["tuplet"].nil?
      tid = str(ev["tuplet"]["id"])
      score_refuse("a tuplet runs across a bar line", ev["at"]) if tuplet_bar.has_key(tid) && tuplet_bar[tid] != ev["bar"]
      tuplet_bar[tid] = ev["bar"]
    end
    unless tempo.nil?
      ev["tempo"] = tempo
      tempo = nil
    end
    if kind == "note"
      mid = score_clef_mid(clef)
      heads = []
      for p in ev["pitches"]
        d = p["d"]
        key = str(d)
        now = seen.has_key(key) ? seen[key] : alters[score_mod(d, 7)]
        show = p["alter"] != now
        show = false if tied.has_key(key) && tied[key] == p["alter"]
        seen[key] = p["alter"]
        heads.push({"pos": d - mid, "d": d, "alter": p["alter"], "acc": show ? p["alter"] : nil})
      end
      ev["heads"] = heads.sort_by { |hd| hd["pos"] }
      tied = {}
      if ev["tie"] == true
        for p in ev["pitches"]
          tied[str(p["d"])] = p["alter"]
        end
      end
    else
      tied = {}
    end
    cur["items"].push(ev)
    pos += ev["ticks"]
    tick_at += ev["ticks"] * (ev["mm"] ?? 1)
    cur = nil if pos == cur["length"]
  end
  # A bar with two voices lists its notes by when they start, the first
  # voice's first: the order the columns and the drawing read them in.
  for b in bars
    # Not `if items.any? { … }`: a block in an `if`'s condition does not parse.
    two = b["items"].any? { |ev| ev["voice"] == 2 }
    if two
      b["poly"] = true
      b["items"] = b["items"].sort_by { |ev| ev["start"] * 4 + (ev["voice"] ?? 1) }
    end
  end
  bars = bars.filter { |b| b["items"].length > 0 || b["changes"].keys.length > 0 }
  score_refuse("there is no music", 0) if bars.length == 0
  # A bar's number counts the bars a gathered rest stands for.
  number = 1
  for b, bi in bars
    b["number"] = number
    number += b["span"] ?? 1
    # A repeat that starts here is drawn on the bar line before it: a start
    # repeat, or both signs back to back where one repeat ends as the next
    # begins. At the very start of the piece LilyPond draws none.
    if b["start_repeat"] == true && bi > 0
      before = bars[bi - 1]
      before["bar"] = before["bar"] == ":|." ? ":|.|:" : ".|:"
    end
  end
  bars
end

def score_voice_two(bars, ev, poly)
  at = poly["at"]
  bar = nil
  bi = -1
  for b, k in bars
    if b["tick0"] <= at && at < b["tick0"] + b["length"]
      bar = b
      bi = k
    end
  end
  score_refuse("the second voice runs past the first", ev["at"]) if bar.nil?
  pos = at - bar["tick0"]
  score_refuse("a note runs past the bar line (bar #{bi + 1})", ev["at"]) if pos + ev["ticks"] > bar["length"]
  if ev["spacer"] == true
    poly["at"] = at + ev["ticks"]
    return nil
  end
  ev["start"] = pos
  ev["bar"] = bi
  # Under the clef and the key of the bar it lands in.
  alters = score_key_alters(bar["fifths"])
  clef = bar["clef"]
  if poly["seen_bar"] != bi
    poly["seen"] = {}
    poly["seen_bar"] = bi
  end
  seen = poly["seen"]
  if ev["k"] == "note"
    mid = score_clef_mid(clef)
    heads = []
    for p in ev["pitches"]
      d = p["d"]
      key = str(d)
      now = seen.has_key(key) ? seen[key] : alters[score_mod(d, 7)]
      show = p["alter"] != now
      show = false if poly["tied"].has_key(key) && poly["tied"][key] == p["alter"]
      seen[key] = p["alter"]
      heads.push({"pos": d - mid, "d": d, "alter": p["alter"], "acc": show ? p["alter"] : nil})
    end
    ev["heads"] = heads.sort_by { |hd| hd["pos"] }
    poly["tied"] = {}
    if ev["tie"] == true
      for p in ev["pitches"]
        poly["tied"][str(p["d"])] = p["alter"]
      end
    end
  else
    poly["tied"] = {}
  end
  bar["items"].push(ev)
  poly["at"] = at + ev["ticks"]
end

def score_flags(base)
  {"1": 0, "2": 0, "4": 0, "8": 1, "16": 2, "32": 3}[str(base)]
end

def score_stem_up?(heads)
  top = heads[-1]["pos"]
  low = heads[0]["pos"]
  low + top < 0
end

def score_beam_windows(time)
  num = time[0]
  den = time[1]
  whole = score_whole()
  beat = whole / den
  return [whole * 3 / 8, whole * 3 / 8] if den == 8 && num % 3 == 0
  return [whole / 2, whole / 4] if num == 4 && den == 4
  return [num * beat, whole / 4] if den == 4 && (num == 2 || num == 3)
  return [whole / 2, whole / 4] if num == 2 && den == 2

  [beat, beat]
end

def score_beams(bars)
  for bar in bars
    wins = score_beam_windows(bar["time"])
    for evs in score_voice_lists(bar)
      score_beam_voice(evs, wins)
    end
    for ev in bar["items"]
      ev["up"] = score_stem_up?(ev["heads"]) if ev["k"] == "note" && ev["beam"].nil? && ev["voice"].nil?
      ev["up"] = ev["voice"] == 1 if ev["k"] == "note" && !ev["voice"].nil?
    end
  end
end

def score_voice_lists(bar)
  return [bar["items"]] unless bar["poly"] == true

  [bar["items"].filter { |ev| ev["voice"] != 2 }, bar["items"].filter { |ev| ev["voice"] == 2 }]
end

def score_beam_voice(evs, wins)
  groups = []
  cur = []
  manual = false
  win = -1
  last_end = -1
  for ev in evs
      gap = last_end >= 0 && ev["start"] != last_end
      last_end = ev["start"] + ev["ticks"]
      flags = ev["k"] == "note" ? score_flags(ev["base"]) : 0
      if manual
        score_refuse("a beam over a note that has no flag", ev["at"]) if flags == 0 && ev["k"] == "note"
        cur.push(ev) if ev["k"] == "note"
        if ev["beam_off"] == true
          groups.push(cur)
          cur = []
          manual = false
        end
        next
      end
      if ev["beam_on"] == true && flags > 0
        groups.push(cur) if cur.length > 0
        cur = [ev]
        manual = true
        next
      end
      w = ev["start"] / wins[0]
      if flags == 0 || w != win || gap
        groups.push(cur) if cur.length > 0
        cur = []
      end
      if flags > 0
        cur.push(ev)
        win = w
      end
    end
    groups.push(cur) if cur.length > 0
    # A group with sixteenths in it is split again by the beat, and so is
    # one with a tuplet: LilyPond's exceptions are for plain eighths, and a
    # tuplet's notes fall back on the beat. A tuplet ends its beam.
    by_beat = []
    for g in groups
      short = g.any? { |ev| score_flags(ev["base"]) > 1 || !ev["tuplet"].nil? }
      if g.length > 1 && short && g[0]["beam_on"] != true
        part = []
        pw = -1
        pt = nil
        for ev in g
          w = ev["start"] / wins[1]
          tid = ev["tuplet"].nil? ? nil : ev["tuplet"]["id"]
          if (w != pw || tid != pt) && part.length > 0
            by_beat.push(part)
            part = []
          end
          part.push(ev)
          pw = w
          pt = tid
        end
        by_beat.push(part)
      else
        by_beat.push(g)
      end
    end
    for g in by_beat
      if g.length < 2
        next
      end

      lowest = 0
      highest = 0
      for ev in g
        lowest = ev["heads"][0]["pos"] if ev["heads"][0]["pos"] < lowest
        highest = ev["heads"][-1]["pos"] if ev["heads"][-1]["pos"] > highest
      end
      up = -lowest > highest
      up = g[0]["voice"] == 1 unless g[0]["voice"].nil?
      group = {"notes": g, "up": up}
      for ev in g
        ev["beam"] = group
        ev["up"] = up
      end
    end
end

def score_duration_space(t, shortest)
  ratio = float(t) / shortest
  return 1.2 * (1.0 + ratio) + 0.1 if ratio < 1.0

  1.2 * (2.0 + score_log2(ratio)) + 0.1
end

def score_shortest(bars)
  counts = {}
  for bar in bars
    least = 0
    for ev in bar["items"]
      t = score_space_ticks(ev)
      least = t if least == 0 || t < least
    end
    counts[str(least)] = (counts[str(least)] ?? 0) + 1 if least > 0
  end
  best = score_whole() / 4
  most = 0
  for key in counts.keys
    t = int(key)
    if counts[key] > most || (counts[key] == most && t < best)
      best = t
      most = counts[key]
    end
  end
  score_min(best, score_whole() * 3 / 16)
end

def score_space_ticks(ev)
  t = score_whole() / ev["base"]
  return t if ev["tuplet"].nil?

  t * ev["tuplet"]["d"] / ev["tuplet"]["n"]
end

def score_head_name(base)
  return "noteheadWhole" if base == 1
  return "noteheadHalf" if base == 2

  "noteheadBlack"
end

def score_rest_name(base)
  {"1": "restWhole", "2": "restHalf", "4": "restQuarter", "8": "rest8th", "16": "rest16th", "32": "rest32nd"}[str(base)]
end

def score_acc_name(alter)
  {"-2": "accidentalDoubleFlat", "-1": "accidentalFlat", "0": "accidentalNatural", "1": "accidentalSharp", "2": "accidentalDoubleSharp"}[str(alter)]
end

def score_flag_name(base, up)
  stem = {"8": "8th", "16": "16th", "32": "32nd"}[str(base)]
  "flag#{stem}#{up ? "Up" : "Down"}"
end

def score_columns(bars, shortest)
  for bar in bars
    for ev in bar["items"]
      t = score_space_ticks(ev)
      ev["ideal"] = score_duration_space(t, shortest)
      if ev["k"] == "rest" && !ev["mm"].nil?
        # A bar's rest for several bars: up to ten, LilyPond's church rests
        # side by side; past that, its wide bar. Either way its count over it.
        ev["ideal"] = ev["mm"] <= 10 ? 3.0 + score_church_width(ev["mm"]) : 7.0 + score_log2(ev["mm"])
        ev["left"] = 0.0
        ev["right"] = ev["mm"] <= 10 ? score_church_width(ev["mm"]) + 1.0 : 4.0
        next
      end
      if ev["k"] == "rest"
        g = score_glyph(score_rest_name(ev["base"]))
        ev["left"] = 0.0
        ev["right"] = g["advance"] + (ev["dots"] > 0 ? 0.3 + 0.6 * ev["dots"] : 0.0)
        next
      end
      head_name = score_glyph(score_head_name(ev["base"]))
      hw = head_name["advance"]
      ev["head_w"] = hw
      score_displace(ev)
      right = hw
      right += hw - SCORE_RULE["stem"] if ev["heads"].any? { |hd| hd["side"] == 1 }
      right += 0.3 + 0.6 * ev["dots"] if ev["dots"] > 0
      if ev["up"] && ev["beam"].nil? && score_flags(ev["base"]) > 0
        right += score_glyph(score_flag_name(ev["base"], true))["advance"] - SCORE_RULE["stem"]
      end
      ev["right"] = right
      shifted = ev["heads"].any? { |hd| hd["side"] == -1 }
      lefts = shifted ? hw - SCORE_RULE["stem"] : 0.0
      ev["left"] = lefts + score_place_accidentals(ev)
      score_lyric_room(ev)
    end
    score_poly_cols(bar, shortest) if bar["poly"] == true
  end
end

def score_lyrics_assign(bars, sylls)
  return nil if sylls.nil?

  k = 0
  tied = false
  slurred = false
  for bar in bars
    for ev in bar["items"]
      next if ev["voice"] == 2 || ev["k"] != "note"

      if tied || slurred
        ev["lyric_held"] = true
      elsif k < sylls.length
        ev["lyric"] = sylls[k]
        k += 1
      end
      tied = ev["tie"] == true
      slurred = (slurred || ev["slur_on"] == true) && ev["slur_off"] != true
    end
  end
  nil
end

def score_lyric_room(ev)
  lyr = ev["lyric"]
  return nil if lyr.nil? || lyr["text"] == ""

  w = score_text_width(lyr["text"], "regular", score_em(0.0))
  c = ev["head_w"] / 2.0
  ev["right"] = score_max(ev["right"], c + w / 2.0 + (lyr["hyphen"] ? 0.9 : 0.35))
  ev["left"] = score_max(ev["left"], w / 2.0 - c + 0.35)
  nil
end

def score_lyric_line(sys)
  has = false
  for bar in sys["bars"]
    for ev in bar["items"]
      has = true unless ev["lyric"].nil?
    end
  end
  return nil unless has

  em = score_em(0.0)
  sys["lyric_y"] = score_max(score_reach(sys)[1] + 0.6, 5.2) + 0.72 * em
  nil
end

def score_draw_lyrics(paths, ink, sys, top, sp)
  em = score_em(0.0)
  y = top + sys["lyric_y"]
  notes = []
  for bar in sys["bars"]
    for ev in bar["items"]
      notes.push(ev) if ev["k"] == "note" && ev["voice"] != 2
    end
  end
  for ev, k in notes
    lyr = ev["lyric"]
    next if lyr.nil?

    w = lyr["text"] == "" ? 0.0 : score_text_width(lyr["text"], "regular", em)
    x0 = ev["x"] + ev["head_w"] / 2.0 - w / 2.0
    x1 = x0 + w
    score_draw_text(paths, ink, lyr["text"], "regular", x0, y, em, sp) if w > 0.0
    nxt = nil
    held = nil
    j = k + 1
    while j < notes.length && nxt.nil?
      if notes[j]["lyric"].nil?
        held = notes[j] if notes[j]["lyric_held"] == true
      else
        nxt = notes[j]
      end
      j += 1
    end
    if lyr["hyphen"] && w > 0.0
      n0 = sys["right"]
      n0 = nxt["x"] + nxt["head_w"] / 2.0 - score_text_width(nxt["lyric"]["text"], "regular", em) / 2.0 unless nxt.nil?
      len = score_min(0.66, n0 - x1 - 0.3)
      if len > 0.15
        mid = nxt.nil? ? x1 + 0.3 + len / 2.0 : (x1 + n0) / 2.0
        paths.push(score_rect(ink, mid - len / 2.0, y - 0.51, len, 0.12, sp))
      end
    end
    if lyr["extend"] && w > 0.0 && !held.nil?
      end_x = held["x"] + held["head_w"]
      paths.push(score_rect(ink, x1 + 0.2, y - 0.05, end_x - x1 - 0.2, 0.1, sp)) if end_x > x1 + 0.6
    end
  end
  nil
end

def score_spacers(bar)
  bar["cols"] ?? bar["items"]
end

def score_poly_cols(bar, shortest)
  starts = []
  for ev in bar["items"]
    starts.push(ev["start"]) unless starts.includes?(ev["start"])
  end
  starts = starts.sort()
  length = bar["length"]
  voices = score_voice_lists(bar)
  cols = []
  for at, ci in starts
    upto = ci + 1 < starts.length ? starts[ci + 1] : length
    col = {"k": "col", "start": at, "ticks": upto - at, "ideal": nil, "left": 0.0, "right": 0.0, "members": []}
    for evs in voices
      for ev, j in evs
        next unless ev["start"] == at

        col["members"].push(ev)
        want = ev["ticks"] <= upto - at ? ev["ideal"] : score_duration_space(upto - at, shortest)
        col["ideal"] = col["ideal"].nil? ? want : score_min(col["ideal"], want)
        col["left"] = score_max(col["left"], ev["left"])
        after = j + 1 < evs.length ? evs[j + 1]["start"] : length
        col["right"] = score_max(col["right"], ev["right"]) if after == upto
      end
    end
    ones = col["members"].filter { |ev| ev["k"] == "note" && ev["voice"] != 2 }
    twos = col["members"].filter { |ev| ev["k"] == "note" && ev["voice"] == 2 }
    # They meet when the first voice's lowest head comes within a step of
    # the second's highest: a second, a unison, or voices that cross, the
    # stem-up one under the stem-down one — their stems would run through
    # each other's heads.
    meet = false
    for a in ones
      for b in twos
        meet = true if a["heads"][0]["pos"] - b["heads"][-1]["pos"] <= 1
      end
    end
    if meet
      for a in ones
        a["shift"] = a["head_w"]
        col["right"] = score_max(col["right"], a["right"] + a["head_w"])
      end
    end
    cols.push(col)
  end
  bar["cols"] = cols
end

def score_displace(ev)
  heads = ev["heads"]
  order = ev["up"] ? heads : heads.reverse()
  prev = nil
  for hd in order
    hd["side"] = 0
    if !prev.nil? && (hd["pos"] - prev["pos"]).abs == 1 && prev["side"] == 0
      hd["side"] = ev["up"] ? 1 : -1
    end
    prev = hd
  end
end

def score_place_accidentals(ev)
  cols = []
  reach = 0.0
  for hd in ev["heads"].reverse()
    next if hd["acc"].nil?

    g = score_glyph(score_acc_name(hd["acc"]))
    y = 2.0 - hd["pos"] / 2.0
    top = y + g["bbox"][1]
    low = y + g["bbox"][3]
    placed = false
    x = 0.0
    for col in cols
      x = col["x"]
      clear = col["spans"].all? { |sn| low <= sn[0] + 0.1 || top >= sn[1] - 0.1 }
      if clear
        col["spans"].push([top, low])
        col["w"] = score_max(col["w"], g["advance"])
        hd["acc_col"] = col
        placed = true
        break
      end
    end
    unless placed
      col = {"spans": [ [top, low] ], "w": g["advance"], "x": 0.0}
      cols.push(col)
      hd["acc_col"] = col
    end
  end
  # Columns from the heads outwards: each sits left of the one before.
  shifted = ev["heads"].any? { |hd| hd["side"] == -1 }
  rim = shifted ? -(ev["head_w"] - SCORE_RULE["stem"]) : 0.0
  for col in cols
    col["x"] = rim - 0.2 - col["w"]
    rim = col["x"]
  end
  for hd in ev["heads"]
    hd["acc_x"] = hd["acc_col"]["x"] unless hd["acc_col"].nil?
  end
  reach = -rim if rim < 0.0
  reach
end

def score_key_width(fifths)
  return 0.0 if fifths == 0

  g = score_glyph(fifths > 0 ? "accidentalSharp" : "accidentalFlat")
  n = score_max(fifths, -fifths)
  n * (g["advance"] + 0.1)
end

def score_time_glyphs(time)
  return ["timeSigCommon"] if time[0] == 4 && time[1] == 4
  return ["timeSigCutCommon"] if time[0] == 2 && time[1] == 2

  nil
end

def score_digits(v)
  str(v).chars().map { |ch| "timeSig#{ch}" }
end

def score_time_width(time)
  one = score_time_glyphs(time)
  return score_glyph(one[0])["advance"] unless one.nil?

  wide = 0.0
  for part in [time[0], time[1]]
    w = score_digits(part).reduce(fn(acc, nm) acc + score_glyph(nm)["advance"], 0.0)
    wide = w if w > wide
  end
  wide
end

def score_prefix_width(bar, first)
  return bar["staff_bars"].map { |sb| score_prefix_width(sb, first) }.reduce(fn(acc, w) score_max(acc, w), 0.0) if bar.has_key("staff_bars")

  w = 0.8 + score_glyph(score_clef_glyph(bar["clef"]))["advance"] + 1.0
  w += score_key_width(bar["fifths"]) + 0.8 if bar["fifths"] != 0
  w += score_time_width(bar["time"]) + 1.0 if first || bar["changes"]["time"] == true
  w
end

def score_clef_glyph(clef)
  {"treble": "gClef", "bass": "fClef", "alto": "cClef"}[clef]
end

def score_change_width(bar)
  return bar["staff_bars"].map { |sb| score_change_width(sb) }.reduce(fn(acc, w) score_max(acc, w), 0.0) if bar.has_key("staff_bars")

  w = 0.0
  ch = bar["changes"]
  w += score_glyph(score_clef_glyph(bar["clef"]))["advance"] + 0.8 if ch["clef"] == true
  if ch["key"] == true
    skip = score_key_cancel(ch["key_from"], bar["fifths"])
    if skip >= 0
      cancelled = score_max(ch["key_from"], -ch["key_from"]) - skip
      w += cancelled * (score_glyph("accidentalNatural")["advance"] + 0.1) + 0.5
    end
    w += score_key_width(bar["fifths"]) + 0.8 if bar["fifths"] != 0
  end
  w += score_time_width(bar["time"]) + 1.0 if ch["time"] == true
  w
end

def score_gaps(bar, k)
  items = score_spacers(bar)
  out = []
  return [score_max(6.0 * k, 4.0)] if items.length == 0

  out.push(1.2 + items[0]["left"])
  for i in 0..items.length
    ev = items[i]
    if i + 1 < items.length
      nxt = items[i + 1]
      out.push(score_max(ev["ideal"] * k, ev["right"] + 0.6 + nxt["left"]))
    else
      out.push(score_max(ev["ideal"] * k, ev["right"] + 0.8))
    end
  end
  out
end

def score_bar_springs(bar)
  spacers = score_spacers(bar)
  return 6.0 if spacers.length == 0

  spacers.reduce(fn(acc, ev) acc + ev["ideal"], 0.0)
end

def score_courtesy_of(bar)
  return {"multi": bar["staff_bars"].map { |sb| score_courtesy_of(sb) }} if bar.has_key("staff_bars")

  changes = bar["changes"]
  {"clef": bar["clef"], "fifths": bar["fifths"], "time": bar["time"], "changes": {"key": changes["key"] == true, "key_from": changes["key_from"] ?? 0, "time": changes["time"] == true}}
end

def score_courtesy_width(bar)
  return bar["multi"].map { |one| score_courtesy_width(one) }.reduce(fn(acc, w) score_max(acc, w), 0.0) if bar.has_key("multi")

  cw_changes = bar["changes"]
  cw = 0.0
  cw_skip = -1
  if cw_changes["key"] == true
    cw_skip = score_key_cancel(cw_changes["key_from"], bar["fifths"])
    cw += (score_max(cw_changes["key_from"], 0 - cw_changes["key_from"]) - cw_skip) * (score_glyph("accidentalNatural")["advance"] + 0.1) + 0.5 if cw_skip >= 0
    cw += score_key_width(bar["fifths"]) + 0.5 if bar["fifths"] != 0
  end
  cw += score_time_width(bar["time"]) + 0.5 if cw_changes["time"] == true
  cw > 0.0 ? cw + 0.6 : 0.0
end

def score_bar_width(bar, k, opening)
  gaps = score_gaps(bar, k)
  total = gaps.reduce(fn(acc, g) acc + g, 0.0)
  total += score_change_width(bar) unless opening
  total += score_barline_width(".|:") + 0.4 if opening && !bar["open_repeat"].nil?
  total + score_barline_width(bar["bar_drawn"] ?? bar["bar"])
end

def score_barline_parts(kind)
  {"|": ["thin"], "||": ["thin", "thin"], "|.": ["thin", "thick"], ".|:": ["thick", "thin", "dots"], ":|.": ["dots", "thin", "thick"], ":|.|:": ["dots", "thin", "thick", "thin", "dots"]}[kind] ?? ["thin"]
end

def score_barline_width(kind)
  parts = score_barline_parts(kind)
  sizes = {"thin": SCORE_RULE["thin"], "thick": SCORE_RULE["thick"], "dots": score_glyph("augmentationDot")["advance"]}
  parts.reduce(fn(acc, part) acc + sizes[part], 0.0) + SCORE_RULE["kern"] * (parts.length - 1)
end

def score_system_width(bars, k)
  total = score_prefix_width(bars[0], bars[0]["first"] == true)
  for b, i in bars
    total += score_bar_width(b, k, i == 0)
  end
  total
end

def score_break(bars, width, indent, rest = 0.0)
  bars[0]["first"] = true
  bars[0]["open_repeat"] = ".|:" if bars[0]["open_bar"] == true
  count = bars.length
  opening_w = bars.map { |b| score_bar_width(b, 1.0, true) }
  inner_w = bars.map { |b| score_bar_width(b, 1.0, false) }
  opening_min = bars.map { |b| score_bar_width(b, 0.0, true) }
  inner_min = bars.map { |b| score_bar_width(b, 0.0, false) }
  springs = bars.map { |b| score_bar_springs(b) }
  # What announcing the next line's opening would cost, bar by bar: each
  # line's end asks it of the bar after it, once and not once per line.
  courtesy_w = bars.map { |b| score_courtesy_width(score_courtesy_of(b)) }
  prefix_w = range(0, count).map { |t| score_prefix_width(bars[t], t == 0) }
  memo_key = score_break_key(width, indent + rest * 1000.0, [opening_w, inner_w, opening_min, inner_min, springs, courtesy_w, prefix_w])
  known = score_memo_get("breaks", memo_key)
  return score_break_lines(bars, width, indent, known, rest) unless known.nil?

  best = [0.0]
  from_bar = [0]
  for _ in range(0, count)
    best.push(-1.0)
    from_bar.push(0)
  end
  for i in 0..count
    next if best[i] < 0.0

    room = i == 0 ? width - indent : width - rest
    w = prefix_w[i] + opening_w[i]
    tight = prefix_w[i] + opening_min[i]
    spring = springs[i]
    jj = i + 1
    while jj <= count
      # A line never runs past a bar that a \break or a \pageBreak ends.
      break if jj > i + 1 && !bars[jj - 2]["brk"].nil?

      if jj > i + 1
        w += inner_w[jj - 1]
        tight += inner_min[jj - 1]
        spring += springs[jj - 1]
      end
      courtesy = jj < count ? courtesy_w[jj] : 0.0
      line_w = w + courtesy
      # A line may also be pressed a little closer than its natural spacing,
      # as LilyPond's may, down to what its ink needs and at a steeper
      # price than stretching; past that it is not a line.
      break if tight + courtesy > room && jj > i + 1

      cost = 0.0
      ratio = (room - line_w) / score_max(spring, 1.0)
      if tight + courtesy > room
        cost = 1000.0
      elsif ratio < 0.0
        cost = ratio * ratio * 40.0 + 1.0
      elsif jj < count
        cost = ratio * ratio * 10.0 + 1.0
      end
      total = best[i] + cost
      if best[jj] < 0.0 || total < best[jj]
        best[jj] = total
        from_bar[jj] = i
      end
      jj += 1
    end
  end
  cuts = []
  at = count
  while at > 0
    cuts.push(from_bar[at])
    at = from_bar[at]
  end
  starts = cuts.reverse()
  score_memo_put("breaks", memo_key, starts, 16)
  score_break_lines(bars, width, indent, starts, rest)
end

def score_break_key(width, indent, columns)
  parts = [str(width), str(indent)]
  for col in columns
    parts.push(col.map { |v| str(v.round(6)) }.join(","))
  end
  parts.join("|")
end

def score_break_lines(bars, width, indent, starts, rest = 0.0)
  count = bars.length
  systems = []
  for start, si in starts
    stop = si + 1 < starts.length ? starts[si + 1] : count
    systems.push({"bars": range(start, stop).map { |t| bars[t] }})
  end
  # A repeat sign on a line break is split as LilyPond splits it: the line
  # ends with what closes (a plain line, or the end repeat), and the next
  # opens, after its clef and key, with the start repeat.
  for sys, si in systems
    tail = sys["bars"][-1]
    kind = tail["bar"]
    next if si + 1 >= systems.length

    if kind == ".|:" || kind == ":|.|:"
      tail["bar_drawn"] = kind == ".|:" ? "|" : ":|."
      systems[si + 1]["bars"][0]["open_repeat"] = ".|:"
    end
  end
  for sys, si in systems
    room = si == 0 ? width - indent : width - rest
    # A change at the start of the next line is announced at the end of
    # this one, after its bar line, as LilyPond does: room for it first.
    sys["courtesy"] = 0.0
    # A plain summary of the next line's opening: a bar is cyclic (its notes
    # hold their beams, which hold the notes), and is better not carried
    # about. Declared before the `if`, and named for this function alone.
    next_open = nil
    if si + 1 < systems.length
      next_open = systems[si + 1]["bars"][0]
      sys["courtesy_bar"] = score_courtesy_of(next_open)
      sys["courtesy"] = score_courtesy_width(sys["courtesy_bar"])
      room -= sys["courtesy"]
    end
    natural = score_system_width(sys["bars"], 1.0)
    last = si == systems.length - 1
    k = 1.0
    if natural > room
      k = score_fit(sys["bars"], room, 0.0, 1.0)
    elsif !last || natural >= room * 0.85
      k = score_fit(sys["bars"], room, 1.0, 8.0)
    end
    sys["k"] = k
  end
  systems
end

def score_line_terms(bars)
  base = score_prefix_width(bars[0], bars[0]["first"] == true)
  ideals = []
  leasts = []
  for bar, i in bars
    items = score_spacers(bar)
    if items.length == 0
      ideals.push(6.0)
      leasts.push(4.0)
    else
      base += 1.2 + items[0]["left"]
      for j in 0..items.length
        ev = items[j]
        ideals.push(ev["ideal"])
        leasts.push(j + 1 < items.length ? ev["right"] + 0.6 + items[j + 1]["left"] : ev["right"] + 0.8)
      end
    end
    base += score_change_width(bar) unless i == 0
    base += score_barline_width(".|:") + 0.4 if i == 0 && !bar["open_repeat"].nil?
    base += score_barline_width(bar["bar_drawn"] ?? bar["bar"])
  end
  {"base": base, "ideals": ideals, "leasts": leasts}
end

def score_terms_width(terms, k)
  total = terms["base"]
  ideals = terms["ideals"]
  leasts = terms["leasts"]
  for j in 0..ideals.length
    total += score_max(ideals[j] * k, leasts[j])
  end
  total
end

def score_fit(bars, width, lo, hi)
  terms = score_line_terms(bars)
  for _ in 0..30
    mid = (lo + hi) / 2.0
    if score_terms_width(terms, mid) > width
      hi = mid
    else
      lo = mid
    end
  end
  lo
end

def score_place(systems, width, left, indent, rest = 0.0)
  for sys, si in systems
    bars = sys["bars"]
    sys["left"] = left + (si == 0 ? indent : rest)
    x = sys["left"] + score_prefix_width(bars[0], bars[0]["first"] == true)
    sys["prefix"] = x
    sys["right"] = 0.0
    for bar, bi in bars
      bar["x0"] = x
      x += score_change_width(bar) unless bi == 0
      if bi == 0 && !bar["open_repeat"].nil?
        x += score_barline_width(".|:")
        bar["open_repeat_x"] = x
        x += 0.4
      end
      gaps = score_gaps(bar, sys["k"])
      items = bar["items"]
      if items.length == 1 && items[0]["k"] == "rest" && (items[0]["full"] == true || items[0]["ticks"] == bar["length"])
        span = gaps.reduce(fn(acc, g) acc + g, 0.0)
        items[0]["x"] = x + span / 2.0 - score_glyph("restWhole")["advance"] / 2.0
        items[0]["whole_bar"] = true
        items[0]["span0"] = x
        items[0]["span1"] = x + span
        x += span
      else
        x += gaps[0]
        for ev, i in score_spacers(bar)
          ev["x"] = x
          # A column's notes, both voices', at its place.
          for m in ev["members"] ?? []
            m["x"] = x + (m["shift"] ?? 0.0)
          end
          x += gaps[i + 1]
        end
      end
      bar["x1"] = x
      x += score_barline_width(bar["bar_drawn"] ?? bar["bar"])
    end
    sys["bar_end"] = x
    sys["right"] = x + (sys["courtesy"] ?? 0.0)
    score_stems_beams(bars)
  end
end

def score_stems_beams(bars)
  for bar in bars
    for ev in bar["items"]
      score_stem(ev) if ev["k"] == "note" && ev["beam"].nil?
    end
    groups = []
    for ev in bar["items"]
      groups.push(ev["beam"]) if !ev["beam"].nil? && ev["beam"]["notes"][0]["n"] == ev["n"]
    end
    for g in groups
      score_beam(g)
    end
  end
end

def score_stack(systems, layout, head)
  page_h = layout["page_h"]
  margin = layout["top"] ?? 0.0
  floor_y = page_h.nil? ? 0.0 : page_h - (layout["bottom"] ?? 0.0)
  gap = layout["gap"] ?? 10.0
  titled = head["lines"].length > 0
  pages = [ {"index": 0, "systems": []} ]
  prev = nil
  for sys in systems
    reach = score_reach(sys)
    tp = 0.0
    if prev.nil?
      tp = titled ? score_max(margin + head["bottom"] + 3.0, margin + head["bottom"] + 0.5 - reach[0]) : margin + 0.5 - reach[0]
      tp += 1.0 if titled && page_h.nil?
    else
      tp = score_max(prev["top"] + gap, prev["bottom"] + 1.0 - reach[0])
    end
    forced = !prev.nil? && prev["bars"][-1]["brk"] == "page"
    if !page_h.nil? && !prev.nil? && (forced || tp + reach[1] + 1.0 > floor_y)
      pages.push({"index": pages.length, "systems": []})
      tp = margin + 3.5 + 1.0 - reach[0]
    end
    sys["top"] = tp
    sys["bottom"] = tp + reach[1]
    sys["reach_hi"] = reach[0]
    sys["page"] = pages.length - 1
    pages[-1]["systems"].push(sys)
    prev = sys
  end
  unless page_h.nil?
    for pg, pi in pages
      on_page = pg["systems"]
      next if pi == pages.length - 1 || on_page.length < 2

      extra = floor_y - 1.0 - on_page[-1]["bottom"]
      step = score_min(extra / (on_page.length - 1), 6.0)
      next if step <= 0.0

      for sys, k in on_page
        sys["top"] = sys["top"] + step * k
        sys["bottom"] = sys["bottom"] + step * k
      end
    end
  end
  pages
end

def score_marks(systems)
  score_hairpins(systems)
  for sys in systems
    # Brackets over repeat endings go over the top staff only.
    sys["voltas"] = (sys["staff_index"] ?? 0) == 0 ? score_voltas(sys) : []
    sys["tuplets"] = score_tuplets(sys)
    score_scripts(sys)
    score_dynamics(sys)
    score_texts(sys)
    score_lyric_line(sys)
    sys["marks"] = []
    for bar, bi in sys["bars"]
      for ev, ii in bar["items"]
        mark = ev["tempo"]
        next if mark.nil?

        x = ev["x"]
        x = sys["left"] + 0.8 + score_glyph(score_clef_glyph(bar["clef"]))["advance"] + 1.0 if bi == 0 && ii == 0
        w = score_mark_width(mark)
        low = -1.0
        for other_bar in sys["bars"]
          for other in other_bar["items"]
            next if other["x"] + 1.5 < x || other["x"] > x + w + 1.0
            next unless other["k"] == "note"

            low = score_min(low, score_y(other["heads"][-1]["pos"]) - 0.7)
            low = score_min(low, other["stem_end"] - 0.3)
          end
        end
        for tp in sys["tuplets"]
          next if !tp["up"] || tp["x1"] < x - 1.0 || tp["x0"] > x + w + 1.0

          low = score_min(low, score_min(tp["ya"], tp["yb"]) - 1.0)
        end
        for other_bar in sys["bars"]
          for other in other_bar["items"]
            next if other["x"] + 1.5 < x || other["x"] > x + w + 1.0

            low = score_min(low, (other["reach_up"] ?? 0.0) - 0.3)
          end
        end
        for tx in sys["texts"]
          next if tx["dir"] > 0 || tx["x1"] < x - 1.0 || tx["x0"] > x + w + 1.0

          low = score_min(low, tx["top"] - 0.3)
        end
        # And clear of the slurs and ties under it: their outline's points.
        for c in sys["curves"]
          ci = 0
          while ci < c.length
            args = [2, 2, 4, 6, 0][c[ci]]
            for jj in 0..args
              if jj % 2 == 0
                px = c[ci + 1 + jj]
                py = c[ci + 2 + jj]
                low = score_min(low, py - 0.2) if px >= x - 1.0 && px <= x + w + 1.0
              end
            end
            ci += 1 + args
          end
        end
        sys["marks"].push({"x": x, "y": low - 0.9, "mark": mark})
      end
    end
  end
end

def score_tuplets(sys)
  groups = []
  by_id = {}
  for bar in sys["bars"]
    for ev in bar["items"]
      next if ev["tuplet"].nil?

      key = str(ev["tuplet"]["id"])
      unless by_id.has_key(key)
        by_id[key] = {"items": [], "n": ev["tuplet"]["n"]}
        groups.push(by_id[key])
      end
      by_id[key]["items"].push(ev)
    end
  end
  groups.map { |tg| score_tuplet_place(tg) }
end

def score_tuplet_place(tg)
  items = tg["items"]
  notes = items.filter { |ev| ev["k"] == "note" }
  first_beam = notes.length > 0 && !notes[0]["beam"].nil? ? notes[0]["beam"]["notes"][0]["i"] : -1
  beamed = notes.length == items.length && notes.length > 1 && first_beam >= 0 && notes.all? { |ev| !ev["beam"].nil? && ev["beam"]["notes"][0]["i"] == first_beam }
  ups = notes.filter { |ev| ev["up"] == true }.length
  up = beamed ? notes[0]["beam"]["up"] : ups * 2 >= notes.length
  last = items[-1]
  x0 = items[0]["x"] - 0.2
  x1 = last["x"] + (last["head_w"] ?? 1.2) + 0.2
  dir = up ? -1.0 : 1.0
  ya = 0.0
  yb = 0.0
  if beamed
    g = notes[0]["beam"]
    ya = score_beam_y(g, x0) + 1.1 * dir
    yb = score_beam_y(g, x1) + 1.1 * dir
  else
    # A line through the outermost ink of the first and the last, its
    # slope held to a space, then moved out until every note clears it.
    edges = items.map { |ev| score_tuplet_edge(ev, up) }
    ya = edges[0] + 1.1 * dir
    yb = edges[-1] + 1.1 * dir
    yb = ya + score_max(-1.0, score_min(1.0, yb - ya))
    span = score_max(x1 - x0, 0.01)
    push = 0.0
    for ev, k in items
      at = ya + (yb - ya) * (ev["x"] - x0) / span
      need = edges[k] + 1.1 * dir
      push = up ? score_min(push, need - at) : score_max(push, need - at)
    end
    # And off the staff by a quarter space, hooks included.
    reach = up ? score_min(ya, yb) + push + 0.7 : score_max(ya, yb) + push - 0.7
    push += up ? score_min(0.0, -0.25 - reach) : score_max(0.0, 4.25 - reach)
    ya += push
    yb += push
  end
  {"x0": x0, "x1": x1, "ya": ya, "yb": yb, "up": up, "bracket": !beamed, "label": str(tg["n"])}
end

def score_rest_lift(ev)
  return -2.0 if ev["voice"] == 1
  return 2.0 if ev["voice"] == 2

  0.0
end

def score_tuplet_edge(ev, up)
  if ev["k"] != "note"
    return (up ? 1.0 : 3.0) + score_rest_lift(ev)
  end

  y_top = score_y(ev["heads"][-1]["pos"]) - 0.5
  y_bottom = score_y(ev["heads"][0]["pos"]) + 0.5
  return score_min(y_top, ev["up"] && ev["base"] > 1 ? ev["stem_end"] : y_top) if up

  score_max(y_bottom, !ev["up"] && ev["base"] > 1 ? ev["stem_end"] : y_bottom)
end

def score_item_extent(ev)
  return [1.0 + score_rest_lift(ev), 3.0 + score_rest_lift(ev)] if ev["k"] != "note"

  [score_tuplet_edge(ev, true), score_tuplet_edge(ev, false)]
end

def score_item_w(ev)
  return ev["head_w"] unless ev["head_w"].nil?
  return score_max(ev["span1"] - ev["span0"] - 2.0, 1.0) unless ev["mm"].nil?

  score_glyph(score_rest_name(ev["base"]))["advance"]
end

def score_scripts(sys)
  sys["scripts"] = []
  for bar in sys["bars"]
    for ev in bar["items"]
      ext = score_item_extent(ev)
      ev["reach_up"] = ext[0]
      ev["reach_down"] = ext[1]
      next if ev["scripts"].nil?

      xc = ev["x"] + score_item_w(ev) / 2.0
      heads_top = ev["k"] == "note" ? score_y(ev["heads"][-1]["pos"]) - 0.5 : 1.0 + score_rest_lift(ev)
      heads_bottom = ev["k"] == "note" ? score_y(ev["heads"][0]["pos"]) + 0.5 : 3.0 + score_rest_lift(ev)
      up_cursor = heads_top
      down_cursor = heads_bottom
      # A side the stem is on starts past the stem's end.
      up_cursor = ext[0] if ev["k"] == "note" && ev["up"] == true
      down_cursor = ext[1] if ev["k"] == "note" && ev["up"] != true
      list = ev["scripts"].sort_by { |sc| SCORE_SCRIPTS[sc["name"]]["prio"] }
      for sc in list
        rule = SCORE_SCRIPTS[sc["name"]]
        dir = sc["dir"]
        dir = rule["side"] if dir == 0 && rule["side"] != 0
        dir = ev["up"] == true ? 1 : -1 if dir == 0
        name = dir < 0 ? rule["up"] : rule["down"]
        bb = score_glyph(name)["bbox"]
        y = 0.0
        if dir < 0
          y = up_cursor - rule["pad"] - bb[3]
          if rule["quant"]
            mid = y + (bb[1] + bb[3]) / 2.0
            y += score_space_above(mid) - mid if mid > -0.5 && mid < 4.5
          elsif y + bb[3] > -0.25
            y = -0.25 - bb[3]
          end
          up_cursor = y + bb[1]
        else
          y = down_cursor + rule["pad"] - bb[1]
          if rule["quant"]
            mid = y + (bb[1] + bb[3]) / 2.0
            y += score_space_below(mid) - mid if mid > -0.5 && mid < 4.5
          elsif y + bb[1] < 4.25
            y = 4.25 - bb[1]
          end
          down_cursor = y + bb[3]
        end
        sys["scripts"].push({"glyph": name, "x": xc, "y": y})
      end
      ev["reach_up"] = score_min(ext[0], up_cursor)
      ev["reach_down"] = score_max(ext[1], down_cursor)
    end
  end
end

def score_space_above(y)
  Math.floor(y - 0.5) + 0.5
end

def score_space_below(y)
  Math.ceil(y - 0.5) + 0.5
end

def score_hairpins(systems)
  flat = []
  for sys, si in systems
    sys["hairpins"] = []
    for bar in sys["bars"]
      for ev in bar["items"]
        flat.push({"ev": ev, "sys": si, "bar": bar})
      end
    end
  end
  for at, k in flat
    grow = at["ev"]["hairpin"]
    next if grow.nil?

    stop = flat.length - 1
    how = "end"
    jj = k + 1
    while jj < flat.length
      other = flat[jj]["ev"]
      if other["hairpin_end"] == true
        stop = jj
        how = "note"
        break
      end
      if !other["dyn"].nil? || !other["hairpin"].nil?
        stop = jj
        how = "next"
        break
      end
      jj += 1
    end
    start_ev = at["ev"]
    # It leaves a dynamic on its own note by LilyPond's `bound-padding`.
    x0 = start_ev["x"]
    x0 = score_max(x0, score_dyn_x(start_ev) + score_dyn_width(start_ev["dyn"]) + 1.0) unless start_ev["dyn"].nil?
    end_at = flat[stop]
    end_ev = end_at["ev"]
    x1 = end_ev["x"] + score_item_w(end_ev) + 0.15
    if how == "next"
      x1 = end_ev["dyn"].nil? ? end_ev["x"] - 0.6 : score_dyn_x(end_ev) - 1.0
    end
    # One that ends on a bar's first note stops at the bar line before it
    # (`to-barline`).
    if how != "end" && end_ev["start"] == 0 && stop > k && flat[stop - 1]["bar"]["number"] != end_at["bar"]["number"]
      x1 = score_min(x1, flat[stop - 1]["bar"]["x1"] + score_barline_width(flat[stop - 1]["bar"]["bar"]) - 0.8)
      end_at = flat[stop - 1]
    end
    first = at["sys"]
    last = end_at["sys"]
    for si in range(first, last + 1)
      sys = systems[si]
      a = si == first ? x0 : sys["prefix"]
      b = si == last ? x1 : sys["right"]
      parts = last - first + 1
      ka = float(si - first) / parts
      kb = float(si - first + 1) / parts
      sys["hairpins"].push({"x0": a, "x1": score_max(b, a + 2.0), "grow": grow, "from": ka, "to": kb})
    end
  end
end

def score_dyn_letters(dyn)
  names = {"p": "dynamicPiano", "m": "dynamicMezzo", "f": "dynamicForte", "r": "dynamicRinforzando", "s": "dynamicSforzando", "z": "dynamicZ", "n": "dynamicNiente"}
  dyn.chars().map { |ch| names[ch] }
end

def score_dyn_width(dyn)
  score_dyn_letters(dyn).map { |name| score_glyph(name)["advance"] }.reduce(fn(acc, w) acc + w, 0.0)
end

def score_dyn_x(ev)
  ev["x"] + score_item_w(ev) / 2.0 - score_dyn_width(ev["dyn"]) / 2.0
end

def score_dynamics(sys)
  els = []
  for bar in sys["bars"]
    for ev in bar["items"]
      next if ev["dyn"].nil?

      x = score_dyn_x(ev)
      top = 0.0
      bottom = 0.0
      for name in score_dyn_letters(ev["dyn"])
        bb = score_glyph(name)["bbox"]
        top = score_min(top, bb[1])
        bottom = score_max(bottom, bb[3])
      end
      els.push({"kind": "dyn", "text": ev["dyn"], "x0": x, "x1": x + score_dyn_width(ev["dyn"]), "top": 0.6 + top, "bottom": 0.6 + bottom})
    end
  end
  for hp in sys["hairpins"]
    els.push({"kind": "hairpin", "x0": hp["x0"], "x1": hp["x1"], "grow": hp["grow"], "from": hp["from"], "to": hp["to"], "top": -0.6666, "bottom": 0.6666})
  end
  els = els.sort_by { |el| el["x0"] }
  sys["dynamics"] = []
  k = 0
  while k < els.length
    group = [els[k]]
    reach = els[k]["x1"]
    k += 1
    while k < els.length && els[k]["x0"] - reach < 1.5
      group.push(els[k])
      reach = score_max(reach, els[k]["x1"])
      k += 1
    end
    line = 0.0
    for el in group
      line = score_max(line, score_dyn_line(sys, el))
    end
    for el in group
      el["y"] = line
      el["bottom"] = line + el["bottom"] + 0.3
      sys["dynamics"].push(el)
    end
  end
end

def score_dyn_line(sys, el)
  need = 4.0 + 0.6 - el["top"]
  for bar in sys["bars"]
    for ev in bar["items"]
      right = ev["x"] + score_item_w(ev)
      next if right < el["x0"] - 0.2 || ev["x"] > el["x1"] + 0.2

      rise = -el["top"]
      if el["kind"] == "hairpin"
        span = score_max(el["x1"] - el["x0"], 0.01)
        at = score_max(0.0, score_min(1.0, (ev["x"] - el["x0"]) / span))
        open = el["from"] + (el["to"] - el["from"]) * at
        open = 1.0 - open if el["grow"] == ">"
        rise = 0.6666 * open
      end
      need = score_max(need, (ev["reach_down"] ?? 4.0) + 0.6 + rise)
    end
  end
  for tp in sys["tuplets"] ?? []
    next if tp["up"] || tp["x1"] < el["x0"] || tp["x0"] > el["x1"]

    need = score_max(need, score_max(tp["ya"], tp["yb"]) + 0.9 + 0.6 - el["top"])
  end
  need
end

def score_texts(sys)
  sys["texts"] = []
  em = score_em(0.0)
  for bar in sys["bars"]
    for ev in bar["items"]
      for tx in ev["texts"] ?? []
        w = score_text_width(tx["text"], "regular", em)
        box = score_text_box(tx["text"], "regular", em)
        x0 = ev["x"]
        x1 = x0 + w
        y = 0.0
        if tx["dir"] < 0
          edge = -0.5
          for other_bar in sys["bars"]
            for other in other_bar["items"]
              next if other["x"] + score_item_w(other) < x0 - 0.2 || other["x"] > x1 + 0.2

              edge = score_min(edge, other["reach_up"] ?? 0.0)
            end
          end
          for prev in sys["texts"]
            edge = score_min(edge, prev["top"]) if prev["dir"] < 0 && prev["x1"] > x0 && prev["x0"] < x1
          end
          y = edge - 0.45 - box[1]
        else
          edge = 4.5
          for other_bar in sys["bars"]
            for other in other_bar["items"]
              next if other["x"] + score_item_w(other) < x0 - 0.2 || other["x"] > x1 + 0.2

              edge = score_max(edge, other["reach_down"] ?? 4.0)
            end
          end
          for dy in sys["dynamics"]
            edge = score_max(edge, dy["bottom"]) if dy["x1"] > x0 - 0.2 && dy["x0"] < x1 + 0.2
          end
          for prev in sys["texts"]
            edge = score_max(edge, prev["bottom"]) if prev["dir"] > 0 && prev["x1"] > x0 && prev["x0"] < x1
          end
          y = edge + 0.45 - box[0]
        end
        sys["texts"].push({"text": tx["text"], "x0": x0, "x1": x1, "y": y, "top": y + box[0], "bottom": y + box[1], "dir": tx["dir"]})
      end
    end
  end
end

def score_text_box(words, weight, em)
  face = score_letters()[weight]
  rise = 0
  fall = 0
  for ch in words.chars()
    next unless face.has_key(ch)

    cmds = face[ch]["f"]
    ci = 0
    while ci < cmds.length
      args = [2, 2, 4, 6, 0][cmds[ci]]
      jj = 1
      while jj < args
        rise = score_min(rise, cmds[ci + 1 + jj])
        fall = score_max(fall, cmds[ci + 1 + jj])
        jj += 2
      end
      ci += 1 + args
    end
  end
  [rise * em / 1000.0, fall * em / 1000.0]
end

def score_voltas(sys)
  out = []
  run = nil
  for bar, bi in sys["bars"]
    label = bar["volta_in"]
    if !label.nil? && run.nil?
      run = {"label": label, "first": bar["volta_first"] == true, "x0": bar["x0"], "bars": []}
    end
    unless run.nil?
      run["bars"].push(bi)
      run["x1"] = bar["x1"] + score_barline_width(bar["bar_drawn"] ?? bar["bar"])
      run["closed"] = bar["volta_last"] == true && bar["volta_closed"] == true
      if bar["volta_last"] == true || bi == sys["bars"].length - 1 || sys["bars"][bi + 1]["volta_in"] != label
        out.push(run)
        run = nil
      end
    end
  end
  for vb in out
    low = -2.0
    for bi in vb["bars"]
      for ev in sys["bars"][bi]["items"]
        next unless ev["k"] == "note"

        low = score_min(low, score_y(ev["heads"][-1]["pos"]) - 0.7)
        low = score_min(low, ev["stem_end"] - 0.3)
      end
    end
    vb["y"] = low - 1.0
  end
  out
end

def score_mark_width(mark)
  em = score_em(0.0)
  w = mark["text"] == "" ? 0.0 : score_text_width(mark["text"], "bold", em)
  if mark["bpm"] > 0
    w += 0.6 if w > 0.0
    w += score_text_width("( = " + str(mark["bpm"]) + ")", "regular", em) + 1.6
  end
  w
end

def score_reach(sys)
  return sys["reach"] if sys.has_key("reach")

  hi = 0.0
  lo = 4.0
  for bar in sys["bars"]
    for ev in bar["items"]
      next unless ev["k"] == "note"

      for hd in ev["heads"]
        y = score_y(hd["pos"])
        hi = score_min(hi, y - (hd["acc"].nil? ? 0.6 : 1.8))
        lo = score_max(lo, y + (hd["acc"].nil? ? 0.6 : 1.8))
      end
      hi = score_min(hi, ev["stem_end"] - 0.6)
      lo = score_max(lo, ev["stem_end"] + 0.6)
    end
  end
  for mk in sys["marks"] ?? []
    hi = score_min(hi, mk["y"] - 1.8)
  end
  hi = score_min(hi, -3.0) if sys["bars"][0]["number"] > 1
  for vb in sys["voltas"] ?? []
    hi = score_min(hi, vb["y"] - 0.4)
  end
  for tp in sys["tuplets"] ?? []
    hi = score_min(hi, score_min(tp["ya"], tp["yb"]) - 0.9) if tp["up"]
    lo = score_max(lo, score_max(tp["ya"], tp["yb"]) + 0.9) unless tp["up"]
  end
  for bar in sys["bars"]
    for ev in bar["items"]
      hi = score_min(hi, ev["reach_up"] ?? 0.0)
      lo = score_max(lo, ev["reach_down"] ?? 4.0)
    end
  end
  for dy in sys["dynamics"] ?? []
    lo = score_max(lo, dy["bottom"])
  end
  for tx in sys["texts"] ?? []
    hi = score_min(hi, tx["top"]) if tx["dir"] < 0
    lo = score_max(lo, tx["bottom"]) if tx["dir"] > 0
  end
  for bar in sys["bars"]
    hi = score_min(hi, -2.6) if bar["items"].length > 0 && !bar["items"][0]["mm"].nil?
  end
  lo = score_max(lo, sys["lyric_y"] + 0.25 * score_em(0.0) + 0.6) if sys.has_key("lyric_y")
  for c in sys["curves"]
    i = 0
    while i < c.length
      args = [2, 2, 4, 6, 0][c[i]]
      for jj in 0..args
        if jj % 2 == 1
          hi = score_min(hi, c[i + 1 + jj])
          lo = score_max(lo, c[i + 1 + jj])
        end
      end
      i += 1 + args
    end
  end
  [hi, lo]
end

def score_y(pos)
  2.0 - pos / 2.0
end

def score_stem(ev)
  if ev["base"] == 1
    ev["stem_end"] = score_y(ev["heads"][-1]["pos"])
    return nil
  end
  stem_len = 3.5 + (ev["base"] == 32 ? 0.75 : 0.0)
  if ev["up"]
    tip = score_y(ev["heads"][-1]["pos"]) - stem_len
    ev["stem_end"] = score_min(tip, 2.0)
  else
    tip = score_y(ev["heads"][0]["pos"]) + stem_len
    ev["stem_end"] = score_max(tip, 2.0)
  end
end

def score_stem_x(ev)
  ev["up"] ? ev["x"] + ev["head_w"] : ev["x"]
end

def score_quant(y, toward)
  inside = y > -0.6 && y < 4.6
  best = nil
  base = y.floor - 2
  for i in 0..6
    line = float(base + i)
    half_line = SCORE_RULE["staff"] / 2.0
    bt = SCORE_RULE["beam"]
    for c in inside ? [line - bt - half_line, line - bt / 2.0, line + half_line] : [line, line + 0.25, line + 0.5, line + 0.75]
      ok = true
      ok = c <= y + 0.0001 if toward < 0
      ok = c >= y - 0.0001 if toward > 0
      if ok && (best.nil? || (c - y).abs < (best - y).abs)
        best = c
      end
    end
  end
  best ?? y
end

def score_beam(g)
  notes = g["notes"]
  up = g["up"]
  n_beams = notes.reduce(fn(acc, ev) score_max(acc, score_flags(ev["base"])), 0)
  thick = SCORE_RULE["beam"]
  near = notes.map { |ev| score_y(up ? ev["heads"][-1]["pos"] : ev["heads"][0]["pos"]) }
  x0 = score_stem_x(notes[0])
  x1 = score_stem_x(notes[-1])
  dx = score_max(x1 - x0, 0.01)
  dy = near[-1] - near[0]
  # Damped to a little over half the notes' own rise, and never more than
  # a space and a half end to end: LilyPond 2.24 tilts a falling e-d-c-b
  # by 0.8 of a space and a rising sixth of eighths by about 1.4.
  slope = (dy * 0.55).clamp(-1.5, 1.5) / dx
  concave = false
  for y, i in near
    next if i == 0 || i == near.length - 1

    if up && y < score_min(near[0], near[-1])
      concave = true
    end
    if !up && y > score_max(near[0], near[-1])
      concave = true
    end
  end
  slope = 0.0 if concave
  # Where the outer edge sits at x0. LilyPond scores each stem by how far
  # it is from its ideal length and takes the best total, which with the
  # slope settled puts the *mean* stem at the ideal: so do that, then make
  # sure no stem is shorter than its minimum. Measured on LilyPond 2.24's
  # own output, a one-beam group's stems average 3.36 spaces to the outer
  # edge; more beams want a little more, as its `beamed-lengths` do.
  ideal = [3.36, 3.6, 3.8][score_min(n_beams, 3) - 1]
  shortest = 2.5 + (n_beams - 1) * SCORE_RULE["beam_step"]
  b = 0.0
  for ev, i in notes
    xs = score_stem_x(ev) - x0
    b += up ? near[i] - ideal - slope * xs : near[i] + ideal - slope * xs
  end
  b = b / notes.length
  for ev, i in notes
    xs = score_stem_x(ev) - x0
    stem_len = up ? near[i] - (b + slope * xs) : (b + slope * xs) - near[i]
    b -= shortest - stem_len if up && stem_len < shortest
    b += shortest - stem_len if !up && stem_len < shortest
  end
  # Every stem reaches the middle line: the beam hangs from it at the
  # nearest, or sits on it.
  for ev, i in notes
    xs = score_stem_x(ev) - x0
    rim = b + slope * xs
    b -= rim - 2.0 if up && rim > 2.0
    b += 2.0 - rim if !up && rim < 2.0
  end
  # Quant both ends of the outer beam: the top edge of an up beam, the
  # bottom edge of a down one (whose top is a thickness above).
  y_left = b
  y_right = b + slope * dx
  q_left = y_left
  q_right = y_right
  # To the nearest allowed place, unless that would leave a stem short.
  toward = 0
  for ev, i in notes
    xs = score_stem_x(ev) - x0
    stem_len = up ? near[i] - (b + slope * xs) : (b + slope * xs) - near[i]
    if stem_len < shortest + 0.25
      toward = up ? -1 : 1
    end
  end
  if up
    q_left = score_quant(y_left, toward)
    q_right = score_quant(y_right, toward)
  else
    q_left = score_quant(y_left - thick, toward) + thick
    q_right = score_quant(y_right - thick, toward) + thick
  end
  # Quanting each end on its own can open the slope past its limit: bring
  # the right end back within it, toward the left.
  if (q_right - q_left).abs > 1.5
    held = q_right > q_left ? q_left + 1.5 : q_left - 1.5
    back = q_right > q_left ? -1 : 1
    q_right = up ? score_quant(held, back) : score_quant(held - thick, back) + thick
  end
  # Quanting must not turn the slope round.
  turned = (q_right - q_left) * (y_right - y_left) < 0.0
  levelled = slope == 0.0 && q_right != q_left
  if turned || levelled
    q = up ? score_min(q_left, q_right) : score_max(q_left, q_right)
    q_left = q
    q_right = q
  end
  g["x0"] = x0
  g["x1"] = x1
  g["y0"] = q_left
  g["y1"] = q_right
  g["n"] = n_beams
  for ev in notes
    ev["stem_end"] = score_beam_y(g, score_stem_x(ev))
  end
end

def score_beam_y(g, x)
  span = g["x1"] - g["x0"]
  return g["y0"] if span <= 0.0

  g["y0"] + (g["y1"] - g["y0"]) * (x - g["x0"]) / span
end

def score_curve_height(width, limit, ratio)
  limit * 2.0 / 3.141592653589793 * score_atan(3.141592653589793 / 2.0 * ratio / limit * width)
end

def score_atan(v)
  return -score_atan(-v) if v < 0.0
  return 3.141592653589793 / 2.0 - score_atan(1.0 / v) if v > 1.0

  v2 = v * v
  v * (0.99997726 + v2 * (-0.33262347 + v2 * (0.19354346 + v2 * (-0.11643287 + v2 * (0.05265332 + v2 * -0.01172120)))))
end

def score_curves(parsed, systems)
  notes = []
  for sys, si in systems
    for bar in sys["bars"]
      for ev in bar["items"]
        if ev["k"] == "note"
          ev["sys"] = si
          notes.push(ev)
        end
      end
    end
  end
  for sys in systems
    sys["curves"] = []
  end
  # Ties: each head of a tied note to the same pitch in the next.
  for ev, i in notes
    next unless ev["tie"] == true

    nxt = nil
    jj = i + 1
    while jj < notes.length && nxt.nil?
      nxt = notes[jj] if score_voice_of(notes[jj]) == score_voice_of(ev)
      jj += 1
    end
    next if nxt.nil?

    count = ev["heads"].length
    for hd, hi in ev["heads"]
      other = nxt["heads"].find { |o| o["d"] == hd["d"] }
      next if other.nil?

      # Upper half of a chord over, lower half under; a single note away
      # from its stem.
      over = count == 1 ? !ev["up"] : hi >= count / 2
      # Two voices: the first's ties over, the second's under.
      over = ev["voice"] == 1 unless ev["voice"].nil?
      score_tie(systems, ev, hd, nxt, other, over)
    end
  end
  # Slurs: from the note that opens one to the note that closes it.
  # Each voice's slurs close on its own notes.
  open = {"1": [], "2": []}
  for ev in notes
    mine = open[str(score_voice_of(ev))]
    mine.push(ev) if ev["slur_on"] == true
    if ev["slur_off"] == true && mine.length > 0
      first = mine.pop()
      score_slur(systems, notes, first, ev)
    end
  end
end

def score_voice_of(ev)
  ev["voice"] == 2 ? 2 : 1
end

def score_tie(systems, ev, hd, nxt, other, over)
  dir = over ? -1.0 : 1.0
  y = score_y(hd["pos"]) + dir * 0.35
  y2 = score_y(other["pos"]) + dir * 0.35
  xa = ev["x"] + ev["head_w"] + 0.15
  xb = nxt["x"] - 0.15
  if ev["sys"] == nxt["sys"]
    score_arc(systems[ev["sys"]], xa, y, xb, y2, dir, 1.0, 0.333, SCORE_RULE["curve_tip"], SCORE_RULE["curve_mid"])
  else
    sys = systems[ev["sys"]]
    score_arc(sys, xa, y, sys["bar_end"] - 0.5, y, dir, 1.0, 0.333, SCORE_RULE["curve_tip"], SCORE_RULE["curve_mid"])
    later = systems[nxt["sys"]]
    score_arc(later, later["prefix"] - 0.6, y2, xb, y2, dir, 1.0, 0.333, SCORE_RULE["curve_tip"], SCORE_RULE["curve_mid"])
  end
end

def score_slur(systems, notes, first, last)
  ups = notes.filter { |ev| ev["n"] >= first["n"] && ev["n"] <= last["n"] && score_voice_of(ev) == score_voice_of(first) }
  all_up = ups.all? { |ev| ev["up"] }
  # On the heads' side when the stems agree, above when they do not; of
  # two voices, the first's above and the second's below.
  over = all_up ? false : true
  over = first["voice"] == 1 unless first["voice"].nil?
  dir = over ? -1.0 : 1.0
  ends = [first, last].map { |ev| score_slur_end(ev, over) }
  inner = ups.filter { |ev| ev["n"] != first["n"] && ev["n"] != last["n"] }
  if first["sys"] == last["sys"]
    score_slur_piece(systems[first["sys"]], inner, ends[0][0], ends[0][1], ends[1][0], ends[1][1], dir, over)
    return nil
  end
  # Across a line break, two pieces, each clear of the notes on its own
  # line: the first runs on to just before the bar line, the second starts
  # just after the clef and key, level with its own end.
  sys = systems[first["sys"]]
  score_slur_piece(sys, inner.filter { |ev| ev["sys"] == first["sys"] }, ends[0][0], ends[0][1], sys["bar_end"] - 0.5, ends[0][1], dir, over)
  later = systems[last["sys"]]
  score_slur_piece(later, inner.filter { |ev| ev["sys"] == last["sys"] }, later["prefix"] - 0.6, ends[1][1], ends[1][0], ends[1][1], dir, over)
end

def score_slur_piece(sys, inner, xa, ya, xb, yb, dir, over)
  width = xb - xa
  return nil if width <= 0.2

  # A slur leans as its notes do, but not as far: LilyPond holds its ends
  # near level and lets the curve do the climbing. The end away from the
  # slur's side is brought toward the other until the rise is at most an
  # eighth of the width.
  rise = yb - ya
  most = 0.125 * width
  if rise.abs > most
    if (rise > 0.0) == (dir < 0.0)
      yb = ya + (rise > 0.0 ? most : 0.0 - most)
    else
      ya = yb - (rise > 0.0 ? most : 0.0 - most)
    end
  end
  # When a note between stands in the way, LilyPond levels the ends first —
  # the lower one comes up to the other — and only then arches the curve:
  # a slur over a rising line is an even arc, not a ramp.
  blocked = false
  for ev in inner
    u = (ev["x"] + ev["head_w"] / 2.0 - xa) / width
    p = score_slur_end(ev, over)
    base = ya + (yb - ya) * u
    blocked = true if u > 0.0 && u < 1.0 && (base - p[1]) * -dir > 0.0
  end
  if blocked
    level = dir < 0.0 ? score_min(ya, yb) : score_max(ya, yb)
    ya = level
    yb = level
  end
  # Then the inner notes must clear: raise the curve, and past a point its
  # ends, until every head and stem tip between is outside it.
  hgt = score_curve_height(width, 2.0, 0.25)
  lift = 0.0
  for ev in inner
    u = (ev["x"] + ev["head_w"] / 2.0 - xa) / width
    next if u <= 0.0 || u >= 1.0

    p = score_slur_end(ev, over)
    base = ya + (yb - ya) * u
    need = (base - p[1]) * -dir
    bulge = 4.0 * u * (1.0 - u)
    if need > hgt * bulge
      want = need / bulge
      if want <= 3.0
        hgt = want
      else
        hgt = 3.0
        lift = score_max(lift, need - 3.0 * bulge)
      end
    end
  end
  ya += dir * lift
  yb += dir * lift
  score_arc_h(sys, xa, ya, xb, yb, dir, hgt, SCORE_RULE["curve_tip"], SCORE_RULE["curve_mid"])
end

def score_slur_end(ev, over)
  mid_x = ev["x"] + ev["head_w"] / 2.0
  if over
    top = score_y(ev["heads"][-1]["pos"]) - 0.75
    if ev["up"] && ev["base"] > 1
      return [score_stem_x(ev) - 0.06, ev["stem_end"] - 0.3]
    end

    return [mid_x, top]
  end
  low = score_y(ev["heads"][0]["pos"]) + 0.75
  if !ev["up"] && ev["base"] > 1
    return [score_stem_x(ev) + 0.06, ev["stem_end"] + 0.3]
  end

  [mid_x, low]
end

def score_arc(sys, xa, ya, xb, yb, dir, limit, ratio, tip, mid)
  hgt = score_curve_height(score_max(xb - xa, 0.1), limit, ratio)
  score_arc_h(sys, xa, ya, xb, yb, dir, hgt, tip, mid)
end

def score_arc_h(sys, xa, ya, xb, yb, dir, hgt, tip, mid)
  w = xb - xa
  return nil if w <= 0.0

  inset = w * 0.25
  c_out = (hgt + mid / 2.0) * 4.0 / 3.0
  c_in = (hgt - mid / 2.0) * 4.0 / 3.0
  t2 = tip / 2.0
  sys["curves"].push([0, xa, ya + dir * t2,
    3, xa + inset, ya + dir * c_out, xb - inset, yb + dir * c_out, xb, yb + dir * t2,
    1, xb, yb - dir * t2,
    3, xb - inset, yb + dir * c_in, xa + inset, ya + dir * c_in, xa, ya - dir * t2,
    4])
end

def score_r(v)
  float(v).round(2)
end

def score_rect(ink, x, y, w, ht, sp)
  [1, ink, score_r(x * sp), score_r(y * sp), score_r(score_max(w * sp, 1.0)), score_r(score_max(ht * sp, 1.0)), 0]
end

def score_fill(ink, cmds, ox, oy, sp)
  out = [5, ink]
  i = 0
  n = cmds.length
  while i < n
    c = cmds[i]
    out.push(c)
    args = [2, 2, 4, 6, 0][c]
    for jj in 0..args
      v = cmds[i + 1 + jj]
      out.push(score_r((jj % 2 == 0 ? ox + v : oy + v) * sp))
    end
    i += 1 + args
  end
  out
end

def score_draw_glyph(paths, ink, name, x, y, sp)
  paths.push(score_fill(ink, score_glyph(name)["fill"], x, y, sp))
end

def score_paths(engraved, sp, opts)
  ink = opts["colour"] ?? "text.default"
  marks = opts["marks"] ?? {}
  page = opts["page_index"] ?? 0
  # Drawn once in the plain ink, with where each item's paths are; the
  # items `marks` lights are copies of theirs in its colour.
  key = (engraved["memo_key"] ?? "") + "|" + str(sp) + "|" + ink + "|" + str(page)
  drawn = engraved.has_key("memo_key") ? score_memo_get("paths", key) : nil
  if drawn.nil?
    ranges = {}
    drawn = {"paths": score_paths_plain(engraved, sp, ink, page, ranges), "ranges": ranges}
    score_memo_put("paths", key, drawn, 16) if engraved.has_key("memo_key")
  end
  score_recolour(drawn, marks)
end

def score_midi(src, opts = {})
  return eui_score_midi(src, opts) if defined("eui_score_midi")

  parsed = score_parse(src)
  title = (parsed["header"] ?? {})["title"] ?? ""
  staves = parsed["staves"]
  tracks = []
  measured = staves.map { |stf| score_measures(stf["events"]) }
  holds = score_midi_holds(measured)
  for stf, si in staves
    props = stf["props"] ?? {}
    program = SCORE_MIDI_PROGRAMS[props["midiInstrument"] ?? ""] ?? (opts["program"] ?? 0)
    name = props["instrumentName"] ?? (si == 0 ? title : "")
    # One channel a staff; the tenth (9) is General MIDI's drums, skipped.
    channel = score_min(si < 9 ? si : si + 1, 15)
    track = score_midi_track(measured[si], opts.merge({"holds": holds}), program, name, channel, si == 0)
    # Its loudness and its place, as controllers 7 and 10 before anything
    # sounds: `midiMaximumVolume` 0–1, `midiPanPosition` -1 (left) to 1.
    controls = []
    controls = controls + [0, 176 + channel, 7, int(score_max(0.0, score_min(1.0, props["midiMaximumVolume"])) * 127.0 + 0.5)] unless props["midiMaximumVolume"].nil?
    controls = controls + [0, 176 + channel, 10, int(64.0 + score_max(-1.0, score_min(1.0, props["midiPanPosition"])) * 63.0 + 0.5)] unless props["midiPanPosition"].nil?
    tracks.push(controls + track)
  end
  quarter = score_whole() / 4
  out = [77, 84, 104, 100, 0, 0, 0, 6, 0, tracks.length > 1 ? 1 : 0] + score_midi_be(tracks.length, 2) + score_midi_be(quarter, 2)
  for track in tracks
    out = out + [77, 84, 114, 107] + score_midi_be(track.length, 4) + track
  end
  out
end

def score_midi_track(bars, opts, program, name, channel, first_track)
  ev_out = []
  ev_out.push([0, 0, [255, 3] + score_midi_vlq(score_midi_text(name).length) + score_midi_text(name)]) if name != ""
  ev_out.push([0, 0, [192 + channel, program]])
  bpm = opts["bpm"] ?? 0
  ev_out.push([0, 0, score_midi_tempo(bpm, opts["beat"] ?? 4)]) if bpm > 0 && first_track
  at = 0
  volume = 90
  hairpin = nil
  sounding = {}
  for bar, bi in bars
    if bi == 0 || bar["changes"]["time"] == true
      tn = bar["time"][0]
      td = bar["time"][1]
      ev_out.push([at, 0, [255, 88, 4, tn, score_midi_log2(td), 24, 8]])
    end
    if bi == 0 || bar["changes"]["key"] == true
      ev_out.push([at, 0, [255, 89, 2, score_mod(bar["fifths"], 256), 0]])
    end
    for ev in bar["items"]
      t0 = at + ev["start"]
      span = ev["ticks"] * (ev["mm"] ?? 1)
      mark = ev["tempo"]
      ev_out.push([t0, 0, score_midi_tempo(mark["bpm"], mark["base"])]) if !mark.nil? && mark["bpm"] > 0 && first_track
      unless ev["dyn"].nil?
        volume = SCORE_MIDI_VOLUMES[ev["dyn"]] ?? volume
        hairpin = nil
      end
      if !hairpin.nil? && hairpin["left"] > 0
        volume = score_max(8, score_min(127, volume + hairpin["step"]))
        hairpin["left"] = hairpin["left"] - 1
      end
      hairpin = score_midi_hairpin(bars, bi, ev, volume) unless ev["hairpin"].nil?
      hairpin = nil if ev["hairpin_end"] == true
      next if ev["k"] != "note"

      names = (ev["scripts"] ?? []).map { |sc| sc["name"] }
      vel = volume + (names.includes?("accent") ? 20 : 0) + (names.includes?("marcato") ? 30 : 0)
      vel = int(score_max(1.0, score_min(127.0, vel + 0.5)))
      length = span
      length = span / 2 if names.includes?("staccato")
      length = span / 8 if names.includes?("staccatissimo")
      length = span * 3 / 4 if names.includes?("portato")
      for hd in ev["heads"]
        key = score_midi_key(hd["d"], hd["alter"])
        held = sounding[str(key)]
        # A tie carries the sounding note on: no new attack, a later end.
        if !held.nil? && held["until"] == t0 && held["tied"]
          held["until"] = t0 + length
          held["tied"] = ev["tie"] == true
          held["off"][0] = t0 + length
          next
        end
        off = [t0 + length, 0, [128 + channel, key, 64]]
        ev_out.push([t0, 1, [144 + channel, key, vel]])
        ev_out.push(off)
        sounding[str(key)] = {"until": t0 + length, "tied": ev["tie"] == true, "off": off}
      end
    end
    at += bar["length"] * (bar["span"] ?? 1)
  end
  # A fermata holds: every time from where a held note ends on is later by
  # what it was held for, on every staff alike.
  holds = opts["holds"] ?? []
  if holds.length > 0
    ev_out = ev_out.map { |e| [score_midi_held(holds, e[0]), e[1], e[2]] }
  end
  # In time order; at one time, a note's end before the next one's start.
  ev_out = ev_out.sort_by { |e| e[0] * 4 + e[1] }
  track = []
  last = 0
  for e in ev_out
    track = track + score_midi_vlq(e[0] - last) + e[2]
    last = e[0]
  end
  track + [0, 255, 47, 0]
end

def score_midi_holds(measured)
  by_end = {}
  for bars in measured
    at = 0
    for bar in bars
      for ev in bar["items"]
        names = (ev["scripts"] ?? []).map { |sc| sc["name"] }
        if ev["k"] == "note" && names.includes?("fermata")
          span = ev["ticks"] * (ev["mm"] ?? 1)
          ends = str(at + ev["start"] + span)
          by_end[ends] = score_max(by_end[ends] ?? 0, span)
        end
      end
      at += bar["length"] * (bar["span"] ?? 1)
    end
  end
  by_end.keys.map { |k| [int(k), by_end[k]] }.sort_by { |h| h[0] }
end

def score_midi_held(holds, t)
  out = t
  for h in holds
    out += h[1] if h[0] <= t
  end
  out
end

def score_midi_hairpin(bars, bi, start_ev, volume)
  notes = 0
  target = nil
  started = false
  done = false
  for k in range(bi, bars.length)
    for ev in bars[k]["items"]
      next if done

      if !started
        started = ev["i"] == start_ev["i"]
        next
      end
      notes += 1
      target = SCORE_MIDI_VOLUMES[ev["dyn"]] unless ev["dyn"].nil?
      done = !ev["dyn"].nil? || ev["hairpin_end"] == true || !ev["hairpin"].nil?
    end
    break if done
  end
  target = volume + (start_ev["hairpin"] == "<" ? 16 : -16) if target.nil?
  {"left": score_max(notes, 1), "step": (target - volume) / float(score_max(notes, 1))}
end

def score_midi_key(d, alter)
  step = score_mod(d, 7)
  12 * ((d - step) / 7 + 4) + [0, 2, 4, 5, 7, 9, 11][step] + alter
end

def score_midi_tempo(bpm, beat)
  us = int(60000000.0 / bpm * beat / 4.0)
  [255, 81, 3] + score_midi_be(us, 3)
end

def score_midi_log2(v)
  out = 0
  while v > 1
    v = v / 2
    out += 1
  end
  out
end

def score_midi_vlq(v)
  out = [v % 128]
  v = v / 128
  while v > 0
    out = [v % 128 + 128] + out
    v = v / 128
  end
  out
end

def score_midi_be(v, size)
  range(0, size).map { |k| (v / [1, 256, 65536, 16777216][size - 1 - k]) % 256 }
end

def score_midi_text(words)
  words.bytes()
end

def score_pdf(src, opts = {})
  return eui_score_pdf(src, opts["title"] ?? "") if defined("eui_score_pdf")

  paper = score_a4()
  line_w = paper["w"] - paper["left"] - paper["right"]
  engraved = score_engrave_page(src, line_w, {"page_h": paper["h"], "top": paper["top"], "bottom": paper["bottom"], "left": paper["left"], "indent": paper["indent"], "gap": 12.0})
  sp = 5.0
  page_w = paper["w"] * sp
  page_h = paper["h"] * sp
  bodies = []
  bodies.push("<< /Type /Catalog /Pages 2 0 R >>")
  count = engraved["pages"].length
  kids = range(0, count).map { |k| str(4 + 2 * k) + " 0 R" }.join(" ")
  bodies.push("<< /Type /Pages /Kids [" + kids + "] /Count " + str(count) + " >>")
  title = (score_parse(src)["header"] ?? {})["title"] ?? (opts["title"] ?? "")
  bodies.push("<< /Title " + score_pdf_text(title) + " /Producer (EUI score) >>")
  for pg in engraved["pages"]
    k = pg["index"]
    foot = score_foot_paths(engraved, sp, k, count, title, paper["h"] - paper["foot"])
    data = "0 g\n" + score_pdf_page(score_print_paths(engraved, sp, k), page_h) + "\n0.4 g\n" + score_pdf_page(foot, page_h)
    bodies.push("<< /Type /Page /Parent 2 0 R /MediaBox [0 0 " + score_pdf_num(page_w) + " " + score_pdf_num(page_h) + "] /Contents " + str(5 + 2 * k) + " 0 R /Resources << >> >>")
    bodies.push("<< /Length " + str(data.length) + " >>\nstream\n" + data + "\nendstream")
  end
  out = ["%PDF-1.4\n"]
  at = out[0].length
  offsets = []
  for body, k in bodies
    obj = str(k + 1) + " 0 obj\n" + body + "\nendobj\n"
    offsets.push(at)
    out.push(obj)
    at += obj.length
  end
  xref = ["xref\n0 " + str(bodies.length + 1) + "\n0000000000 65535 f \n"] + offsets.map { |off| str(off).rjust(10, "0") + " 00000 n \n" }
  out = out + xref
  out.push("trailer\n<< /Size " + str(bodies.length + 1) + " /Root 1 0 R /Info 3 0 R >>\nstartxref\n" + str(at) + "\n%%EOF\n")
  out.join("")
end

def score_pdf_page(paths, page_h)
  ops = []
  for pa in paths
    if pa[0] == 1
      ops.push(score_pdf_num(pa[2]) + " " + score_pdf_num(page_h - pa[3] - pa[5]) + " " + score_pdf_num(pa[4]) + " " + score_pdf_num(pa[5]) + " re f")
      next
    end
    next unless pa[0] == 5

    cx = 0.0
    cy = 0.0
    sx = 0.0
    sy = 0.0
    k = 2
    while k < pa.length
      c = pa[k]
      if c == 0 || c == 1
        cx = pa[k + 1]
        cy = pa[k + 2]
        if c == 0
          sx = cx
          sy = cy
        end
        ops.push(score_pdf_num(cx) + " " + score_pdf_num(page_h - cy) + (c == 0 ? " m" : " l"))
        k += 3
      elsif c == 2
        qx = pa[k + 1]
        qy = pa[k + 2]
        ex = pa[k + 3]
        ey = pa[k + 4]
        pts = [cx + (qx - cx) * 2.0 / 3.0, cy + (qy - cy) * 2.0 / 3.0, ex + (qx - ex) * 2.0 / 3.0, ey + (qy - ey) * 2.0 / 3.0, ex, ey]
        ops.push(range(0, 3).map { |j| score_pdf_num(pts[2 * j]) + " " + score_pdf_num(page_h - pts[2 * j + 1]) }.join(" ") + " c")
        cx = ex
        cy = ey
        k += 5
      elsif c == 3
        ops.push(range(0, 3).map { |j| score_pdf_num(pa[k + 1 + 2 * j]) + " " + score_pdf_num(page_h - pa[k + 2 + 2 * j]) }.join(" ") + " c")
        cx = pa[k + 5]
        cy = pa[k + 6]
        k += 7
      else
        ops.push("h")
        cx = sx
        cy = sy
        k += 1
      end
    end
    ops.push("f")
  end
  ops.join("\n")
end

def score_pdf_num(v)
  r = Math.floor(v * 100.0 + 0.5) / 100.0
  r == Math.floor(r) ? str(int(r)) : str(r)
end

def score_pdf_text(words)
  b = words.bytes()
  units = []
  k = 0
  while k < b.length
    c = b[k]
    cp = c
    n = 1
    if c >= 240
      cp = (c % 8) * 262144 + (b[k + 1] % 64) * 4096 + (b[k + 2] % 64) * 64 + b[k + 3] % 64
      n = 4
    elsif c >= 224
      cp = (c % 16) * 4096 + (b[k + 1] % 64) * 64 + b[k + 2] % 64
      n = 3
    elsif c >= 192
      cp = (c % 32) * 64 + b[k + 1] % 64
      n = 2
    end
    if cp >= 65536
      cp -= 65536
      units.push(55296 + cp / 1024)
      units.push(56320 + cp % 1024)
    else
      units.push(cp)
    end
    k += n
  end
  "<FEFF" + units.map { |u| score_pdf_hex4(u) }.join("") + ">"
end

def score_pdf_hex4(u)
  digits = "0123456789ABCDEF"
  range(0, 4).map { |j| digits.chars()[(u / [4096, 256, 16, 1][j]) % 16] }.join("")
end

def score_bands(engraved, sp, opts, total)
  return eui_score_bands(engraved, sp, opts, total) if engraved["native"] == true

  ink = opts["colour"] ?? "text.default"
  marks = opts["marks"] ?? {}
  page = opts["page_index"] ?? 0
  systems = engraved["systems"].filter { |sys| (sys["page"] ?? 0) == page }
  bands = []
  starts = []
  for sys in systems
    pad = int(Math.ceil(-sys["reach_hi"] * sp)) + 2
    starts.push([sys, pad, int(Math.floor(sys["top"] * sp + 0.5)) - pad])
  end
  first_y = starts.length > 0 ? score_max(starts[0][2], 0) : total
  head_key = str(sp) + "|" + ink + "|" + str(page) + "|" + str(engraved["left"]) + "|" + str(engraved["width"]) + "|" + str(engraved["paper"]) + "|" + str(engraved["numbered"]) + "|" + score_sig_value(engraved["header"])
  head = score_memo_get("heads", head_key)
  head = score_memo_put("heads", head_key, {"paths": score_paths_head(engraved, sp, ink, page), "ranges": {}}, 16) if head.nil?
  bands.push({"y": 0, "h": first_y, "drawn": head, "items": []})
  for st, k in starts
    y = k == 0 ? first_y : score_max(st[2], bands[-1]["y"])
    bands[-1]["h"] = y - bands[-1]["y"]
    bands.push({"y": y, "h": 0, "drawn": score_band_drawn(st[0], st[1], sp, ink), "items": score_band_items(st[0])})
  end
  bands[-1]["h"] = score_max(total - bands[-1]["y"], 0)
  bands.map { |bd| {"y": bd["y"], "h": bd["h"], "paths": bd["drawn"]["paths"], "lit": score_band_lit(bd, marks)} }
end

def score_band_items(sys)
  return sys["staves"].map { |ss| score_band_items(ss) }.reduce(fn(acc, items) acc + items, []) if sys.has_key("staves")

  out = []
  for bar in sys["bars"]
    for ev in bar["items"]
      out.push(str(ev["i"]))
    end
  end
  out
end

def score_band_lit(bd, marks)
  drawn = bd["drawn"]
  out = []
  for item, k in bd["items"]
    next unless marks.has_key(item)

    span = drawn["ranges"][str(k)]
    next if span.nil?

    for j in range(span[0], span[1])
      lit = drawn["paths"][j].map { |v| v }
      lit[1] = marks[item]
      out.push(lit)
    end
  end
  out
end

def score_band_drawn(sys, pad, sp, ink)
  key = str(sp) + "|" + ink + "|" + str(pad) + "|" + score_sys_sig(sys)
  hit = score_memo_get("bands", key)
  return hit unless hit.nil?

  paths = []
  by_item = {}
  score_draw_system(paths, sys.merge({"top": pad / float(sp)}), sp, ink, by_item)
  # The ranges by an item's place in the system, not its number: the same
  # system later in a longer piece has the same places and other numbers.
  ranges = {}
  for item, k in score_band_items(sys)
    ranges[str(k)] = by_item[item]
  end
  score_memo_put("bands", key, {"paths": paths, "ranges": ranges}, 96)
end

def score_sys_sig(sys)
  if sys.has_key("staves")
    parts = sys["staves"].map { |ss| score_sys_sig(ss) }
    return parts.join("\n#") + "|" + score_sig_value({"offsets": sys["offsets"], "groups": sys["groups"], "names": sys["names"], "left": sys["left"], "first": sys["first_line"]})
  end
  bits = []
  for key in sys.keys
    next if ["bars", "top", "bottom", "reach_hi", "page", "staves"].includes?(key)

    bits.push(key + "=" + score_sig_value(sys[key]))
  end
  for bar in sys["bars"]
    bar_bits = []
    for key in bar.keys
      next if key == "items"

      bar_bits.push(key + "=" + score_sig_value(bar[key]))
    end
    bits.push("|" + bar_bits.join(";"))
    for ev in bar["items"]
      bits.push("." + score_sig_item(ev))
    end
  end
  bits.join("")
end

def score_sig_item(ev)
  bits = []
  for key in ev.keys
    next if ["at", "i", "n", "bar", "tuplet", "beam", "pitches", "tempo"].includes?(key)

    bits.push(key + "=" + score_sig_value(ev[key]))
  end
  g = ev["beam"]
  unless g.nil?
    bits.push("beam=" + score_sig_value({"x0": g["x0"], "x1": g["x1"], "y0": g["y0"], "y1": g["y1"], "n": g["n"], "up": g["up"], "lead": g["notes"][0]["i"] == ev["i"]}))
  end
  bits.join(";")
end

def score_sig_value(v)
  return "-" if v.nil?
  if v.is_a?("hash")
    return "{" + v.keys.filter { |key| key != "notes" && key != "bars" && key != "staff_bars" && key != "members" }.map { |key| key + ":" + score_sig_value(v[key]) }.join(",") + "}"
  end
  return "[" + v.map { |x| score_sig_value(x) }.join(",") + "]" if v.is_a?("array")

  str(v)
end

def score_recolour(drawn, marks)
  return drawn["paths"] if marks.keys.length == 0

  out = drawn["paths"].map { |pa| pa }
  for item in marks.keys
    span = drawn["ranges"][item]
    next if span.nil?

    for k in range(span[0], span[1])
      lit = out[k].map { |v| v }
      lit[1] = marks[item]
      out[k] = lit
    end
  end
  out
end

def score_paths_plain(engraved, sp, ink, page, ranges)
  paths = score_paths_head(engraved, sp, ink, page)
  for sys in engraved["systems"]
    score_draw_system(paths, sys, sp, ink, ranges) if (sys["page"] ?? 0) == page
  end
  paths
end

def score_numbered(layout)
  !layout["page_h"].nil? && !layout["top"].nil?
end

def score_paths_head(engraved, sp, ink, page)
  paths = []
  left = engraved["left"] ?? 0.0
  score_draw_titles(paths, engraved, sp, ink, page)
  if page > 0 && engraved["numbered"] == true
    # LilyPond's page numbers: from the second page, at the top, on the
    # outside edge — right on odd pages, left on even ones.
    number = str(page + 1)
    em = score_em(0.0)
    nx = (page + 1) % 2 == 1 ? left + engraved["width"] - score_text_width(number, "regular", em) : left
    score_draw_text(paths, ink, number, "regular", nx, 2.83 + 0.72 * em, em, sp)
  end
  paths
end

def score_draw_titles(paths, engraved, sp, ink, page)
  return nil if page != 0

  left = engraved["left"] ?? 0.0
  margin = engraved["pages"].length > 0 && !engraved["paper"].nil? ? 2.83 : 1.0
  for line in engraved["header"]["lines"]
    for cell in line["cells"]
      score_draw_text(paths, ink, cell["text"], cell["weight"], left + cell["x"], margin + line["y"], cell["em"], sp)
    end
  end
  nil
end

def score_print_paths(engraved, sp, page)
  paths = []
  score_draw_titles(paths, engraved, sp, "text.default", page)
  for sys in engraved["systems"]
    score_draw_system(paths, sys, sp, "text.default", {}) if (sys["page"] ?? 0) == page
  end
  paths
end

def score_foot_paths(engraved, sp, page, count, title, y)
  paths = []
  left = engraved["left"] ?? 0.0
  em = score_em(-2.0)
  number = str(page + 1) + " / " + str(count)
  number_w = score_text_width(number, "regular", em)
  score_draw_text(paths, "text.default", number, "regular", left + engraved["width"] - number_w, y, em, sp)
  room = engraved["width"] - number_w - em
  words = title
  if score_text_width(words, "regular", em) > room
    kept = title.chars()
    done = false
    while !done
      kept = kept.length > 0 ? kept.take(kept.length - 1) : kept
      words = kept.join("") + "…"
      done = kept.length == 0 || score_text_width(words, "regular", em) <= room
    end
  end
  score_draw_text(paths, "text.default", words, "regular", left, y, em, sp)
  paths
end

def score_band_column(engraved, sp, opts, width, total)
  bands = score_bands(engraved, sp, opts, total)
  # A plain box, not `column()`: the bands stack with no gap and nothing else.
  {"k": "box", "s": {"display": "column", "width": width}, "c": bands.filter { |bd| bd["h"] > 0 }.map { |bd|
    {"k": "box", "s": {"display": "stack", "width": width, "height": bd["h"]}, "c": [canvas(width, bd["h"], bd["paths"]), canvas(width, bd["h"], bd["lit"] ?? [])]}
  }}
end

def score_draw_tempo(paths, ink, mk, top, sp)
  mark = mk["mark"]
  em = score_em(0.0)
  y = top + mk["y"]
  x = mk["x"]
  if mark["text"] != ""
    x = score_draw_text(paths, ink, mark["text"], "bold", x, y, em, sp)
    x += 0.6 if mark["bpm"] > 0
  end
  return nil if mark["bpm"] == 0

  x = score_draw_text(paths, ink, "(", "regular", x, y, em, sp) + 0.25
  k = 0.72
  head_name = score_head_name(mark["base"])
  head = score_glyph(head_name)
  hy = y - 0.35
  paths.push(score_fill_k(ink, head["fill"], x, hy, k, sp))
  if mark["base"] > 1
    sx = x + (head["advance"] - SCORE_RULE["stem"]) * k
    tip = hy - 3.0 * k
    paths.push(score_rect(ink, sx, tip, SCORE_RULE["stem"] * k, hy - 0.12 - tip, sp))
    if mark["base"] >= 8
      flag = score_glyph(score_flag_name(mark["base"], true))
      paths.push(score_fill_k(ink, flag["fill"], sx - flag["anchors"]["stemUpNW"][0] * k, tip, k, sp))
    end
  end
  x += head["advance"] * k + 0.7
  x += score_glyph(score_flag_name(mark["base"], true))["advance"] * k * 0.8 if mark["base"] >= 8
  score_draw_text(paths, ink, "= " + str(mark["bpm"]) + ")", "regular", x, y, em, sp)
end

def score_draw_system(paths, sys, sp, ink, ranges)
  if sys.has_key("staves")
    for ss, s in sys["staves"]
      score_draw_system(paths, ss.merge({"top": sys["top"] + sys["offsets"][s]}), sp, ink, ranges)
    end
    score_draw_groups(paths, sys, sp, ink)
    return nil
  end
  top = sys["top"]
  right = sys["right"]
  left = sys["left"] ?? 0.0
  for i in 0..5
    paths.push(score_rect(ink, left, top + i - SCORE_RULE["staff"] / 2.0, right - left, SCORE_RULE["staff"], sp))
  end
  bars = sys["bars"]
  first = bars[0]
  # LilyPond numbers the bar each system after the first opens with, small,
  # over the clef, its right edge a fifth of a space short of the staff.
  # Over the top staff only; where a brace or a bracket stands left of the
  # staves, over the clef instead, as LilyPond moves it.
  if first["number"] > 1 && (sys["staff_index"] ?? 0) == 0
    em = score_em(-2.0)
    number = str(first["number"])
    number_x = sys.has_key("staff_index") ? left : left - score_text_width(number, "regular", em) - 0.2
    score_draw_text(paths, ink, number, "regular", number_x, top - 1.6, em, sp)
  end
  # The opening: clef, key, time.
  x = left + 0.8
  clef = score_clef_glyph(first["clef"])
  score_draw_glyph(paths, ink, clef, x, top + score_clef_y(first["clef"]), sp)
  x += (sys["clef_w"] ?? score_glyph(clef)["advance"]) + 1.0
  if sys.has_key("key_w")
    score_draw_key(paths, ink, first["fifths"], first["clef"], x, top, sp, false) if first["fifths"] != 0
    x += sys["key_w"] + 0.8 if sys["key_w"] > 0.0
  elsif first["fifths"] != 0
    x = score_draw_key(paths, ink, first["fifths"], first["clef"], x, top, sp, false) + 0.8
  end
  if first["first"] == true || first["changes"]["time"] == true
    score_draw_time(paths, ink, first["time"], x, top, sp)
  end
  for bar, bi in bars
    if bi > 0
      score_draw_changes(paths, ink, bar, top, sp)
    end
    for ev in bar["items"]
      from_k = paths.length
      if ev["k"] == "rest"
        score_draw_rest(paths, ink, ev, top, sp)
      else
        score_draw_note(paths, ink, ev, top, sp)
      end
      ranges[str(ev["i"])] = [from_k, paths.length]
    end
    for ev in bar["items"]
      g = ev["beam"]
      score_draw_beam(paths, ink, g, top, sp) if !g.nil? && g["notes"][0]["n"] == ev["n"]
    end
    # A bar's line fills the room left for it after its last note, so it
    # ends exactly where the bar does — and on the last bar of a line,
    # where the staff does.
    drawn_kind = bar["bar_drawn"] ?? bar["bar"]
    score_draw_bar(paths, ink, drawn_kind, bar["x1"] + score_barline_width(drawn_kind), top, sp, sys["connect_down"] ?? 0.0)
    score_draw_bar(paths, ink, ".|:", bar["open_repeat_x"], top, sp) if bi == 0 && !bar["open_repeat_x"].nil?
  end
  for c in sys["curves"]
    paths.push(score_fill(ink, c, 0.0, top, sp))
  end
  for mk in sys["marks"] ?? []
    score_draw_tempo(paths, ink, mk, top, sp)
  end
  for vb in sys["voltas"] ?? []
    score_draw_volta(paths, ink, vb, top, sp)
  end
  for tp in sys["tuplets"] ?? []
    score_draw_tuplet(paths, ink, tp, top, sp)
  end
  for sc in sys["scripts"] ?? []
    score_draw_glyph(paths, ink, sc["glyph"], sc["x"], top + sc["y"], sp)
  end
  for dy in sys["dynamics"] ?? []
    score_draw_dynamic(paths, ink, dy, top, sp)
  end
  for tx in sys["texts"] ?? []
    score_draw_text(paths, ink, tx["text"], "regular", tx["x0"], top + tx["y"], score_em(0.0), sp)
  end
  score_draw_lyrics(paths, ink, sys, top, sp) if sys.has_key("lyric_y")
  score_draw_courtesy(paths, ink, sys, top, sp) if (sys["courtesy"] ?? 0.0) > 0.0
end

def score_draw_tuplet(paths, ink, tp, top, sp)
  em = score_em(-2.0)
  w = score_text_width(tp["label"], "italic", em)
  h = score_digit_height(em)
  xm = (tp["x0"] + tp["x1"]) / 2.0
  span = score_max(tp["x1"] - tp["x0"], 0.01)
  slope = (tp["yb"] - tp["ya"]) / span
  ym = tp["ya"] + slope * (xm - tp["x0"])
  score_draw_text(paths, ink, tp["label"], "italic", xm - w / 2.0, top + ym + h / 2.0, em, sp)
  return nil unless tp["bracket"]

  half = 0.08
  gap = w / 2.0 + 0.35
  for seg in [ [tp["x0"], xm - gap], [xm + gap, tp["x1"]] ]
    ya = tp["ya"] + slope * (seg[0] - tp["x0"])
    yb = tp["ya"] + slope * (seg[1] - tp["x0"])
    paths.push(score_fill(ink, [0, seg[0], ya - half, 1, seg[1], yb - half, 1, seg[1], yb + half, 1, seg[0], ya + half, 4], 0.0, top, sp))
  end
  hook = 0.7
  for end_at in [ [tp["x0"], tp["ya"]], [tp["x1"] - 2.0 * half, tp["yb"]] ]
    y0 = tp["up"] ? end_at[1] - half : end_at[1] - hook
    paths.push(score_rect(ink, end_at[0], top + y0, 2.0 * half, hook + half, sp))
  end
end

def score_draw_dynamic(paths, ink, dy, top, sp)
  if dy["kind"] == "dyn"
    x = dy["x0"]
    for name in score_dyn_letters(dy["text"])
      score_draw_glyph(paths, ink, name, x, top + dy["y"] + 0.6, sp)
      x += score_glyph(name)["advance"]
    end
    return nil
  end
  h = 0.6666
  open_a = dy["grow"] == "<" ? dy["from"] : 1.0 - dy["from"]
  open_b = dy["grow"] == "<" ? dy["to"] : 1.0 - dy["to"]
  half = 0.05
  for side in [-1.0, 1.0]
    ya = dy["y"] + side * h * open_a
    yb = dy["y"] + side * h * open_b
    paths.push(score_fill(ink, [0, dy["x0"], ya - half, 1, dy["x1"], yb - half, 1, dy["x1"], yb + half, 1, dy["x0"], ya + half, 4], 0.0, top, sp))
  end
end

def score_digit_height(em)
  rise = 0
  for ch in "0123456789".chars()
    cmds = score_letters()["italic"][ch]["f"]
    ci = 0
    while ci < cmds.length
      args = [2, 2, 4, 6, 0][cmds[ci]]
      jj = 1
      while jj < args
        rise = score_min(rise, cmds[ci + 1 + jj])
        jj += 2
      end
      ci += 1 + args
    end
  end
  -rise * em / 1000.0
end

def score_draw_groups(paths, sys, sp, ink)
  top = sys["top"]
  offsets = sys["offsets"]
  left = sys["left"]
  last = offsets.length - 1
  if offsets.length > 1
    paths.push(score_rect(ink, left - 0.08, top - 0.05, 0.16, offsets[last] + 4.1, sp))
  end
  edge = left - 0.3
  deepest = 0
  for g in sys["groups"]
    deepest = score_max(deepest, g["depth"])
  end
  for g in sys["groups"]
    next if g["kind"] == "none"

    y0 = top + offsets[g["first"]]
    y1 = top + offsets[g["last"]] + 4.0
    x = left - 0.3 - (deepest - g["depth"]) * 1.6
    if g["kind"] == "brace"
      score_draw_brace(paths, ink, x, y0, y1, sp)
      edge = score_min(edge, x - 1.3)
    else
      bx = x - 0.5
      paths.push(score_rect(ink, bx, y0, 0.45, y1 - y0, sp))
      score_draw_glyph(paths, ink, "bracketTop", bx, y0, sp)
      score_draw_glyph(paths, ink, "bracketBottom", bx, y1, sp)
      edge = score_min(edge, bx - 0.3)
    end
  end
  em = score_em(0.0)
  for name, s in sys["names"]
    next if name == ""

    in_group = sys["groups"].any? { |g| g["first"] <= s && s <= g["last"] && g["kind"] != "none" && g["first"] < g["last"] && (sys["first_line"] ? g["name"] : g["short"]) != "" }
    next if in_group

    score_draw_name(paths, ink, name, edge, top + offsets[s] + 2.0, em, sp)
  end
  for g in sys["groups"]
    label = sys["first_line"] ? g["name"] : g["short"]
    next if label == ""

    score_draw_name(paths, ink, label, edge, top + (offsets[g["first"]] + offsets[g["last"]] + 4.0) / 2.0, em, sp)
  end
end

def score_draw_name(paths, ink, name, right, middle, em, sp)
  box = score_text_box(name, "regular", em)
  score_draw_text(paths, ink, name, "regular", right - 0.6 - score_text_width(name, "regular", em), middle - (box[0] + box[1]) / 2.0, em, sp)
end

def score_draw_brace(paths, ink, x, y0, y1, sp)
  want = y1 - y0
  best = nil
  for n in range(10, 46)
    g = score_glyph("brace" + str(n * 10))
    next if g.nil?

    h = g["bbox"][3] - g["bbox"][1]
    best = g if best.nil? || (h - want).abs < (best["bbox"][3] - best["bbox"][1] - want).abs
  end
  return nil if best.nil?

  scale = want / (best["bbox"][3] - best["bbox"][1])
  mid = (y0 + y1) / 2.0
  cmds = best["fill"]
  out = []
  ci = 0
  while ci < cmds.length
    c = cmds[ci]
    out.push(c)
    args = [2, 2, 4, 6, 0][c]
    for jj in 0..args
      v = cmds[ci + 1 + jj]
      out.push(jj % 2 == 0 ? v - best["bbox"][2] : v * scale)
    end
    ci += 1 + args
  end
  paths.push(score_fill(ink, out, x, mid, sp))
end

def score_draw_volta(paths, ink, vb, top, sp)
  line = 0.16
  y = top + vb["y"]
  x0 = vb["x0"] + 0.3
  x1 = vb["x1"] - 0.3
  paths.push(score_rect(ink, x0, y - line / 2.0, x1 - x0, line, sp))
  if vb["first"]
    paths.push(score_rect(ink, x0, y - line / 2.0, line, 1.8, sp))
    score_draw_text(paths, ink, vb["label"], "bold", x0 + 0.5, y + 1.5, score_em(-2.0), sp)
  end
  paths.push(score_rect(ink, x1 - line, y - line / 2.0, line, 1.8, sp)) if vb["closed"]
end

def score_draw_courtesy(paths, ink, sys, top, sp)
  bar = sys["courtesy_bar"]
  ch = bar["changes"]
  x = sys["bar_end"] + 0.6
  if ch["key"] == true
    skip = score_key_cancel(ch["key_from"], bar["fifths"])
    x = score_draw_key_from(paths, ink, ch["key_from"], bar["clef"], x, top, sp, true, skip) + 0.5 if skip >= 0
    x = score_draw_key(paths, ink, bar["fifths"], bar["clef"], x, top, sp, false) + 0.5 if bar["fifths"] != 0
  end
  score_draw_time(paths, ink, bar["time"], x, top, sp) if ch["time"] == true
end

def score_clef_y(clef)
  {"treble": 3.0, "bass": 1.0, "alto": 2.0}[clef]
end

def score_key_cancel(old_key, new_key)
  return -1 if old_key == 0
  return 0 if new_key == 0 || (old_key > 0) != (new_key > 0)

  had = score_max(old_key, 0 - old_key)
  has = score_max(new_key, 0 - new_key)
  has < had ? has : -1
end

def score_draw_key(paths, ink, fifths, clef, x, top, sp, cancel)
  score_draw_key_from(paths, ink, fifths, clef, x, top, sp, cancel, 0)
end

def score_draw_key_from(paths, ink, fifths, clef, x, top, sp, cancel, skip)
  sharps = [4, 1, 5, 2, -1, 3, 0]
  flats = [0, 3, -1, 2, -2, 1, -3]
  shift = {"treble": 0, "bass": -2, "alto": -1}[clef]
  name = cancel ? "accidentalNatural" : (fifths > 0 ? "accidentalSharp" : "accidentalFlat")
  g = score_glyph(name)
  n = score_max(fifths, -fifths)
  for i in skip..n
    pos = (fifths > 0 ? sharps[i] : flats[i]) + shift
    score_draw_glyph(paths, ink, name, x, top + score_y(pos), sp)
    x += g["advance"] + 0.1
  end
  x
end

def score_draw_time(paths, ink, time, x, top, sp)
  one = score_time_glyphs(time)
  unless one.nil?
    score_draw_glyph(paths, ink, one[0], x, top + 2.0, sp)
    return nil
  end
  wide = score_time_width(time)
  for part, pi in [time[0], time[1]]
    names = score_digits(part)
    w = names.reduce(fn(acc, nm) acc + score_glyph(nm)["advance"], 0.0)
    cx = x + (wide - w) / 2.0
    for nm in names
      score_draw_glyph(paths, ink, nm, cx, top + (pi == 0 ? 1.0 : 3.0), sp)
      cx += score_glyph(nm)["advance"]
    end
  end
end

def score_draw_changes(paths, ink, bar, top, sp)
  ch = bar["changes"]
  x = bar["x0"] + 0.6
  if ch["clef"] == true
    clef = score_clef_glyph(bar["clef"])
    score_draw_glyph(paths, ink, clef, x, top + score_clef_y(bar["clef"]), sp)
    x += score_glyph(clef)["advance"] + 0.8
  end
  if ch["key"] == true
    skip = score_key_cancel(ch["key_from"], bar["fifths"])
    x = score_draw_key_from(paths, ink, ch["key_from"], bar["clef"], x, top, sp, true, skip) + 0.5 if skip >= 0
    x = score_draw_key(paths, ink, bar["fifths"], bar["clef"], x, top, sp, false) + 0.8 if bar["fifths"] != 0
  end
  score_draw_time(paths, ink, bar["time"], x, top, sp) if ch["time"] == true
end

def score_draw_bar(paths, ink, kind, x, top, sp, down = 0.0)
  bar_top = top - SCORE_RULE["staff"] / 2.0
  # `down`: on to the next staff, where a group's bar lines run through.
  bar_h = 4.0 + SCORE_RULE["staff"] + down
  at = x - score_barline_width(kind)
  for part in score_barline_parts(kind)
    if part == "dots"
      dot = score_glyph("augmentationDot")
      score_draw_glyph(paths, ink, "augmentationDot", at, top + 1.5, sp)
      score_draw_glyph(paths, ink, "augmentationDot", at, top + 2.5, sp)
      at += dot["advance"]
    else
      w = SCORE_RULE[part]
      paths.push(score_rect(ink, at, bar_top, w, bar_h, sp))
      at += w
    end
    at += SCORE_RULE["kern"]
  end
end

def score_church_width(count)
  left_bars = count
  w = 0.0
  parts = 0
  while left_bars > 0
    if left_bars >= 4
      w += 0.5
      left_bars -= 4
    elsif left_bars >= 2
      w += 0.5
      left_bars -= 2
    else
      w += score_glyph("restWhole")["advance"]
      left_bars -= 1
    end
    parts += 1
  end
  w + 0.6 * (parts - 1)
end

def score_draw_rest(paths, ink, ev, top, sp)
  if !ev["mm"].nil?
    # LilyPond's multi-measure rest. Up to ten bars, church rests: a longa
    # rest (two spaces tall, from the second line to the fourth) for each
    # four bars, a breve rest (one space, hung from the fourth line) for two,
    # a whole rest for one. Past ten, a thick bar on the middle line with a
    # serif at each end. The count over the staff, in the metre's digits.
    x0 = ev["span0"] + 1.0
    x1 = ev["span1"] - 1.0
    if ev["mm"] <= 10
      cx = (x0 + x1) / 2.0 - score_church_width(ev["mm"]) / 2.0
      left_bars = ev["mm"]
      while left_bars > 0
        if left_bars >= 4
          paths.push(score_rect(ink, cx, top + 1.0, 0.5, 2.0, sp))
          left_bars -= 4
          cx += 0.5 + 0.6
        elsif left_bars >= 2
          paths.push(score_rect(ink, cx, top + 1.0, 0.5, 1.0, sp))
          left_bars -= 2
          cx += 0.5 + 0.6
        else
          score_draw_glyph(paths, ink, "restWhole", cx, top + 1.0, sp)
          left_bars -= 1
          cx += score_glyph("restWhole")["advance"] + 0.6
        end
      end
    else
      paths.push(score_rect(ink, x0, top + 1.75, x1 - x0, 0.5, sp))
      paths.push(score_rect(ink, x0, top + 1.0, 0.18, 2.0, sp))
      paths.push(score_rect(ink, x1 - 0.18, top + 1.0, 0.18, 2.0, sp))
    end
    names = score_digits(ev["mm"])
    wide = names.reduce(fn(acc, nm) acc + score_glyph(nm)["advance"], 0.0)
    nx = (x0 + x1) / 2.0 - wide / 2.0
    for nm in names
      score_draw_glyph(paths, ink, nm, nx, top - 1.3, sp)
      nx += score_glyph(nm)["advance"]
    end
    return nil
  end
  if ev["whole_bar"] == true
    score_draw_glyph(paths, ink, "restWhole", ev["x"], top + 1.0 + score_rest_lift(ev), sp)
    return nil
  end
  name = score_rest_name(ev["base"])
  y = (ev["base"] == 1 ? 1.0 : 2.0) + score_rest_lift(ev)
  score_draw_glyph(paths, ink, name, ev["x"], top + y, sp)
  if ev["dots"] > 0
    dx = ev["x"] + score_glyph(name)["advance"] + 0.3
    for _ in 0..ev["dots"]
      score_draw_glyph(paths, ink, "augmentationDot", dx, top + 1.5 + score_rest_lift(ev), sp)
      dx += 0.6
    end
  end
end

def score_draw_note(paths, ink, ev, top, sp)
  head_name = score_head_name(ev["base"])
  hw = ev["head_w"]
  # Ledger lines, a little wider than the heads they carry.
  hi = ev["heads"][-1]["pos"]
  lo = ev["heads"][0]["pos"]
  wide = ev["heads"].any? { |hd| hd["side"] != 0 }
  reach_out = hw * SCORE_RULE["ledger_out"]
  lx = ev["x"] - reach_out
  lw = hw + 2.0 * reach_out
  if wide && ev["up"]
    lw += hw - SCORE_RULE["stem"]
  end
  if wide && !ev["up"]
    lx -= hw - SCORE_RULE["stem"]
    lw += hw - SCORE_RULE["stem"]
  end
  lt = SCORE_RULE["ledger"]
  pos = 6
  while pos <= hi
    paths.push(score_rect(ink, lx, top + score_y(pos) - lt / 2.0, lw, lt, sp))
    pos += 2
  end
  pos = -6
  while pos >= lo
    paths.push(score_rect(ink, lx, top + score_y(pos) - lt / 2.0, lw, lt, sp))
    pos -= 2
  end
  # Heads, accidentals, dots.
  dot_x = ev["x"] + hw + 0.3
  dot_x += hw - SCORE_RULE["stem"] if wide && ev["up"]
  for hd in ev["heads"]
    hx = ev["x"] + hd["side"] * (hw - SCORE_RULE["stem"])
    y = top + score_y(hd["pos"])
    score_draw_glyph(paths, ink, head_name, hx, y, sp)
    unless hd["acc"].nil?
      score_draw_glyph(paths, ink, score_acc_name(hd["acc"]), ev["x"] + hd["acc_x"], y, sp)
    end
    if ev["dots"] > 0
      dot_pos = hd["pos"] % 2 == 0 ? hd["pos"] + 1 : hd["pos"]
      dx = dot_x
      for _ in 0..ev["dots"]
        score_draw_glyph(paths, ink, "augmentationDot", dx, top + score_y(dot_pos), sp)
        dx += 0.6
      end
    end
  end
  return nil if ev["base"] == 1

  # The stem, from the head it leaves to its end; then a flag if it is
  # alone.
  g = score_glyph(head_name)
  sx = 0.0
  tip = 0.0
  root = 0.0
  if ev["up"]
    root = top + score_y(lo) + g["anchors"]["stemUpSE"][1]
    sx = score_stem_x(ev) - SCORE_RULE["stem"]
    tip = top + ev["stem_end"]
    paths.push(score_rect(ink, sx, tip, SCORE_RULE["stem"], root - tip, sp))
  else
    root = top + score_y(hi) + g["anchors"]["stemDownNW"][1]
    sx = score_stem_x(ev)
    tip = top + ev["stem_end"]
    paths.push(score_rect(ink, sx, root, SCORE_RULE["stem"], tip - root, sp))
  end
  if ev["beam"].nil? && score_flags(ev["base"]) > 0
    flag = score_flag_name(ev["base"], ev["up"])
    anchor = score_glyph(flag)["anchors"][ev["up"] ? "stemUpNW" : "stemDownSW"]
    score_draw_glyph(paths, ink, flag, sx - anchor[0], tip - anchor[1], sp)
  end
end

def score_draw_beam(paths, ink, g, top, sp)
  notes = g["notes"]
  dir = g["up"] ? 1.0 : -1.0
  for level in 0..g["n"]
    off = level * SCORE_RULE["beam_step"] * dir
    i = 0
    while i < notes.length
      if score_flags(notes[i]["base"]) <= level
        i += 1
        next
      end
      jj = i
      while jj + 1 < notes.length && score_flags(notes[jj + 1]["base"]) > level
        jj += 1
      end
      xa = score_stem_x(notes[i]) - (g["up"] ? SCORE_RULE["stem"] : 0.0)
      xb = score_stem_x(notes[jj]) + (g["up"] ? 0.0 : SCORE_RULE["stem"])
      if i == jj
        stub = 1.1
        if i == 0
          xb = xa + stub
        else
          xb = xa + SCORE_RULE["stem"]
          xa = xb - stub
        end
      end
      ya = score_beam_y(g, xa) + off
      yb = score_beam_y(g, xb) + off
      cmds = []
      bt = SCORE_RULE["beam"]
      if g["up"]
        cmds = [0, xa, ya, 1, xb, yb, 1, xb, yb + bt, 1, xa, ya + bt, 4]
      else
        cmds = [0, xa, ya - bt, 1, xb, yb - bt, 1, xb, yb, 1, xa, ya, 4]
      end
      paths.push(score_fill(ink, cmds, 0.0, top, sp))
      i = jj + 1
    end
  end
end

def score_editor(event_data)
  ed_event = event_data["event"]
  params = event_data["params"] ?? {}
  props = params["props"] ?? {}
  state = score_ed_defaults(event_data["state"] ?? {})
  state["viewport"] = params["viewport"] if params["viewport"]
  ed_answer = score_ed_answer(state, ed_event, params, props)
  # A file answered is sent as it is; a state shows the page its selection,
  # or the note playing, is on.
  return ed_answer if ed_answer.has_key("save")

  score_ed_follow(ed_answer)
end

def score_ed_answer(state, ed_event, params, props)
  match ed_event {
    "track" => score_ed_switch(score_ed_flag(state, "full_view", false), int(props["track"] ?? 0)),
    "full_view" => score_ed_full_on(state),
    "track_add" => score_ed_track_add(state),
    "track_remove" => score_ed_track_remove(state),
    "track_up" => score_ed_track_move(state, -1),
    "track_down" => score_ed_track_move(state, 1),
    "track_name" => score_ed_track_set(state, "name", params["payload"] ?? ""),
    "track_short" => score_ed_track_set(state, "short", params["payload"] ?? ""),
    "track_instrument" => score_ed_track_set(score_ed_flag(state, "inst_open", false), "instrument", props["value"]),
    "inst_open" => score_ed_flag(state, "inst_open", !(state["inst_open"] == true)),
    "track_volume" => score_ed_track_set(state, "volume", score_max(0, score_min(127, score_ed_int(params["payload"] ?? "")))),
    "track_pan" => SCORE_ED_PANS.includes?(props["option"]) ? score_ed_track_set(state, "pan", [-100, -50, 0, 50, 100][SCORE_ED_PANS.index_of(props["option"])]) : state,
    "track_mute" => score_ed_track_set(state, "mute", !(score_ed_tracks(state)[state["track"] ?? 0]["mute"] == true)),
    "group" => SCORE_ED_GROUPS.includes?(props["option"]) ? score_ed_flag(state, "group", props["option"]) : state,
    "conductor_pick" => score_ed_conductor_pick(state, params["payload"] ?? [0, 0]),
    "connect" => state,
    "viewport" => state,
    "key" => score_ed_key(state, params["payload"][0], params["payload"][1]),
    "midi" => score_ed_midi_in(state, params["payload"] ?? []),
    "pick" => score_ed_pick(state, params["payload"] ?? [0, 0], int(props["page"] ?? 0)),
    "press" => score_ed_press(state, params["payload"] ?? [0, 0], int(props["page"] ?? 0)),
    "drag" => score_ed_drag(state, params["payload"] ?? [0, 0]),
    "release" => score_ed_flag(state, "dragging", false),
    "dur" => score_ed_duration(state, int(props["base"])),
    "dot" => score_ed_dot(state),
    "rest" => score_ed_insert_rest(state),
    "note" => score_ed_insert(state, int(props["step"]), false),
    "acc" => score_ed_alter(state, int(props["by"]), false),
    "natural" => score_ed_alter(state, 0, true),
    "step" => score_ed_move_pitch(state, int(props["by"])),
    "semitone" => score_ed_semitone(state, int(props["by"])),
    "tie" => score_ed_tie(state),
    "delete" => score_ed_delete(state, true),
    "undo" => score_ed_undo(state),
    "redo" => score_ed_redo(state),
    "clef" => score_ed_settings(state, "clef", props["option"]),
    "time" => score_ed_settings(state, "time", props["option"]),
    "time_open" => score_ed_flag(state, "time_open", !(state["time_open"] == true)),
    "time_pick" => score_ed_settings(score_ed_flag(state, "time_open", false), "time", props["value"]),
    "scope" => SCORE_ED_SCOPES.includes?(props["option"]) ? score_ed_flag(state, "scope", props["option"]) : state,
    "tool" => SCORE_ED_TOOLS.includes?(props["option"]) && !score_ed_full_view(state) ? score_ed_flag(state, "tool", props["option"]) : state,
    "voice" => SCORE_ED_VOICES.includes?(props["option"]) && !score_ed_full_view(state) ? score_ed_set_voice(state, SCORE_ED_VOICES.index_of(props["option"]) + 1) : state,
    "view" => SCORE_ED_VIEWS.includes?(props["option"]) ? score_ed_flag(state, "view", props["option"]) : state,
    "panel" => SCORE_ED_PANELS.includes?(props["tab"]) ? score_ed_flag(state, "panel", (state["panel"] ?? SCORE_ED_PANELS[0]) == props["tab"] ? "none" : props["tab"]) : state,
    "bpm" => score_ed_tempo(state, score_ed_int(params["payload"] ?? ""), state["tempo_text"], state["mark_tempo"]),
    "tempo_text" => score_ed_tempo(state, state["tempo"], params["payload"] ?? "", state["mark_tempo"]),
    "mark_tempo" => score_ed_tempo(state, state["tempo"], state["tempo_text"], !(state["mark_tempo"] == true)),
    "hdr_title" => score_ed_header_set(state, "title", params["payload"] ?? ""),
    "hdr_subtitle" => score_ed_header_set(state, "subtitle", params["payload"] ?? ""),
    "hdr_composer" => score_ed_header_set(state, "composer", params["payload"] ?? ""),
    "hdr_arranger" => score_ed_header_set(state, "arranger", params["payload"] ?? ""),
    "key_open" => score_ed_flag(state, "key_open", !(state["key_open"] == true)),
    "key_pick" => score_ed_settings(score_ed_flag(state, "key_open", false), "key", (props["value"] ?? "").replace(" major", "")),
    "src" => score_ed_from_source(state, params["payload"] ?? ""),
    "clear" => score_ed_clear(state),
    "example" => score_ed_example(state, props["value"] ?? SCORE_ED_EXAMPLES[0]),
    "ex_open" => score_ed_flag(state, "ex_open", !(state["ex_open"] == true)),
    "help" => score_ed_flag(state, "help", !(state["help"] == true)),
    "slur" => score_ed_slur(state),
    "tuplet" => score_ed_tuplet(state, int(props["n"] ?? 3)),
    "repeat_start" => score_ed_repeat(state, "rep_start"),
    "repeat_end" => score_ed_repeat(state, "rep_end"),
    "line_break" => score_ed_break(state, "line"),
    "dyn" => score_ed_dynamic(state, props["dyn"]),
    "hairpin" => score_ed_hairpin(state, props["grow"]),
    "artic" => score_ed_artic(state, props["name"]),
    "midi_save" => {"state": state, "save": score_midi(score_ed_full_source(state), {"bpm": state["tempo"], "beat": state["tempo_base"] ?? 4})},
    "pdf_save" => {"state": state, "save": score_pdf(score_ed_full_source(state))},
    "words" => score_ed_words(state, params["payload"] ?? "", props["dir"] == "down" ? 1 : -1),
    "words_clear" => score_ed_words_pressed(state, ""),
    "words_mark" => score_ed_words_pressed(state, props["text"] ?? ""),
    "lyrics" => score_ed_lyrics_set(state, params["payload"] ?? ""),
    "words_dir" => ["Above", "Below"].includes?(props["option"]) ? score_ed_flag(state, "words_dir", props["option"]) : state,
    "page_break" => score_ed_break(state, "page"),
    "play" => score_ed_play(state),
    "playhead" => score_ed_playhead(state, params["payload"] ?? [0, 0]),
    "play_tick" => score_ed_play_tick(state),
    "src_open" => score_ed_flag(state, "src_open", !(state["src_open"] == true)),
    "page_to" => score_ed_flag(state, props["which"] == "cond_page" ? "cond_page" : "page", int(props["to"] ?? 0)),
    "ended" => score_ed_stop(state),
    "sound" => score_ed_flag(state, "sound", !(state["sound"] == true)),
    _ => state
  }
end

def score_ed_int(typed)
  digits = typed.chars().filter { |ch| "0123456789".contains(ch) }.join("")
  digits == "" ? 0 : int(digits)
end

def score_ed_flag(state, key, value)
  state[key] = value
  state
end

def score_ed_defaults(state)
  return state if state.has_key("notes")

  state["clef"] = "Treble"
  state["key"] = "C"
  state["time"] = "4/4"
  state["dur"] = 4
  state["dot"] = false
  state["undo"] = []
  state["redo"] = []
  state["error"] = ""
  state["help"] = false
  state["key_open"] = false
  state["tempo"] = 100
  state["tempo_base"] = 4
  state["tempo_text"] = ""
  state["mark_tempo"] = true
  state["header"] = {}
  state["scope"] = SCORE_ED_SCOPES[0]
  state["view"] = SCORE_ED_VIEWS[0]
  state["time_open"] = false
  state["sound"] = true
  state["playing"] = false
  state["play_at"] = -1
  state["blips"] = 0
  score_ed_frere_jacques(state)
end

def score_ed_frere_jacques(state)
  tune = [[0, 4], [1, 4], [2, 4], [0, 4], [0, 4], [1, 4], [2, 4], [0, 4], [2, 4], [3, 4], [4, 2], [2, 4], [3, 4], [4, 2]]
  state["notes"] = tune.map { |nt| score_ed_note(nt[0], 4, 0, nt[1], 0) }
  state["header"] = {"title": "Frère Jacques", "composer": "Traditional"}
  state["tempo_text"] = "Moderato"
  state["sel"] = 0
  state
end

def score_ed_note(step, octave, alter, base, dots)
  {"rest": false, "pitches": [ {"step": step, "oct": octave, "alter": alter} ], "base": base, "dots": dots, "tie": false}
end

def score_ed_remember(state)
  score_ed_push_undo(state, score_ed_snap(state, false))
end

def score_ed_remember_all(state)
  score_ed_push_undo(state, score_ed_snap(state, true))
end

def score_ed_snap(state, all)
  snap = {"notes": state["notes"], "notes2": state["notes2"] ?? [], "voice": state["voice"] ?? 1, "clef": state["clef"], "key": state["key"], "time": state["time"], "sel": state["sel"], "track": state["track"] ?? 0}
  # The edited track's lyrics are its settings' only words an edit changes.
  snap["lyrics"] = score_ed_tracks(state)[state["track"] ?? 0]["lyrics"] ?? ""
  snap["tracks"] = score_ed_tracks(state) if all
  score_ed_copy(snap)
end

def score_ed_push_undo(state, snap)
  # Any other edit ends a run of typing words.
  state["words_at"] = ""
  undo = state["undo"] ?? []
  undo.push(snap)
  if undo.length > SCORE_ED_UNDO
    undo = range(undo.length - SCORE_ED_UNDO, undo.length).map { |k| undo[k] }
  end
  state["undo"] = undo
  state["redo"] = []
  state["error"] = ""
  state
end

def score_ed_copy(v)
  return v.map { |x| score_ed_copy(x) } if v.is_a?("array")
  if v.is_a?("hash")
    out = {}
    for k in v.keys
      out[k] = score_ed_copy(v[k])
    end
    return out
  end

  v
end

def score_ed_restore(state, snap)
  state["tracks"] = snap["tracks"] if snap.has_key("tracks")
  state["track"] = snap["track"] if snap.has_key("track")
  score_ed_tracks(state)[state["track"] ?? 0]["lyrics"] = snap["lyrics"] if snap.has_key("lyrics")
  state["notes"] = snap["notes"]
  state["notes2"] = snap["notes2"] if snap.has_key("notes2")
  state["voice"] = snap["voice"] if snap.has_key("voice")
  state["clef"] = snap["clef"]
  state["key"] = snap["key"]
  state["time"] = snap["time"]
  state["sel"] = snap["sel"]
  state
end

def score_ed_undo(state)
  undo = state["undo"] ?? []
  return state if undo.length == 0

  snap = undo.pop()
  state["words_at"] = ""
  state = score_ed_onto_track(state, snap)
  redo = state["redo"] ?? []
  redo.push(score_ed_snap(state, snap.has_key("tracks")))
  state["undo"] = undo
  state["redo"] = redo
  score_ed_restore(state, snap)
end

def score_ed_onto_track(state, snap)
  return state if snap.has_key("tracks") || !snap.has_key("track") || snap["track"] == (state["track"] ?? 0)

  score_ed_switch(state, snap["track"])
end

def score_ed_redo(state)
  redo = state["redo"] ?? []
  return state if redo.length == 0

  snap = redo.pop()
  state["words_at"] = ""
  state = score_ed_onto_track(state, snap)
  undo = state["undo"] ?? []
  undo.push(score_ed_snap(state, snap.has_key("tracks")))
  state["undo"] = undo
  state["redo"] = redo
  score_ed_restore(state, snap)
end

def score_ed_selected(state)
  sel = state["sel"] ?? -1
  return nil if sel < 0 || sel >= state["notes"].length

  state["notes"][sel]
end

def score_ed_key_alter(state, step)
  score_key_alters(score_ed_fifths_of(score_ed_key_at(state, state["sel"] ?? -1)))[step]
end

def score_ed_fifths(state)
  score_ed_fifths_of(state["key"])
end

def score_ed_fifths_of(key)
  at = SCORE_ED_KEYS.index_of(key)
  at < 0 ? 0 : at - 7
end

def score_ed_key_at(state, idx)
  last = idx < 0 ? state["notes"].length - 1 : idx
  key = state["key"]
  for nt, k in state["notes"]
    break if k > last

    changes = nt["set"] ?? {}
    key = changes["key"] if changes.has_key("key")
  end
  key
end

def score_ed_reach()
  14
end

def score_ed_pos_of(state, pt)
  (pt["oct"] - 3) * 7 + pt["step"] - score_clef_mid(score_ed_clef(state))
end

def score_ed_fits(state, pt)
  midi = 12 * (pt["oct"] + 1) + [0, 2, 4, 5, 7, 9, 11][pt["step"]] + pt["alter"]
  score_ed_pos_of(state, pt).abs <= score_ed_reach() && midi >= 21 && midi <= 108
end

def score_ed_within(state, pt)
  out = pt.merge({})
  while score_ed_pos_of(state, out) > score_ed_reach()
    out["oct"] = out["oct"] - 1
  end
  while score_ed_pos_of(state, out) < 0 - score_ed_reach()
    out["oct"] = out["oct"] + 1
  end
  out
end

def score_ed_octave_near(state, step)
  prev = nil
  sel = state["sel"] ?? -1
  idx = sel >= 0 ? sel : state["notes"].length - 1
  while idx >= 0 && prev.nil?
    cand = state["notes"][idx]
    prev = cand["pitches"][0] unless cand["rest"]
    idx -= 1
  end
  if prev.nil?
    return {"Treble": 4, "Bass": 3, "Alto": 4}[state["clef"]] ?? 4
  end
  ref = prev["oct"] * 7 + prev["step"]
  best = prev["oct"]
  best_gap = 99
  for octave in [prev["oct"] - 1, prev["oct"], prev["oct"] + 1]
    gap = (octave * 7 + step - ref).abs
    if gap < best_gap
      best_gap = gap
      best = octave
    end
  end
  best
end

def score_ed_insert(state, step, chord)
  state = score_ed_remember(state)
  current = score_ed_selected(state)
  if chord && !current.nil? && !current["rest"]
    octave = current["pitches"][-1]["oct"]
    octave += 1 if step <= current["pitches"][-1]["step"]
    current["pitches"].push(score_ed_within(state, {"step": step, "oct": octave, "alter": score_ed_key_alter(state, step)}))
    current["pitches"] = current["pitches"].sort_by { |pt| pt["oct"] * 7 + pt["step"] }
    return state
  end
  octave = score_ed_within(state, {"step": step, "oct": score_ed_octave_near(state, step), "alter": 0})["oct"]
  fresh = score_ed_note(step, octave, score_ed_key_alter(state, step), state["dur"], state["dot"] ? 1 : 0)
  score_ed_place(state, fresh)
end

def score_ed_insert_rest(state)
  state = score_ed_remember(state)
  fresh = {"rest": true, "pitches": [], "base": state["dur"], "dots": state["dot"] ? 1 : 0, "tie": false}
  score_ed_place(state, fresh)
end

def score_ed_place(state, fresh)
  notes = state["notes"]
  sel = state["sel"] ?? -1
  at = sel >= 0 ? sel + 1 : notes.length
  at = notes.length if at > notes.length
  before = notes.take(at)
  after = range(at, notes.length).map { |k| notes[k] }
  state["notes"] = before + [fresh] + after
  state["sel"] = at
  state["typing"] = true
  score_ed_blip(state, fresh)
end

def score_ed_delete(state, back)
  current = score_ed_selected(state)
  return state if current.nil?

  state = score_ed_remember(state)
  notes = state["notes"]
  sel = state["sel"]
  if current["rest"]
    score_ed_untuplet(state, notes[sel])
    state["notes"] = range(0, notes.length).filter { |k| k != sel }.map { |k| notes[k] }
  else
    score_ed_unslur(notes, sel)
    notes[sel - 1]["tie"] = false if sel > 0
    notes[sel] = score_ed_silenced(notes[sel])
  end
  state = score_ed_trim(state)
  left = state["notes"].length
  next_sel = back ? sel - 1 : sel
  next_sel = left - 1 if next_sel >= left
  next_sel = 0 if next_sel < 0 && left > 0
  next_sel = -1 if left == 0
  state["sel"] = next_sel
  state
end

def score_ed_silenced(nt)
  out = {"rest": true, "auto": true, "pitches": [], "base": nt["base"], "dots": nt["dots"], "tie": false}
  for field in ["tup", "set", "rep_start", "rep_end", "brk", "hairpin", "hairpin_end"]
    out[field] = nt[field] unless nt[field].nil?
  end
  out
end

def score_ed_unslur(notes, at)
  if notes[at]["slur_on"] == true
    done = false
    for k in range(at + 1, notes.length)
      if !done && notes[k]["slur_off"] == true
        notes[k]["slur_off"] = false
        done = true
      end
    end
  end
  if notes[at]["slur_off"] == true
    done = false
    for k in range(0, at).reverse()
      if !done && notes[k]["slur_on"] == true
        notes[k]["slur_on"] = false
        done = true
      end
    end
  end
  notes
end

def score_ed_trim(state)
  while state["notes"].length > 0
    notes = state["notes"]
    start = score_ed_bar_start(state, notes.length - 1)
    tail = range(start, notes.length).map { |k| notes[k] }
    break unless tail.all? { |nt| nt["auto"] == true }

    state["notes"] = notes.take(start)
  end
  state
end

def score_ed_duration(state, base)
  return state unless [1, 2, 4, 8, 16, 32].includes?(base)

  state["dur"] = base
  state["dot"] = false if base == 32
  current = score_ed_selected(state)
  # In insert mode a value is the next note's, never the selected one's:
  # the selection is only where the last press wrote.
  return state if current.nil? || state["typing"] == true || score_ed_inserting(state)

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  score_ed_untuplet(state, current)
  current["base"] = base
  current["dots"] = 0 if base == 32
  state
end

def score_ed_untuplet(state, nt)
  tup = nt["tup"]
  return nil if tup.nil?

  for other in state["notes"]
    other["tup"] = nil if !other["tup"].nil? && other["tup"]["g"] == tup["g"]
  end
end

def score_ed_tuplet(state, n)
  current = score_ed_selected(state)
  return state if current.nil? || !current["tup"].nil? || current["dots"] > 0

  d = n == 3 ? 2 : 4
  base = current["base"] * d
  return state if base > 32

  state = score_ed_remember(state)
  sel = state["sel"]
  current = state["notes"][sel]
  state["tup_seq"] = (state["tup_seq"] ?? 0) + 1
  group = range(0, n).map { |k| current.merge({"base": base, "dots": 0, "tie": false, "slur_on": k == 0 && current["slur_on"] == true, "slur_off": k == n - 1 && current["slur_off"] == true, "set": k == 0 ? (current["set"] ?? {}) : {}, "rep_start": k == 0 && current["rep_start"] == true, "rep_end": k == n - 1 && current["rep_end"] == true, "pitches": current["pitches"].map { |pt| pt.merge({}) }, "tup": {"g": state["tup_seq"], "n": n, "d": d}}) }
  notes = state["notes"]
  state["notes"] = range(0, sel).map { |k| notes[k] } + group + range(sel + 1, notes.length).map { |k| notes[k] }
  state["typing"] = false
  state
end

def score_ed_dot(state)
  current = score_ed_selected(state)
  if current.nil? || state["typing"] == true || score_ed_inserting(state)
    state["dot"] = !state["dot"] && state["dur"] != 32
    return state
  end
  return state if current["base"] == 32

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  current["dots"] = current["dots"] > 0 ? 0 : 1
  state["dot"] = current["dots"] > 0
  state
end

def score_ed_alter(state, by, absolute)
  current = score_ed_selected(state)
  return state if current.nil? || current["rest"]

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  for pt in current["pitches"]
    want = absolute ? by : pt["alter"] + by
    pt["alter"] = want.clamp(-2, 2)
  end
  score_ed_blip(state, current)
end

def score_ed_semitone(state, by)
  current = score_ed_selected(state)
  return state if current.nil? || current["rest"]

  moved = current["pitches"].map { |pt| score_ed_spell(state, score_ed_midi_key(pt) + by, by) }.map { |sp| {"step": sp[0], "alter": sp[1], "oct": sp[2]} }
  # Out of reach: the note stays where it is.
  return state unless moved.all? { |pt| score_ed_fits(state, pt) }

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  current["pitches"] = moved
  score_ed_blip(state, current)
end

def score_ed_spell(state, midi, by)
  natural = [0, 2, 4, 5, 7, 9, 11]
  key = midi
  pc = key % 12
  spelled = nil
  in_key = range(0, 7).map { |st| score_ed_key_alter(state, st) }
  way = by > 0 ? 1 : -1
  toward = [way, way, way, way, way, way, way]
  against = [0 - way, 0 - way, 0 - way, 0 - way, 0 - way, 0 - way, 0 - way]
  for choice in [in_key, [0, 0, 0, 0, 0, 0, 0], toward, against]
    for st in range(0, 7)
      spelled = [st, choice[st]] if spelled.nil? && score_mod(natural[st] + choice[st] - pc, 12) == 0
    end
  end
  [spelled[0], spelled[1], (key - natural[spelled[0]] - spelled[1]) / 12 - 1]
end

def score_ed_move_pitch(state, by)
  current = score_ed_selected(state)
  return state if current.nil? || current["rest"]

  moved = []
  for pt in current["pitches"]
    d = pt["oct"] * 7 + pt["step"] + by
    step = d % 7
    moved.push({"step": step, "oct": d / 7, "alter": by == 7 || by == -7 ? pt["alter"] : score_ed_key_alter(state, step)})
  end
  return state unless moved.all? { |pt| score_ed_fits(state, pt) }

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  current["pitches"] = moved
  score_ed_blip(state, current)
end

def score_ed_tie(state)
  current = score_ed_selected(state)
  return state if current.nil? || current["rest"]

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  current["tie"] = !(current["tie"] == true)
  state
end

def score_ed_slur(state)
  current = score_ed_selected(state)
  start = state["slur_from"] ?? -1
  start = -1 if start >= state["notes"].length
  if start >= 0
    state["slur_from"] = -1
    return state if current.nil? || current["rest"] || state["sel"] == start

    state = score_ed_remember(state)
    notes = state["notes"]
    notes[score_min(start, state["sel"])]["slur_on"] = true
    notes[score_max(start, state["sel"])]["slur_off"] = true
    return state
  end
  return state if current.nil? || current["rest"]

  if current["slur_on"] == true
    state = score_ed_remember(state)
    score_ed_unslur(state["notes"], state["sel"])
    score_ed_selected(state)["slur_on"] = false
    return state
  end
  state["slur_from"] = state["sel"]
  state
end

def score_ed_repeat(state, which)
  return score_ed_flag(state, "error", "Repeats and breaks are the first voice's: switch to Voice 1 (Ctrl+Alt+1).") if state["voice"] == 2
  return score_ed_flag(state, "error", "Repeats and breaks are set on the first track: they are the bars', and every staff has them.") if score_ed_tracks(state).length > 1 && (state["track"] ?? 0) != 0
  sel = state["sel"] ?? -1
  return state if sel < 0 || sel >= state["notes"].length

  state = score_ed_remember(state)
  bar_of = score_ed_bars_of(state)
  mates = range(0, state["notes"].length).filter { |k| bar_of[k] == bar_of[sel] }
  marked = mates.filter { |k| state["notes"][k][which] == true }
  if marked.length > 0
    for k in marked
      state["notes"][k][which] = false
    end
    return state
  end
  state["notes"][which == "rep_start" ? mates[0] : mates[-1]][which] = true
  state
end

def score_ed_dynamic(state, dyn)
  current = score_ed_selected(state)
  return state if current.nil? || !SCORE_ED_DYNAMICS.includes?(dyn)

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  current["dyn"] = current["dyn"] == dyn ? nil : dyn
  state
end

def score_ed_hairpin(state, grow)
  return state unless ["<", ">"].includes?(grow)

  current = score_ed_selected(state)
  start = state["pin_from"] ?? -1
  start = -1 if start >= state["notes"].length
  if start >= 0
    if !current.nil? && state["sel"] == start && state["pin_grow"] != grow
      state["pin_grow"] = grow
      return state
    end
    kind = state["pin_grow"] ?? grow
    state["pin_from"] = -1
    return state if current.nil? || state["sel"] == start

    state = score_ed_remember(state)
    notes = state["notes"]
    first = score_min(start, state["sel"])
    last = score_max(start, state["sel"])
    notes[first]["hairpin"] = kind
    notes[last]["hairpin_end"] = true
    return state
  end
  return state if current.nil?

  if !current["hairpin"].nil?
    state = score_ed_remember(state)
    score_ed_unpin(state["notes"], state["sel"])
    return state
  end
  state["pin_from"] = state["sel"]
  state["pin_grow"] = grow
  state
end

def score_ed_unpin(notes, at)
  notes[at]["hairpin"] = nil
  done = false
  for k in range(at, notes.length)
    if !done && notes[k]["hairpin_end"] == true
      notes[k]["hairpin_end"] = false
      done = true
    end
    # Another hairpin or a dynamic ends this one where it stands.
    done = true if k > at && (!notes[k]["hairpin"].nil? || !notes[k]["dyn"].nil?)
  end
  notes
end

def score_ed_artic(state, name)
  current = score_ed_selected(state)
  return state if current.nil? || current["rest"] || !SCORE_ED_ARTICS.includes?(name)

  state = score_ed_remember(state)
  current = score_ed_selected(state)
  had = (current["scripts"] ?? []).filter { |sc| sc["name"] == name }.length > 0
  kept = (current["scripts"] ?? []).filter { |sc| sc["name"] != name }
  current["scripts"] = had ? kept : kept + [ {"name": name, "dir": 0} ]
  state
end

def score_ed_words(state, words, dir)
  current = score_ed_selected(state)
  return state if current.nil?

  at = str(state["track"] ?? 0) + "|" + str(state["voice"] ?? 1) + "|" + str(state["sel"]) + "|" + str(dir)
  if state["words_at"] != at
    state = score_ed_remember(state)
    state["words_at"] = at
  end
  current = score_ed_selected(state)
  kept = (current["texts"] ?? []).filter { |tx| tx["dir"] != dir }
  current["texts"] = words.trim == "" ? kept : kept + [ {"text": words, "dir": dir} ]
  state
end

def score_ed_words_pressed(state, words)
  state["words_at"] = ""
  state = score_ed_words(state, words, score_ed_words_side(state))
  state["words_at"] = ""
  state
end

def score_ed_words_side(state)
  state["words_dir"] == "Below" ? 1 : -1
end

def score_ed_word_marks()
  ["dolce", "espress.", "cantabile", "legato", "rit.", "rall.", "a tempo", "cresc.", "dim.", "poco a poco", "sub.", "pizz.", "arco"]
end

def score_ed_expression_ly(nt, first_piece, last_piece)
  out = ""
  if first_piece
    out += "\\" + nt["dyn"] unless nt["dyn"].nil?
    for sc in nt["scripts"] ?? []
      side = {"-1": "^", "0": "-", "1": "_"}[str(sc["dir"] ?? 0)]
      out += sc["name"] == "fermata" ? side + "\\fermata" : side + {"staccato": ".", "accent": ">", "tenuto": "-", "marcato": "^", "staccatissimo": "!", "portato": "_"}[sc["name"]]
    end
    for tx in nt["texts"] ?? []
      out += (tx["dir"] < 0 ? "^" : "_") + "\"" + score_ed_clean(tx["text"]) + "\"" if score_ed_clean(tx["text"]) != ""
    end
    out += "\\" + nt["hairpin"] unless nt["hairpin"].nil?
  end
  out += "\\!" if last_piece && nt["hairpin_end"] == true
  out
end

def score_ed_break(state, kind)
  return score_ed_flag(state, "error", "Repeats and breaks are set on the first track: they are the bars', and every staff has them.") if score_ed_tracks(state).length > 1 && (state["track"] ?? 0) != 0
  sel = state["sel"] ?? -1
  return state if sel < 0 || sel >= state["notes"].length

  state = score_ed_remember(state)
  bar_of = score_ed_bars_of(state)
  mates = range(0, state["notes"].length).filter { |k| bar_of[k] == bar_of[sel] }
  had = mates.filter { |k| state["notes"][k]["brk"] == kind }.length > 0
  for k in mates
    state["notes"][k]["brk"] = nil
  end
  state["notes"][mates[-1]]["brk"] = kind unless had
  state
end

def score_ed_bars_of(state)
  measure = score_ed_bar_ticks(state)
  pos = 0
  bar = 0
  out = []
  for nt in state["notes"]
    changes = nt["set"] ?? {}
    measure = score_ed_measure_of(changes["time"]) if changes.has_key("time") && pos == 0
    out.push(bar)
    pos += score_ed_ticks(nt)
    bar += pos / measure
    pos = pos % measure
  end
  out
end

def score_ed_track_new(name)
  {"name": name, "short": "", "instrument": "acoustic grand", "volume": 100, "pan": 0, "mute": false}
end

def score_ed_tracks(state)
  state["tracks"] = [score_ed_track_new("")] if (state["tracks"] ?? []).length == 0
  state["tracks"]
end

def score_ed_all(state)
  active = state["track"] ?? 0
  mine = score_ed_v1(state)
  out = []
  for trk, k in score_ed_tracks(state)
    if k == active
      out.push(trk.merge({"notes": mine["notes"], "notes2": mine["notes2"] ?? [], "clef": state["clef"]}))
    else
      out.push(trk.merge({"notes": trk["notes"] ?? [], "notes2": trk["notes2"] ?? [], "clef": trk["clef"] ?? "Treble"}))
    end
  end
  out
end

def score_ed_v1(state)
  return state unless state["voice"] == 2

  state.merge({"notes": state["notes2"] ?? [], "notes2": state["notes"], "voice": 1})
end

def score_ed_set_voice(state, v)
  current = state["voice"] ?? 1
  return state if v == current || (v != 1 && v != 2)

  other = state["notes2"] ?? []
  state["notes2"] = state["notes"]
  state["notes"] = other
  state["voice"] = v
  state["sel"] = -1
  state["typing"] = false
  state["slur_from"] = -1
  state["pin_from"] = -1
  state
end

def score_ed_voiced?(notes2)
  (notes2 ?? []).any? { |nt| !nt["rest"] || nt["spacer"] != true }
end

def score_ed_switch(state, k)
  tracks = score_ed_tracks(state)
  active = state["track"] ?? 0
  return state if k == active || k < 0 || k >= tracks.length

  state = score_ed_set_voice(state, 1)
  tracks[active]["notes2"] = state["notes2"] ?? []
  state["notes2"] = tracks[k]["notes2"] ?? []
  tracks[k]["notes2"] = nil
  tracks[active]["notes"] = state["notes"]
  tracks[active]["clef"] = state["clef"]
  state["notes"] = tracks[k]["notes"] ?? []
  state["clef"] = tracks[k]["clef"] ?? "Treble"
  tracks[k]["notes"] = nil
  tracks[k]["clef"] = nil
  state["track"] = k
  state["sel"] = state["notes"].length > 0 ? 0 : -1
  state["typing"] = false
  state["slur_from"] = -1
  state["pin_from"] = -1
  state
end

def score_ed_track_add(state)
  state = score_ed_remember_all(state)
  tracks = score_ed_tracks(state)
  if tracks.length == 1 && tracks[0]["name"] == ""
    tracks[0]["name"] = "Track 1"
  end
  fresh = score_ed_track_new("Track " + str(tracks.length + 1))
  fresh["notes"] = []
  fresh["clef"] = "Treble"
  tracks.push(fresh)
  score_ed_switch(state, tracks.length - 1)
end

def score_ed_track_remove(state)
  tracks = score_ed_tracks(state)
  return state if tracks.length < 2

  state = score_ed_remember_all(state)
  tracks = state["tracks"]
  gone = state["track"] ?? 0
  to = gone == 0 ? 1 : gone - 1
  state = score_ed_switch(state, to)
  state["tracks"] = range(0, tracks.length).filter { |k| k != gone }.map { |k| tracks[k] }
  state["track"] = to > gone ? to - 1 : to
  state
end

def score_ed_track_move(state, by)
  tracks = score_ed_tracks(state)
  at = state["track"] ?? 0
  to = at + by
  return state if to < 0 || to >= tracks.length

  state = score_ed_remember_all(state)
  tracks = state["tracks"]
  moving = tracks[at]
  tracks[at] = tracks[to]
  tracks[to] = moving
  state["track"] = to
  state
end

def score_ed_track_set(state, field, value)
  return state if value.nil?

  tracks = score_ed_tracks(state)
  tracks[state["track"] ?? 0][field] = value
  state
end

def score_ed_bar_marks(state)
  first = score_ed_all(state)[0]
  measure = score_ed_bar_ticks(state)
  marks = {}
  starts = [0]
  pos = 0
  tick = 0
  bar = 0
  pending = {}
  opening = false
  closing = false
  breaking = nil
  for nt in first["notes"]
    set = nt["set"] ?? {}
    if set.keys.length > 0
      if pos == 0
        score_ed_mark(marks, bar)["set"] = score_ed_mark(marks, bar)["set"].merge(set)
        measure = score_ed_measure_of(set["time"]) if set.has_key("time")
      else
        pending = pending.merge(set)
      end
    end
    if nt["rep_start"] == true
      if pos == 0
        score_ed_mark(marks, bar)["rep_start"] = true
      else
        opening = true
      end
    end
    left = score_ed_ticks(nt)
    while left > 0
      take = nt["tup"].nil? ? score_min(left, measure - pos) : left
      pos += take
      left -= take
      tick += take
      closing = true if nt["rep_end"] == true && left == 0
      breaking = nt["brk"] if !nt["brk"].nil? && left == 0
      if pos >= measure
        score_ed_mark(marks, bar)["rep_end"] = closing
        score_ed_mark(marks, bar)["brk"] = breaking
        closing = false
        breaking = nil
        bar += 1
        pos = 0
        starts.push(tick)
        if pending.keys.length > 0
          score_ed_mark(marks, bar)["set"] = pending
          measure = score_ed_measure_of(pending["time"]) if pending.has_key("time")
          pending = {}
        end
        if opening
          score_ed_mark(marks, bar)["rep_start"] = true
          opening = false
        end
      end
    end
  end
  {"marks": marks, "starts": starts, "measure": measure}
end

def score_ed_mark(marks, bar)
  key = str(bar)
  marks[key] = {"set": {}, "rep_start": false, "rep_end": false, "brk": nil} unless marks.has_key(key)
  marks[key]
end

def score_ed_bar_tick(info, b)
  starts = info["starts"]
  return starts[b] if b < starts.length

  starts[-1] + (b - starts.length + 1) * info["measure"]
end

def score_ed_ensemble_end(state, info)
  ends = 0
  for trk in score_ed_all(state)
    total = trk["notes"].reduce(fn(acc, nt) acc + score_ed_ticks(nt), 0)
    b = 0
    while score_ed_bar_tick(info, b) < total
      b += 1
    end
    ends = score_max(ends, score_ed_bar_tick(info, b))
  end
  ends
end

def score_ed_gathered(notes, measure, marks)
  # A metre that changes makes a bar's length a question of where it is;
  # such a part is written bar by bar.
  return notes if marks.values.any? { |mk| (mk["set"] ?? {}).has_key("time") }

  bars = []
  tick = 0
  for nt, ni in notes
    left = nt["pad"] ?? score_ed_ticks(nt)
    if nt.has_key("pad")
      head = tick % measure == 0 ? 0 : score_min(left, measure - tick % measure)
      bars.push({"rest": true, "pitches": [], "base": 1, "dots": 0, "pad": head, "bar": tick / measure}) if head > 0
      left -= head
      tick += head
      while left >= measure
        bars.push({"rest": true, "pitches": [], "base": 1, "dots": 0, "pad": measure, "whole": true, "bar": tick / measure})
        left -= measure
        tick += measure
      end
      bars.push({"rest": true, "pitches": [], "base": 1, "dots": 0, "pad": left, "bar": tick / measure}) if left > 0
      tick += left
      next
    end
    plain = nt["rest"] && nt["tup"].nil? && nt["dyn"].nil? && nt["hairpin"].nil? && nt["hairpin_end"] != true && (nt["texts"] ?? []).length == 0 && (nt["scripts"] ?? []).length == 0
    bars.push(nt.merge({"src": ni, "whole": plain && tick % measure == 0 && left == measure, "bar": tick / measure}))
    tick += left
  end
  out = []
  k = 0
  while k < bars.length
    nt = bars[k]
    run = 0
    while nt["whole"] == true && k + run < bars.length && bars[k + run]["whole"] == true
      here = marks[str(nt["bar"] + run)] ?? {}
      break if run > 0 && (((here["set"] ?? {}).keys.length > 0) || here["rep_start"] == true)

      run += 1
      break if here["rep_end"] == true || !here["brk"].nil?
    end
    if run > 1
      out.push({"rest": true, "mm": run, "src": nt["src"]})
      k += run
      next
    end
    out.push(nt)
    k += 1
  end
  out
end

def score_ed_layout_track(state, k, info, opts)
  trk = score_ed_all(state)[k]
  notes = trk["notes"]
  total = notes.reduce(fn(acc, nt) acc + score_ed_ticks(nt), 0)
  fill = score_ed_ensemble_end(state, info) - total
  notes = notes + [ {"rest": true, "pitches": [], "base": 1, "dots": 0, "pad": fill} ] if fill > 0
  measure = score_ed_bar_ticks(state)
  fifths = score_ed_fifths(state)
  words = []
  if opts["header"] == true
    titles = score_ed_header_ly(state["header"] ?? {})
    words.push(titles) if titles != ""
  end
  words.push("\\clef " + {"Treble": "treble", "Bass": "bass", "Alto": "alto"}[trk["clef"]] + " \\key " + SCORE_ED_KEY_LY[fifths + 7] + " \\major \\time " + state["time"])
  head = words.length
  if opts["tempo"] == true
    tempo_ly = score_ed_tempo_ly(state["tempo_text"] ?? "", state["tempo"], state["mark_tempo"] != false, state["tempo_base"] ?? 4)
    words.push(tempo_ly) if tempo_ly != ""
  end
  owners = []
  pos = 0
  bar = 0
  bar_at = -1
  marks = info["marks"]
  gathering = opts["gather"] == true && score_ed_chunks(measure).length == 1
  if gathering
    notes = score_ed_gathered(notes, measure, marks)
    words.push("\\compressEmptyMeasures") if notes.any? { |nt| !nt["mm"].nil? }
  end
  measure = score_ed_track_marks(words, marks, 0, measure, opts, -1)
  for nt, ni in notes
    # Bars of rest gathered: one word, its count over it.
    unless nt["mm"].nil?
      words.push("R" + score_ed_chunks(measure).map { |ch| str(ch[0]) + (ch[1] > 0 ? "." : "") }.join("") + "*" + str(nt["mm"]))
      owners.push(nt["src"] ?? -1)
      bar += nt["mm"] - 1
      here = marks[str(bar)] ?? {}
      words.push(here["rep_end"] == true ? "\\bar \":|.\"" : "|")
      bar_at = words.length - 1
      bar += 1
      more = ni + 1 < notes.length
      words.push(here["brk"] == "page" ? "\\pageBreak" : "\\break") if !here["brk"].nil? && more
      measure = score_ed_track_marks(words, marks, bar, measure, opts, bar_at) if more
      next
    end
    left = nt["pad"] ?? score_ed_ticks(nt)
    tup = nt["tup"]
    tup_opens = !tup.nil? && (ni == 0 || notes[ni - 1]["tup"].nil? || notes[ni - 1]["tup"]["g"] != tup["g"])
    tup_closes = !tup.nil? && (ni + 1 >= notes.length || notes[ni + 1]["tup"].nil? || notes[ni + 1]["tup"]["g"] != tup["g"])
    words.push("\\tuplet " + str(tup["n"]) + "/" + str(tup["d"]) + " {") if tup_opens
    full = left
    while left > 0
      take = tup.nil? ? score_min(left, measure - pos) : left
      chunks = tup.nil? ? score_ed_chunks(take) : [ [nt["base"], nt["dots"]] ]
      for ch, ci in chunks
        last_piece = left - take == 0 && ci == chunks.length - 1
        word = nt["rest"] ? "r" : score_ed_chord_ly(nt)
        word += str(ch[0]) + (ch[1] > 0 ? "." : "")
        word += " ~" if !nt["rest"] && (!last_piece || nt["tie"] == true)
        word += "(" if nt["slur_on"] == true && left == full && ci == 0
        word += ")" if nt["slur_off"] == true && last_piece
        word += score_ed_expression_ly(nt, left == full && ci == 0, last_piece) unless nt.has_key("pad")
        words.push(word)
        owners.push(nt.has_key("pad") ? -1 : (nt["src"] ?? ni))
      end
      words.push("}") if tup_closes
      pos += take
      left -= take
      if pos >= measure
        here = marks[str(bar)] ?? {}
        words.push(here["rep_end"] == true ? "\\bar \":|.\"" : "|")
        bar_at = words.length - 1
        pos = 0
        bar += 1
        more = left > 0 || ni + 1 < notes.length
        words.push(here["brk"] == "page" ? "\\pageBreak" : "\\break") if !here["brk"].nil? && more
        measure = score_ed_track_marks(words, marks, bar, measure, opts, bar_at) if more
      end
    end
  end
  if notes.length > 0 && pos == 0 && bar_at == words.length - 1
    words[bar_at] = "\\bar \"|.\"" if words[bar_at] == "|"
  elsif notes.length > 0
    words.push("\\bar \"|.\"")
  end
  {"words": words, "map": owners, "head": head}
end

def score_ed_track_marks(words, marks, bar, measure, opts, bar_at)
  here = marks[str(bar)]
  return measure if here.nil?

  set = here["set"]
  if opts["tempo"] != true && set.has_key("tempo")
    kept = {}
    for key in set.keys
      kept[key] = set[key] unless key == "tempo"
    end
    set = kept
  end
  changes = score_ed_changes_ly(set)
  for w in changes["words"]
    words.push(w)
  end
  if here["rep_start"] == true && bar_at >= 0
    words[bar_at] = score_ed_bar_ly(words[bar_at], "|:")
  end
  changes["time"].nil? ? measure : score_ed_measure_of(changes["time"])
end

def score_ed_full_source(state, muting = false)
  # A hundred milliseconds for an orchestra, asked for by several parts of
  # one render: written once per score, on a fingerprint that costs two.
  print_of = str([muting, state["notes"], state["tracks"], state["track"], state["clef"], state["header"], state["group"], state["key"], state["time"], state["tempo"], state["tempo_base"], state["tempo_text"], state["mark_tempo"]])
  known = score_memo_get("ed_full", print_of)
  return known unless known.nil?

  written = score_ed_write_full(state, muting)
  score_memo_put("ed_full", print_of, written, 4)
  written
end

def score_ed_write_full(state, muting)
  tracks = score_ed_all(state)
  return score_ed_layout(state)["src"] if tracks.length < 2

  info = score_ed_bar_marks(state)
  staves = []
  for trk, k in tracks
    music = score_ed_track_music(state, k, info, {"header": false, "tempo": k == 0})["words"].join(" ")
    heard = muting && trk["mute"] == true ? trk.merge({"volume": 0}) : trk
    lyrics = score_ed_lyrics_ly(trk["lyrics"] ?? "")
    staves.push("\\new Staff \\with { " + score_ed_track_with(heard) + "} { " + music + " }" + (lyrics == "" ? "" : " \\addlyrics { " + lyrics + " }"))
  end
  opener = {"Bracket": "\\new StaffGroup ", "Brace": "\\new PianoStaff ", "None": ""}[state["group"] ?? "Bracket"] ?? ""
  titles = score_ed_header_ly(state["header"] ?? {})
  (titles == "" ? "" : titles + " ") + opener + "<< " + staves.join(" ") + " >>"
end

def score_ed_lyrics_ly(text)
  out = text.replace("\n", " ").replace("\r", " ").replace("\t", " ").replace("{", "").replace("}", "").replace("\\", "").replace("\"", "”")
  out.split(" ").filter { |w| w != "" }.join(" ")
end

def score_ed_lyrics_text(sylls)
  return "" if sylls.nil?

  words = []
  for sy in sylls
    words.push(sy["text"] == "" ? "_" : sy["text"])
    words.push("--") if sy["hyphen"] == true
    words.push("__") if sy["extend"] == true
  end
  words.join(" ")
end

def score_ed_lyrics_set(state, text)
  trk = score_ed_tracks(state)[state["track"] ?? 0]
  return state if (trk["lyrics"] ?? "") == text

  at = "lyrics|" + str(state["track"] ?? 0)
  if state["words_at"] != at
    state = score_ed_remember(state)
    state["words_at"] = at
  end
  score_ed_tracks(state)[state["track"] ?? 0]["lyrics"] = text
  state
end

def score_ed_lyrics_count(state)
  trk = score_ed_tracks(state)[state["track"] ?? 0]
  sylls = score_ed_lyrics_ly(trk["lyrics"] ?? "").split(" ").filter { |w| w != "" && w != "--" && w != "__" }.length
  notes = score_ed_v1(state)["notes"]
  takers = 0
  tied = false
  slurred = false
  for nt in notes
    next if nt["rest"]

    takers += 1 unless tied || slurred
    tied = nt["tie"] == true
    slurred = (slurred || nt["slur_on"] == true) && nt["slur_off"] != true
  end
  {"syllables": sylls, "notes": takers}
end

def score_ed_track_with(trk)
  out = ""
  out += "instrumentName = " + score_ed_ly_string(trk["name"]) + " " if trk["name"].trim != ""
  out += "shortInstrumentName = " + score_ed_ly_string(trk["short"]) + " " if (trk["short"] ?? "").trim != ""
  out += "midiInstrument = " + score_ed_ly_string(trk["instrument"] ?? "acoustic grand") + " "
  out += "midiMaximumVolume = #" + score_pdf_num((trk["volume"] ?? 100) / 127.0) + " " if (trk["volume"] ?? 100) != 100
  out += "midiPanPosition = #" + score_pdf_num((trk["pan"] ?? 0) / 100.0) + " " if (trk["pan"] ?? 0) != 0
  out
end

def score_ed_clean(words)
  words.trim.replace("\"", "”")
end

def score_ed_ly_string(words)
  "\"" + words.trim.replace("\"", "'") + "\""
end

def score_ed_select(state, at)
  count = state["notes"].length
  return state if count == 0

  state["sel"] = at.clamp(0, count - 1)
  state["typing"] = false
  state
end

def score_ed_settings(state, which, value)
  return state if value.nil?

  allowed = {"clef": SCORE_ED_CLEFS, "time": SCORE_ED_TIMES, "key": SCORE_ED_KEYS}[which]
  return state unless allowed.includes?(value)

  if state["voice"] == 2 && state["scope"] == SCORE_ED_SCOPES[1] && which != "clef"
    state["error"] = "A change from a bar is the first voice's: switch to Voice 1 (Ctrl+Alt+1)."
    return state
  end
  at = score_ed_scope_at(state, which)
  if at > 0 && score_ed_tracks(state).length > 1 && (state["track"] ?? 0) != 0
    return score_ed_settings_first(state, which, value, at)
  end
  if at <= 0
    return state if state[which] == value

    state = score_ed_remember(state)
    state[which] = value
    return state
  end
  state = score_ed_remember(state)
  opener = state["notes"][at]
  changes = opener["set"] ?? {}
  changes[which] = value
  opener["set"] = changes
  state
end

def score_ed_settings_first(state, which, value, at)
  tick = 0
  for nt, k in state["notes"]
    break if k >= at

    tick += score_ed_ticks(nt)
  end
  first = score_ed_tracks(state)[0]["notes"] ?? []
  pos = 0
  hit = -1
  for nt, k in first
    if pos == tick
      hit = k
      break
    end
    break if pos > tick

    pos += score_ed_ticks(nt)
  end
  if hit < 0
    state["error"] = "The first track has no note starting at that bar to carry the change."
    return state
  end
  state = score_ed_remember_all(state)
  opener = first[hit]
  changes = opener["set"] ?? {}
  changes[which] = value
  opener["set"] = changes
  state["error"] = ""
  state
end

def score_ed_scope_at(state, which)
  return -1 if which == "clef" || state["scope"] != SCORE_ED_SCOPES[1]

  sel = state["sel"] ?? -1
  return -1 if sel < 0

  score_ed_bar_start(state, sel)
end

def score_ed_bar_start(state, idx)
  measure = score_ed_measure_of(state["time"])
  pos = 0
  best = 0
  for nt, k in state["notes"]
    changes = nt["set"] ?? {}
    measure = score_ed_measure_of(changes["time"]) if changes.has_key("time") && pos == 0
    best = k if pos == 0
    break if k >= idx

    pos = (pos + score_ed_ticks(nt)) % measure
  end
  best
end

def score_ed_measure_of(time)
  parts = time.split("/")
  int(parts[0]) * score_whole() / int(parts[1])
end

def score_ed_header_set(state, field, value)
  return state if (state["header"] ?? {})[field] == value

  state = score_ed_remember(state)
  hdr = state["header"] ?? {}
  hdr[field] = value
  state["header"] = hdr
  state
end

def score_ed_clear(state)
  state = score_ed_remember(state)
  state["notes"] = []
  state["sel"] = -1
  state
end

def score_ed_example(state, name)
  state["ex_open"] = false
  state["playing"] = false
  src = score_ed_example_source(name)
  return state if src.nil?

  score_ed_from_source(state, src)
end

def score_ed_example_source(name)
  if name == SCORE_ED_EXAMPLES[0]
    return "\\header { title = \"Frère Jacques\" composer = \"Traditional\" } { \\tempo \"Moderato\" 4 = 100 \\clef treble \\key c \\major \\time 4/4 c'4 d' e' c' c' d' e' c' e' f' g'2 e'4 f' g'2 }"
  end
  return nil unless name == SCORE_ED_EXAMPLES[1]

  File.read("public/scores/beethoven-symphony-5-1.ly") rescue nil
end

def score_ed_tempo(state, bpm, tempo_words, printed)
  return state if bpm < SCORE_ED_BPM[0] || bpm > SCORE_ED_BPM[1]

  state["playing"] = false
  state["play_at"] = -1
  at = state["scope"] == SCORE_ED_SCOPES[1] && (state["sel"] ?? -1) >= 0 ? score_ed_bar_start(state, state["sel"]) : 0
  if at > 0
    state = score_ed_remember(state)
    opener = state["notes"][at]
    changes = opener["set"] ?? {}
    changes["tempo"] = {"bpm": bpm, "text": tempo_words, "base": state["tempo_base"] ?? 4}
    opener["set"] = changes
    return state
  end
  state["tempo"] = bpm
  state["tempo_text"] = tempo_words
  state["mark_tempo"] = printed
  state
end

def score_ed_play(state)
  return score_ed_stop(state) if state["playing"] == true
  return state if state["notes"].length == 0

  several = score_ed_tracks(state).length > 1
  print_of = (several ? score_ed_full_source(state) + str(score_ed_tracks(state).map { |trk| trk["mute"] == true }) : score_ed_layout(state)["src"]) + " @" + str(state["tempo"])
  if state["audio_print"] != print_of
    state["audio"] = eui_asset(score_midi(score_ed_full_source(state, true), score_ed_midi_opts(state)))
    state["starts_tracks"] = score_ed_timing(state)
    state["starts"] = state["starts_tracks"][state["track"] ?? 0]
    state["audio_print"] = print_of
  end
  state["playing"] = true
  state["plays"] = (state["plays"] ?? 0) + 1
  state["play_at"] = 0
  state["play_ms"] = 0
  # Not yet: the window has a MIDI file to fetch and synthesize before the
  # first note sounds — three quarters of a second for a symphony — and a
  # playhead started now ran that far ahead of the music. It starts at the
  # window's first report of where the sound is (`score_ed_playhead`).
  state["play_wall"] = nil
  state["play_shown_ms"] = -1
  score_ed_light_to(state, 0)
end

def score_ed_now()
  DateTime.microtime() / 1000000.0
end

def score_ed_stop(state)
  state["playing"] = false
  state["play_at"] = -1
  state
end

def score_ed_playhead(state, payload)
  return state unless state["playing"] == true

  state["play_ms"] = payload[0] ?? 0
  state["play_wall"] = score_ed_now()
  score_ed_light_to(state, state["play_ms"])
end

def score_ed_play_tick(state)
  return state unless state["playing"] == true && !state["play_wall"].nil?

  # Carried on from the last report, never more than 600 ms past it: a
  # window that stopped reporting has stopped playing too.
  ahead = score_min(600.0, (score_ed_now() - state["play_wall"]) * 1000.0)
  score_ed_light_to(state, state["play_ms"] + int(ahead))
end

def score_ed_light_to(state, at)
  shown_to = state["play_shown_ms"] ?? -1
  return state if at <= shown_to

  starts_tracks = state["starts_tracks"] ?? [state["starts"] ?? []]
  lit_tracks = []
  for starts, k in starts_tracks
    lit = []
    for start, j in starts
      lit.push(j) if start > shown_to && start <= at
    end
    now_on = score_ed_lit_at(starts_tracks, k, at)
    lit.push(now_on) if now_on >= 0 && !lit.includes?(now_on)
    lit_tracks.push(lit)
  end
  state["play_lit"] = lit_tracks
  state["play_shown_ms"] = at
  state["play_at"] = score_ed_lit_at(starts_tracks, state["track"] ?? 0, at)
  state
end

def score_ed_lit_at(starts_tracks, k, at)
  return -1 if k >= starts_tracks.length

  idx = -1
  for start, j in starts_tracks[k]
    idx = j if start <= at
  end
  idx
end

def score_ed_tempo_map(notes, state)
  out = [ [0, state["tempo"], state["tempo_base"] ?? 4] ]
  tick = 0
  for nt in notes
    change = (nt["set"] ?? {})["tempo"]
    out.push([tick, change["bpm"], change["base"] ?? 4]) unless change.nil?
    tick += score_ed_ticks(nt)
  end
  out
end

def score_ed_tempo_at(tempos, tick)
  beat = [tempos[0][1], tempos[0][2]]
  for t in tempos
    beat = [t[1], t[2]] if t[0] <= tick
  end
  beat
end

def score_ed_midi_opts(state)
  first = score_ed_tracks(state)[0]
  {"bpm": state["tempo"], "beat": state["tempo_base"] ?? 4, "program": SCORE_MIDI_PROGRAMS[first["instrument"] ?? "acoustic grand"] ?? 0}
end

def score_ed_timing(state)
  tracks = score_ed_all(state)
  tempos = score_ed_tempo_map(tracks[0]["notes"], state)
  holds = score_ed_holds(tracks)
  out = []
  for trk in tracks
    starts = []
    clock_ms = 0.0
    tick = 0
    next_hold = 0
    for nt in trk["notes"]
      # The fermatas ended by now hold every staff, as the MIDI file does.
      while next_hold < holds.length && holds[next_hold][0] <= tick
        beat = score_ed_tempo_at(tempos, holds[next_hold][0])
        clock_ms += score_ed_ticks_ms(beat[0], beat[1], holds[next_hold][1])
        next_hold += 1
      end
      starts.push(int(clock_ms))
      beat = score_ed_tempo_at(tempos, tick)
      clock_ms += score_ed_note_ms(beat[0], beat[1], nt)
      tick += score_ed_ticks(nt)
    end
    out.push(starts)
  end
  out
end

def score_ed_holds(tracks)
  by_end = {}
  for trk in tracks
    tick = 0
    for nt in trk["notes"]
      length = score_ed_ticks(nt)
      held = !nt["rest"] && (nt["scripts"] ?? []).any? { |sc| sc["name"] == "fermata" }
      by_end[str(tick + length)] = score_max(by_end[str(tick + length)] ?? 0, length) if held
      tick += length
    end
  end
  by_end.keys.map { |k| [int(k), by_end[k]] }.sort_by { |h| h[0] }
end

def score_ed_ticks_ms(bpm, beat_base, ticks)
  quarter_ms = 60000.0 / bpm * beat_base / 4.0
  ticks * quarter_ms / (score_whole() / 4.0)
end

def score_ed_blip(state, nt)
  return state unless state["sound"] == true
  return state if nt["rest"]

  trk = score_ed_tracks(state)[state["track"] ?? 0]
  cmds = [ [0, 192, SCORE_MIDI_PROGRAMS[trk["instrument"] ?? "acoustic grand"] ?? 0, 0] ]
  for pt in nt["pitches"]
    key = score_ed_midi_key(pt)
    cmds.push([0, 144, key, 100])
    cmds.push([450, 128, key, 0])
  end
  state["blip_notes"] = cmds
  state["blips"] = (state["blips"] ?? 0) + 1
  state
end

def score_ed_soundfont()
  unless SCORE_MEMO.has_key("ed_soundfont")
    parts = []
    k = 0
    while File.exists("public/soundfonts/GeneralUser-GS.sf2." + str(k))
      parts.push("public/soundfonts/GeneralUser-GS.sf2." + str(k))
      k += 1
    end
    SCORE_MEMO["ed_soundfont"] = parts
  end
  SCORE_MEMO["ed_soundfont"]
end

def score_ed_sounds(state)
  bank = score_ed_soundfont()
  out = []
  if !state["audio"].nil? && state["playing"] == true
    out.push({"k": "audio", "key": "song:" + str(state["plays"] ?? 0), "p": {"src": state["audio"], "playing": true, "soundfont": bank, "wake": 100}, "on": {"time_update": "playhead", "ended": "ended", "wake": "play_tick"}})
  end
  player = {"soundfont": bank, "notes_seq": state["blips"] ?? 0}
  player["notes"] = state["blip_notes"] if !state["blip_notes"].nil? && state["sound"] == true
  out.push({"k": "audio", "key": "notes", "p": player})
  out
end

def score_ed_screen_page()
  1100
end

def score_ed_page_shown(state, engraved, which)
  score_max(0, score_min(engraved["pages"].length - 1, state[which] ?? 0))
end

def score_ed_page_height(engraved, shown, sp)
  bottom = 0.0
  for sys in engraved["systems"]
    bottom = sys["bottom"] if (sys["page"] ?? 0) == shown && sys["bottom"] > bottom
  end
  int((bottom + 3.0) * sp)
end

def score_ed_pager(state, which, count)
  return nil if count < 2

  shown = score_max(0, score_min(count - 1, state[which] ?? 0))
  row({"gap": 2, "align": "center"}, [
    score_ed_tool("◀ Previous", "page_to", {"which": which, "to": shown - 1}, shown == 0, nil),
    text("Page " + str(shown + 1) + " of " + str(count), {"size": 1, "weight": "medium"}),
    score_ed_tool("Next ▶", "page_to", {"which": which, "to": shown + 1}, shown + 1 >= count, nil)
  ])
end

def score_ed_full_view(state)
  state["full_view"] == true && score_ed_tracks(state).length > 1
end

def score_ed_full_on(state)
  state = score_ed_set_voice(state, 1)
  state["tool"] = SCORE_ED_TOOLS[0]
  score_ed_flag(state, "full_view", true)
end

def score_ed_conductor_big(state)
  count = 0
  for trk in score_ed_all(state)
    count += trk["notes"].length
  end
  count > 600
end

def score_ed_conductor_engraved(state, full)
  sp = score_ed_full_space(state)
  score_layout(full["src"], float(score_ed_width(state)) / sp, {"page_h": score_ed_screen_page() / sp})
end

def score_ed_page_of(engraved, map, owner)
  best = nil
  best_owner = -1
  for sys in engraved["systems"]
    for bar in sys["bars"]
      for ev in bar["items"]
        k = ev["i"]
        next if k.nil? || k >= map.length

        here = map[k]
        return sys["page"] ?? 0 if here == owner
        if here >= 0 && here < owner && here > best_owner
          best_owner = here
          best = sys["page"] ?? 0
        end
      end
    end
  end
  best
end

def score_ed_follow(state)
  lit = state["playing"] == true ? (state["play_at"] ?? -1) : (state["sel"] ?? -1)
  key = str(lit) + "|" + str(state["track"] ?? 0)
  return state if lit < 0 || key == state["page_lit"]

  state["page_lit"] = key
  drawn = score_ed_engrave(state)
  return state if drawn["engraved"].nil?

  on = score_ed_page_of(drawn["engraved"], drawn["map"], lit)
  state["page"] = on unless on.nil?
  return state unless score_ed_full_view(state)

  full = score_ed_conductor(state)
  try
    on = score_ed_cond_page_of(score_ed_conductor_engraved(state, full), full, state["track"] ?? 0, lit)
    state["cond_page"] = on unless on.nil?
  catch e
    return state
  end
  state
end

def score_ed_cond_page_of(cond, full, active, lit)
  first = full["firsts"][active]
  owners = full["maps"][active]
  for sys in cond["systems"]
    staves = sys["staves"] ?? []
    next if active >= staves.length

    for bar in staves[active]["bars"]
      for ev in bar["items"]
        j = ev["i"] - first
        return sys["page"] ?? 0 if j >= 0 && j < owners.length && owners[j] == lit
      end
    end
  end
  nil
end

def score_ed_conductor(state)
  print_of = str([state["notes"], state["tracks"], state["track"], state["clef"], state["header"], state["group"], state["key"], state["time"], state["tempo"], state["tempo_base"], state["tempo_text"], state["mark_tempo"]])
  known = score_memo_get("ed_cond", print_of)
  return known unless known.nil?

  laid = score_ed_lay_conductor(state)
  score_memo_put("ed_cond", print_of, laid, 4)
  laid
end

def score_ed_lay_conductor(state)
  info = score_ed_bar_marks(state)
  maps = []
  firsts = []
  count = 0
  for trk, k in score_ed_all(state)
    laid = score_ed_track_music(state, k, info, {"header": false, "tempo": k == 0})
    firsts.push(count)
    maps.push(laid["map"])
    count += laid["map"].length
  end
  {"src": score_ed_full_source(state), "maps": maps, "firsts": firsts}
end

def score_ed_conductor_pick(state, point)
  full = score_ed_conductor(state)
  sp = score_ed_full_space(state)
  engraved = nil
  try
    engraved = score_ed_conductor_engraved(state, full)
  catch e
    return state
  end
  shown = score_ed_page_shown(state, engraved, "cond_page")
  xs = float(point[0]) / sp
  ys = float(point[1]) / sp
  best = nil
  best_k = 0
  on_page = engraved["systems"].filter { |sy| (sy["page"] ?? 0) == shown }
  for sys in on_page
    for ss, k in sys["staves"] ?? []
      mid = sys["top"] + sys["offsets"][k] + 2.0
      if best.nil? || (ys - mid).abs < (ys - best["mid"]).abs
        best = {"mid": mid, "staff": ss}
        best_k = k
      end
    end
  end
  return state if best.nil?

  hit = nil
  for bar in best["staff"]["bars"]
    for ev in bar["items"]
      mid_x = ev["x"] + (ev["head_w"] ?? 1.18) / 2.0
      hit = ev if hit.nil? || (xs - mid_x).abs < (xs - hit["x"] - (hit["head_w"] ?? 1.18) / 2.0).abs
    end
  end
  state = score_ed_switch(state, best_k)
  return state if hit.nil?

  j = hit["i"] - full["firsts"][best_k]
  note = j >= 0 && j < full["maps"][best_k].length ? full["maps"][best_k][j] : -1
  state["sel"] = note if note >= 0
  state["typing"] = false
  state
end

def score_ed_conductor_marks(state, full)
  marks = {}
  playing = state["playing"] == true
  active = state["track"] ?? 0
  for owners, k in full["maps"]
    lit_set = playing ? ((state["play_lit"] ?? [])[k] ?? []) : (k == active && (state["sel"] ?? -1) >= 0 ? [state["sel"]] : [])
    next if lit_set.length == 0

    for owner, j in owners
      marks[str(full["firsts"][k] + j)] = "accent.base" if owner >= 0 && lit_set.includes?(owner)
    end
  end
  marks
end

def score_ed_note_ms(bpm, beat_base, nt)
  quarter_ms = 60000.0 / bpm * beat_base / 4.0
  score_ed_ticks(nt) * quarter_ms / (score_whole() / 4.0)
end

def score_ed_midi_key(pt)
  score_max(0, score_min(127, 12 * (pt["oct"] + 1) + [0, 2, 4, 5, 7, 9, 11][pt["step"]] + pt["alter"]))
end

def score_ed_key(state, key, mods)
  ctrl = mods % 4 >= 2 || mods % 16 >= 8
  lower = key.downcase()
  # A capital is a shifted letter whatever the modifiers say: some
  # keyboards report the shift only in the character.
  shift = mods % 2 == 1 || (key.length == 1 && key != lower)
  # Alt+↑ / Alt+↓: the track above or below.
  alt = (mods / 4) % 2 == 1
  return score_ed_switch(state, (state["track"] ?? 0) - 1) if alt && key == "ArrowUp"
  return score_ed_switch(state, (state["track"] ?? 0) + 1) if alt && key == "ArrowDown"

  if ctrl
    return score_ed_set_voice(state, 1) if alt && key == "1" && !score_ed_full_view(state)
    return score_ed_set_voice(state, 2) if alt && key == "2" && !score_ed_full_view(state)
    return score_ed_tuplet(state, 3) if key == "3"
    return score_ed_tuplet(state, 6) if key == "6"
    return score_ed_redo(state) if lower == "y" || (lower == "z" && shift)
    return score_ed_undo(state) if lower == "z"
    return score_ed_move_pitch(state, 7) if key == "ArrowUp"
    return score_ed_move_pitch(state, -7) if key == "ArrowDown"

    return state
  end
  return score_ed_flag(state, "tool", score_ed_inserting(state) ? SCORE_ED_TOOLS[0] : SCORE_ED_TOOLS[1]) if lower == "n" && !score_ed_full_view(state)
  step = "cdefgab".index_of(lower)
  return score_ed_insert(state, step, shift) if key.length == 1 && step >= 0
  return score_ed_insert_rest(state) if lower == "r" || key == "0"

  digit = "234567".index_of(key)
  return score_ed_duration(state, [32, 16, 8, 4, 2, 1][digit]) if key.length == 1 && digit >= 0
  return score_ed_dot(state) if key == "."
  return score_ed_alter(state, 1, false) if key == "+" || key == "#"
  return score_ed_alter(state, -1, false) if key == "-"
  return score_ed_alter(state, 0, true) if key == "="
  return score_ed_tie(state) if lower == "t"
  return score_ed_slur(state) if lower == "s"
  return score_ed_hairpin(state, key) if key == "<" || key == ">"
  return score_ed_repeat(state, "rep_start") if key == "["
  return score_ed_repeat(state, "rep_end") if key == "]"
  return score_ed_play(state) if key == " "
  return score_ed_semitone(state, 1) if shift && key == "ArrowUp"
  return score_ed_semitone(state, -1) if shift && key == "ArrowDown"
  return score_ed_move_pitch(state, 1) if key == "ArrowUp"
  return score_ed_move_pitch(state, -1) if key == "ArrowDown"
  return score_ed_select(state, (state["sel"] ?? 0) - 1) if key == "ArrowLeft"
  return score_ed_select(state, (state["sel"] ?? -1) + 1) if key == "ArrowRight"
  return score_ed_select(state, 0) if key == "Home"
  return score_ed_select(state, state["notes"].length - 1) if key == "End"
  return score_ed_delete(state, true) if key == "Backspace"
  return score_ed_delete(state, false) if key == "Delete"
  return score_ed_flag(state, "tool", SCORE_ED_TOOLS[0]) if key == "Escape" && score_ed_inserting(state)
  return score_ed_flag(score_ed_flag(state, "sel", -1), "typing", false) if key == "Escape"

  state
end

def score_ed_chord_ms()
  30
end

def score_ed_midi_in(state, messages)
  chords = []
  last_t = -1000000
  for m in messages
    next unless m.is_a?("array") && m.length == 4

    status = m[1]
    on = status >= 144 && status < 160 && m[3] > 0
    next unless on

    if chords.length == 0 || m[0] - last_t > score_ed_chord_ms()
      chords.push([m[2]])
    else
      chords[-1].push(m[2])
    end
    last_t = m[0]
  end
  for keys in chords
    state = score_ed_play_chord(state, keys)
  end
  state
end

def score_ed_play_chord(state, keys)
  pitches = []
  for key in keys.sort()
    spelled = score_ed_spell(state, key, 1)
    pt = {"step": spelled[0], "alter": spelled[1], "oct": spelled[2]}
    pitches.push(pt) if score_ed_fits(state, pt) && !pitches.any? { |p| p["step"] == pt["step"] && p["oct"] == pt["oct"] }
  end
  return state if pitches.length == 0

  state = score_ed_remember(state)
  fresh = score_ed_note(pitches[0]["step"], pitches[0]["oct"], pitches[0]["alter"], state["dur"], state["dot"] ? 1 : 0)
  fresh["pitches"] = pitches
  score_ed_place(state, fresh)
end

def score_ed_pick(state, point, page)
  drawn = score_ed_engrave(state)
  return state if drawn["engraved"].nil?

  sp = drawn["sp"]
  xs = float(point[0]) / sp
  ys = float(point[1]) / sp
  every = drawn["engraved"]["systems"]
  systems = every.filter { |sy| (sy["page"] ?? 0) == page }
  return state if systems.length == 0

  best_sys = systems[0]
  for sys in systems
    best_sys = sys if (ys - sys["top"] - 2.0).abs < (ys - best_sys["top"] - 2.0).abs
  end
  state["drag_top"] = best_sys["top"]
  pitch = score_ed_pitch_at(state, score_ed_pos_at(ys, best_sys["top"]))
  hit = nil
  hit_gap = 99.0
  last_x = 0.0
  for bar in best_sys["bars"]
    for ev in bar["items"]
      mid = ev["x"] + (ev["head_w"] ?? 1.18) / 2.0
      last_x = ev["x"] if ev["x"] > last_x
      if (xs - mid).abs < hit_gap
        hit_gap = (xs - mid).abs
        hit = ev
      end
    end
  end
  is_last_sys = best_sys["bars"][-1]["number"] == every[-1]["bars"][-1]["number"]
  # Past the last note of the score: a new note at the pitch under the
  # pointer.
  if is_last_sys && (hit.nil? || xs > last_x + 2.5) && state["voice"] != 2
    state["sel"] = -1
    state = score_ed_insert(state, pitch["step"], false)
    current = score_ed_selected(state)
    current["pitches"] = [pitch]
    return state
  end
  return state if hit.nil? || hit_gap > 2.0

  model = drawn["map"][hit["i"]]
  if state["sel"] == model
    return score_ed_set_pitch(state, pitch)
  end
  state["sel"] = model
  state["typing"] = false
  state
end

def score_ed_pos_at(ys, top)
  int(((2.0 - (ys - top)) * 2.0).round(0))
end

def score_ed_press(state, point, page)
  return score_ed_insert_at(state, point, page) if score_ed_inserting(state)

  state = score_ed_pick(state, point, page)
  current = score_ed_selected(state)
  state["dragging"] = !current.nil?
  state["drag_saved"] = false
  state
end

def score_ed_inserting(state)
  state["tool"] == SCORE_ED_TOOLS[1]
end

def score_ed_insert_at(state, point, page)
  state["dragging"] = false
  drawn = score_ed_engrave(state)
  return state if drawn["engraved"].nil?

  sp = drawn["sp"]
  xs = float(point[0]) / sp
  ys = float(point[1]) / sp
  systems = drawn["engraved"]["systems"].filter { |sy| (sy["page"] ?? 0) == page }
  return state if systems.length == 0

  best_sys = systems[0]
  for sys in systems
    best_sys = sys if (ys - sys["top"] - 2.0).abs < (ys - best_sys["top"] - 2.0).abs
  end
  pitch = score_ed_within(state, score_ed_pitch_at(state, score_ed_pos_at(ys, best_sys["top"])))
  map = drawn["map"]
  at = -1
  last = -1
  on = -1
  on_gap = 1.0
  for bar in best_sys["bars"]
    for ev in bar["items"]
      next if ev["i"] >= map.length

      owner = map[ev["i"]]
      next if owner < 0

      last = owner if owner > last
      mid = ev["x"] + (ev["head_w"] ?? 1.18) / 2.0
      at = owner if at < 0 && mid > xs
      if (xs - mid).abs <= on_gap
        on_gap = (xs - mid).abs
        on = owner
      end
    end
  end
  notes = state["notes"]
  return score_ed_insert_onto(state, on, pitch) if on >= 0 && on < notes.length
  return score_ed_write_at_tick(state, score_ed_tick_at(state, drawn, best_sys, xs), pitch) if state["voice"] == 2

  at = last + 1 if at < 0
  at = notes.length if at > notes.length
  state = score_ed_remember(state)
  fresh = score_ed_note(pitch["step"], pitch["oct"], pitch["alter"], state["dur"], state["dot"] ? 1 : 0)
  state["notes"] = notes.take(at) + [fresh] + range(at, notes.length).map { |k| notes[k] }
  state["sel"] = at
  state["typing"] = true
  score_ed_blip(state, fresh)
end

def score_ed_tick_at(state, drawn, sys, xs)
  map1 = drawn["map1"] ?? drawn["map"]
  first = score_ed_v1(state)["notes"]
  best = -1
  gap = 0.0
  for bar in sys["bars"]
    for ev in bar["items"]
      next if ev["i"] >= map1.length

      owner = map1[ev["i"]]
      next if owner < 0

      d = (xs - ev["x"] - (ev["head_w"] ?? 1.18) / 2.0).abs
      if best < 0 || d < gap
        best = owner
        gap = d
      end
    end
  end
  return 0 if best < 0

  first.take(best).reduce(fn(acc, nt) acc + score_ed_ticks(nt), 0)
end

def score_ed_write_at_tick(state, tick, pitch)
  notes = state["notes"]
  start = 0
  k = 0
  while k < notes.length && start + score_ed_ticks(notes[k]) <= tick
    start += score_ed_ticks(notes[k])
    k += 1
  end
  value = {"base": state["dur"], "dots": state["dot"] ? 1 : 0}
  if k >= notes.length && tick > start
    state["notes"] = notes + score_ed_chunks(tick - start).map { |c| {"rest": true, "spacer": true, "pitches": [], "base": c[0], "dots": c[1], "tie": false} }
    k = state["notes"].length
  elsif k < notes.length && start < tick && notes[k]["rest"] && notes[k]["tup"].nil?
    was = notes[k]
    piece = fn(t) { score_ed_chunks(t).map { |c| {"rest": true, "spacer": was["spacer"] == true, "pitches": [], "base": c[0], "dots": c[1], "tie": false} } }
    before = piece(tick - start)
    after = piece(start + score_ed_ticks(was) - tick)
    state["notes"] = notes.take(k) + before + after + range(k + 1, notes.length).map { |j| notes[j] }
    k += before.length
  end
  score_ed_write_over(state, k, pitch, value)
end

def score_ed_insert_onto(state, k, pitch)
  target = state["notes"][k]
  value = {"base": state["dur"], "dots": state["dot"] ? 1 : 0}
  if score_ed_ticks(value) != score_ed_ticks(target)
    return score_ed_write_over(state, k, pitch, value) if target["rest"] || (state["voice"] ?? 1) == 2

    tick = state["notes"].take(k).reduce(fn(acc, nt) acc + score_ed_ticks(nt), 0)
    return score_ed_write_at_tick(score_ed_set_voice(state, 2), tick, pitch)
  end

  want = pitch["oct"] * 7 + pitch["step"]
  had = !target["rest"] && target["pitches"].any? { |pt| pt["oct"] * 7 + pt["step"] == want }
  state["sel"] = k
  state["typing"] = false
  return state if had

  state = score_ed_remember(state)
  target = state["notes"][k]
  if target["rest"]
    target["rest"] = false
    target["pitches"] = [pitch]
    # A rest the editor put there to fill a bar is the person's note now,
    # and no longer one a trim may take away.
    target.delete("auto") if target.has_key("auto")
  else
    target["pitches"] = (target["pitches"] + [pitch]).sort_by { |pt| pt["oct"] * 7 + pt["step"] }
  end
  score_ed_blip(state, target)
end

def score_ed_write_over(state, k, pitch, value)
  notes = state["notes"]
  need = score_ed_ticks(value)
  covered = 0
  stop = k
  while stop < notes.length && covered < need
    if !notes[stop]["tup"].nil?
      state["error"] = "A note written over a tuplet would break it: change the tuplet's notes one by one."
      return state
    end
    covered += score_ed_ticks(notes[stop])
    stop += 1
  end
  state = score_ed_remember(state)
  notes = state["notes"]
  # Past the end (a second voice written further than it went) there is
  # nothing under the note to carry over.
  first = k < notes.length ? notes[k] : {}
  last = stop > k ? notes[stop - 1] : {}
  fresh = score_ed_note(pitch["step"], pitch["oct"], pitch["alter"], value["base"], value["dots"])
  # What belongs to the moment the note starts stays with it: a change of
  # key or metre, a repeat, a dynamic, words.
  for field in ["set", "rep_start", "dyn", "texts"]
    fresh[field] = first[field] if first.has_key(field) && !first[field].nil?
  end
  quiet = range(k, stop).all? { |j| notes[j]["spacer"] == true }
  rests = score_ed_chunks(score_max(0, covered - need)).map { |c| {"rest": true, "spacer": quiet && stop > k, "pitches": [], "base": c[0], "dots": c[1], "tie": false} }
  written = [fresh] + rests
  # And what belongs to where the last one ended: a repeat's end, a break.
  for field in ["rep_end", "brk"]
    written[-1][field] = last[field] if last.has_key(field) && !last[field].nil?
  end
  state["notes"] = notes.take(k) + written + range(stop, notes.length).map { |j| notes[j] }
  state["sel"] = k
  state["typing"] = false
  score_ed_blip(state, fresh)
end

def score_ed_drag(state, point)
  return state unless state["dragging"] == true

  current = score_ed_selected(state)
  return state if current.nil? || state["drag_top"].nil?

  sp = score_ed_engrave(state)["sp"]
  pitch = score_ed_pitch_at(state, score_ed_pos_at(float(point[1]) / sp, state["drag_top"]))
  want = pitch["oct"] * 7 + pitch["step"]
  return state if !current["rest"] && current["pitches"].any? { |pt| pt["oct"] * 7 + pt["step"] == want }

  state = score_ed_remember(state) unless state["drag_saved"] == true
  state["drag_saved"] = true
  score_ed_place_pitch(state, pitch)
end

def score_ed_pitch_at(state, pos)
  d = pos.clamp(0 - score_ed_reach(), score_ed_reach()) + score_clef_mid(score_ed_clef(state))
  step = score_mod(d, 7)
  octave = (d - step) / 7 + 3
  {"step": step, "oct": octave, "alter": score_ed_key_alter(state, step)}
end

def score_ed_set_pitch(state, pitch)
  score_ed_place_pitch(score_ed_remember(state), pitch)
end

def score_ed_place_pitch(state, pitch)
  current = score_ed_selected(state)
  if current["rest"]
    current["rest"] = false
    current["pitches"] = [pitch]
    return state
  end
  want = pitch["oct"] * 7 + pitch["step"]
  nearest = 0
  for pt, k in current["pitches"]
    here = pt["oct"] * 7 + pt["step"]
    there = current["pitches"][nearest]["oct"] * 7 + current["pitches"][nearest]["step"]
    nearest = k if (here - want).abs < (there - want).abs
  end
  current["pitches"][nearest] = pitch
  current["pitches"] = current["pitches"].sort_by { |pt| pt["oct"] * 7 + pt["step"] }
  score_ed_blip(state, current)
end

def score_ed_clef(state)
  {"Treble": "treble", "Bass": "bass", "Alto": "alto"}[state["clef"]] ?? "treble"
end

def score_ed_bar_ticks(state)
  score_ed_measure_of(state["time"])
end

def score_ed_ticks(nt)
  t = score_whole() / nt["base"]
  t += nt["dots"] > 0 ? t / 2 : 0
  tup = nt["tup"]
  tup.nil? ? t : t * tup["d"] / tup["n"]
end

def score_ed_chunks(ticks)
  out = []
  left = ticks
  while left >= score_whole() / 32
    best = nil
    for base in [1, 2, 4, 8, 16, 32]
      t = score_whole() / base
      if best.nil? && base < 32 && t + t / 2 <= left
        best = [base, 1]
      end
      if best.nil? && t <= left
        best = [base, 0]
      end
    end
    out.push(best)
    t = score_whole() / best[0]
    left -= best[1] > 0 ? t + t / 2 : t
  end
  out
end

def score_ed_pitch_ly(pt)
  name = "cdefgab".chars()[pt["step"]]
  alter = pt["alter"]
  suffix = ""
  suffix = "is" if alter == 1
  suffix = "isis" if alter == 2
  if alter < 0
    suffix = alter == -1 ? "es" : "eses"
    suffix = alter == -1 ? "s" : "ses" if name == "e" || name == "a"
  end
  marks = pt["oct"] - 3
  out = name + suffix
  out += "'" * marks if marks > 0
  out += "," * -marks if marks < 0
  out
end

def score_ed_layout(state)
  base = score_ed_v1(state)
  voiced = score_ed_voiced?(base["notes2"])
  base = base.merge({"no_gather": true}) if voiced
  info = score_ed_bar_marks(base)
  laid = nil
  if score_ed_tracks(state).length < 2
    laid = score_ed_layout_one(base)
  else
    laid = score_ed_layout_track(base, state["track"] ?? 0, info, {"header": true, "tempo": true, "gather": !voiced})
  end
  both = score_ed_with_voice_two(base, laid, base["notes2"], info, score_ed_tracks(state).length > 1)
  # `map` is the voice being edited's — what a click picks — and `map1`
  # the first voice's, what the playhead lights.
  src = score_ed_with_lyrics(both["words"], score_ed_lyrics_ly(score_ed_tracks(state)[state["track"] ?? 0]["lyrics"] ?? ""))
  {"src": src, "map": state["voice"] == 2 ? both["map2"] : both["map"], "map1": both["map"]}
end

def score_ed_with_lyrics(words, lyrics)
  return words.join(" ") if lyrics == ""

  titled = words.length > 0 && words[0].starts_with?("\\header")
  head = titled ? [words[0]] : []
  body = titled ? words.drop(1) : words
  (head + ["{"] + body + ["}", "\\addlyrics {", lyrics, "}"]).join(" ")
end

def score_ed_with_voice_two(base, laid, notes2, info, ensemble)
  map1 = laid["map"]
  unless score_ed_voiced?(notes2)
    return {"words": laid["words"], "map": map1, "map2": map1.map { |o| -1 }}
  end
  total = base["notes"].reduce(fn(acc, nt) acc + score_ed_ticks(nt), 0)
  total = score_max(total, score_ed_ensemble_end(base, info)) if ensemble
  two = score_ed_voice_two_ly(notes2, info, total)
  words = laid["words"]
  head = laid["head"]
  out = words.take(head) + ["<< {"] + range(head, words.length).map { |k| words[k] } + ["} \\\\ {"] + two["words"] + ["} >>"]
  {"words": out, "map": map1 + two["map"].map { |o| -1 }, "map2": map1.map { |o| -1 } + two["map"]}
end

def score_ed_voice_two_ly(notes2, info, total)
  words = []
  owners = []
  have = notes2.reduce(fn(acc, nt) acc + score_ed_ticks(nt), 0)
  notes = notes2
  notes = notes + [ {"rest": true, "spacer": true, "pitches": [], "base": 1, "dots": 0, "pad": total - have} ] if have < total
  tick = 0
  bar = 0
  for nt, ni in notes
    break if tick >= total

    left = score_min(nt["pad"] ?? score_ed_ticks(nt), total - tick)
    full = left
    tup = nt["tup"]
    tup_opens = !tup.nil? && (ni == 0 || notes[ni - 1]["tup"].nil? || notes[ni - 1]["tup"]["g"] != tup["g"])
    tup_closes = !tup.nil? && (ni + 1 >= notes.length || notes[ni + 1]["tup"].nil? || notes[ni + 1]["tup"]["g"] != tup["g"])
    words.push("\\tuplet " + str(tup["n"]) + "/" + str(tup["d"]) + " {") if tup_opens
    while left > 0
      room = score_ed_bar_tick(info, bar + 1) - tick
      take = tup.nil? ? score_min(left, room) : left
      chunks = tup.nil? ? score_ed_chunks(take) : [ [nt["base"], nt["dots"]] ]
      for ch, ci in chunks
        last_piece = left - take == 0 && ci == chunks.length - 1
        word = nt["spacer"] == true ? "s" : (nt["rest"] ? "r" : score_ed_chord_ly(nt))
        word += str(ch[0]) + (ch[1] > 0 ? "." : "")
        word += " ~" if !nt["rest"] && (!last_piece || nt["tie"] == true)
        word += "(" if nt["slur_on"] == true && left == full && ci == 0
        word += ")" if nt["slur_off"] == true && last_piece
        word += score_ed_expression_ly(nt, left == full && ci == 0, last_piece) unless nt.has_key("pad") || nt["spacer"] == true
        words.push(word)
        owners.push(nt.has_key("pad") ? -1 : ni)
      end
      words.push("}") if tup_closes
      tick += take
      left -= take
      while tick >= score_ed_bar_tick(info, bar + 1)
        bar += 1
        words.push("|")
      end
    end
  end
  {"words": words, "map": owners}
end

def score_ed_track_music(state, k, info, opts)
  base = score_ed_v1(state)
  trk = score_ed_all(base)[k]
  voiced = score_ed_voiced?(trk["notes2"])
  laid = score_ed_layout_track(base, k, info, voiced ? opts.merge({"gather": false}) : opts)
  both = score_ed_with_voice_two(base.merge({"notes": trk["notes"]}), laid, trk["notes2"], info, true)
  {"words": both["words"], "map": both["map"]}
end

def score_ed_layout_one(state)
  measure = score_ed_bar_ticks(state)
  fifths = score_ed_fifths(state)
  head_ly = "\\clef " + score_ed_clef(state) + " \\key " + SCORE_ED_KEY_LY[fifths + 7] + " \\major \\time " + state["time"]
  words = []
  titles = score_ed_header_ly(state["header"] ?? {})
  words.push(titles) if titles != ""
  words.push(head_ly)
  head_at = words.length
  tempo_ly = score_ed_tempo_ly(state["tempo_text"] ?? "", state["tempo"], state["mark_tempo"] != false, state["tempo_base"] ?? 4)
  words.push(tempo_ly) if tempo_ly != ""
  owners = []
  pos = 0
  # The bar line last written, so a start repeat on the next note can turn
  # it into one; and an end repeat waiting for the line its bar ends on.
  bar_at = -1
  closing = false
  breaking = nil
  opening = false
  gather_from = -1
  gathered = false
  # A change is written where its bar starts. One on a note that no longer
  # starts a bar — a note before it got longer — waits for the next bar
  # line rather than break the engraving.
  waiting = []
  waiting_time = nil
  for nt, ni in state["notes"]
    next if ni < gather_from

    changes = score_ed_changes_ly(nt["set"] ?? {})
    opening = true if nt["rep_start"] == true
    if opening && pos == 0 && bar_at >= 0 && bar_at == words.length - 1
      words[bar_at] = score_ed_bar_ly(words[bar_at], "|:")
      opening = false
    elsif opening && pos == 0 && owners.length == 0
      # A repeat from the very start: no bar line comes before it to carry
      # the sign, so it is written on its own, and drawn after the clef,
      # key and time as LilyPond draws it.
      words.push("\\bar \".|:\"")
      opening = false
    end
    if changes["words"].length > 0
      if pos == 0
        words = words + changes["words"]
        measure = score_ed_measure_of(changes["time"]) unless changes["time"].nil?
      else
        waiting = waiting + changes["words"]
        waiting_time = changes["time"] unless changes["time"].nil?
      end
    end
    # Bars of rest in a row, written as one: R1*4.
    run = score_ed_rest_run(state, ni, pos, measure)
    if run > 1
      words.push("R" + score_ed_chunks(measure).map { |ch| str(ch[0]) + (ch[1] > 0 ? "." : "") }.join("") + "*" + str(run) + score_ed_expression_ly(nt, true, true))
      owners.push(ni)
      gather_from = ni + run
      gathered = true
      words.push(state["notes"][ni + run - 1]["rep_end"] == true ? "\\bar \":|.\"" : "|")
      bar_at = words.length - 1
      brk = state["notes"][ni + run - 1]["brk"]
      words.push(brk == "page" ? "\\pageBreak" : "\\break") if !brk.nil? && ni + run < state["notes"].length
      closing = false
      next
    end
    left = score_ed_ticks(nt)
    # A tuplet's note is written whole, inside its `\tuplet n/d { … }`.
    tup = nt["tup"]
    notes_all = state["notes"]
    tup_opens = !tup.nil? && (ni == 0 || notes_all[ni - 1]["tup"].nil? || notes_all[ni - 1]["tup"]["g"] != tup["g"])
    tup_closes = !tup.nil? && (ni + 1 >= notes_all.length || notes_all[ni + 1]["tup"].nil? || notes_all[ni + 1]["tup"]["g"] != tup["g"])
    words.push("\\tuplet " + str(tup["n"]) + "/" + str(tup["d"]) + " {") if tup_opens
    while left > 0
      take = tup.nil? ? score_min(left, measure - pos) : left
      chunks = tup.nil? ? score_ed_chunks(take) : [ [nt["base"], nt["dots"]] ]
      for ch, ci in chunks
        last_piece = left - take == 0 && ci == chunks.length - 1
        word = nt["rest"] ? "r" : score_ed_chord_ly(nt)
        word += str(ch[0]) + (ch[1] > 0 ? "." : "")
        word += " ~" if !nt["rest"] && (!last_piece || nt["tie"] == true)
        word += "(" if nt["slur_on"] == true && left == score_ed_ticks(nt) && ci == 0
        word += ")" if nt["slur_off"] == true && last_piece
        word += score_ed_expression_ly(nt, left == score_ed_ticks(nt) && ci == 0, last_piece)
        words.push(word)
        owners.push(ni)
      end
      words.push("}") if tup_closes
      pos += take
      left -= take
      closing = true if nt["rep_end"] == true && left == 0
      breaking = nt["brk"] if !nt["brk"].nil? && left == 0
      if pos == measure
        words.push(closing ? "\\bar \":|.\"" : "|")
        bar_at = words.length - 1
        closing = false
        pos = 0
        if !breaking.nil? && ni + 1 < state["notes"].length
          words.push(breaking == "page" ? "\\pageBreak" : "\\break")
        end
        breaking = nil
        if waiting.length > 0
          words = words + waiting
          measure = score_ed_measure_of(waiting_time) unless waiting_time.nil?
          waiting = []
          waiting_time = nil
        end
      end
    end
  end
  if state["notes"].length > 0 && pos == 0 && bar_at == words.length - 1
    # The last bar ended on its own line: that line becomes the final one.
    words[bar_at] = "\\bar \"|.\"" if words[bar_at] == "|"
  elsif state["notes"].length > 0
    words.push(closing ? "\\bar \":|.\"" : "\\bar \"|.\"")
  end
  words = range(0, head_at).map { |k| words[k] } + ["\\compressEmptyMeasures"] + range(head_at, words.length).map { |k| words[k] } if gathered
  {"src": words.join(" "), "map": owners, "words": words, "head": head_at}
end

def score_ed_bar_ly(word, sign)
  return "\\bar \":|.|:\"" if word == "\\bar \":|.\""

  "\\bar \".|:\""
end

def score_ed_rest_run(state, ni, pos, measure)
  return 0 if pos != 0 || score_ed_chunks(measure).length != 1 || state["no_gather"] == true

  run = 0
  k = ni
  while k < state["notes"].length
    nt = state["notes"][k]
    break unless nt["rest"] && score_ed_ticks(nt) == measure
    break if k > ni && ((nt["set"] ?? {}).keys.length > 0 || nt["rep_start"] == true || !nt["dyn"].nil? || !nt["hairpin"].nil? || nt["hairpin_end"] == true || (nt["texts"] ?? []).length > 0)
    break if k > ni && state["notes"][k - 1]["rep_end"] == true

    run += 1
    k += 1
  end
  run
end

def score_ed_header_ly(hdr)
  fields = []
  for name in ["dedication", "title", "subtitle", "subsubtitle", "poet", "instrument", "composer", "meter", "arranger"]
    value = score_ed_clean(hdr[name] ?? "")
    fields.push(name + " = \"" + value + "\"") if value != ""
  end
  return "" if fields.length == 0

  "\\header { " + fields.join(" ") + " }"
end

def score_ed_tempo_ly(typed, bpm, printed, beat_base)
  tempo_words = score_ed_clean(typed ?? "")
  return "" if tempo_words == "" && !printed
  return "\\tempo \"" + tempo_words + "\"" if !printed

  beat = str(beat_base) + " = " + str(bpm)
  return "\\tempo " + beat if tempo_words == ""

  "\\tempo \"" + tempo_words + "\" " + beat
end

def score_ed_changes_ly(changes)
  out = []
  time = nil
  if changes.has_key("key")
    out.push("\\key " + SCORE_ED_KEY_LY[score_ed_fifths_of(changes["key"]) + 7] + " \\major")
  end
  if changes.has_key("time")
    out.push("\\time " + changes["time"])
    time = changes["time"]
  end
  if changes.has_key("tempo")
    out.push(score_ed_tempo_ly(changes["tempo"]["text"], changes["tempo"]["bpm"], true, changes["tempo"]["base"] ?? 4))
  end
  {"words": out, "time": time}
end

def score_ed_chord_ly(nt)
  return score_ed_pitch_ly(nt["pitches"][0]) if nt["pitches"].length == 1

  "<" + nt["pitches"].map { |pt| score_ed_pitch_ly(pt) }.join(" ") + ">"
end

def score_ed_from_source(state, src)
  current = score_ed_full_source(state)
  return state if src.trim == current.trim

  parsed = nil
  problem = ""
  try
    parsed = score_parse(src)
    score_measures(parsed["events"])
  catch e
    problem = str(e)
  end
  if problem == "" && parsed["staves"].length > 1
    try
      score_layout(src, 100.0, {})
    catch e
      problem = str(e)
    end
  end
  if problem != ""
    state["error"] = problem.replace("score: ", "")
    return state
  end
  state = score_ed_remember_all(state)
  notes = []
  hdr = {}
  for name in SCORE_ED_HEADER
    hdr[name] = parsed["header"][name] if parsed["header"].has_key(name)
  end
  state["header"] = hdr
  # Several staves are several tracks: each staff's notes, clef, name and
  # MIDI settings; what belongs to the bar is read from the first.
  if parsed["staves"].length > 1
    tracks = []
    for stf, k in parsed["staves"]
      got = score_ed_import(state, stf["events"], k == 0)
      props = stf["props"] ?? {}
      trk = score_ed_track_new(props["instrumentName"] ?? ("Track " + str(k + 1)))
      trk["short"] = props["shortInstrumentName"] ?? ""
      trk["instrument"] = props["midiInstrument"] ?? "acoustic grand"
      trk["volume"] = int((props["midiMaximumVolume"] ?? (100.0 / 127.0)) * 127.0 + 0.5)
      pan = props["midiPanPosition"] ?? 0.0
      trk["pan"] = int(pan * 100.0 + (pan < 0.0 ? -0.5 : 0.5))
      trk["notes"] = got["notes"]
      trk["clef"] = got["clef"]
      trk["lyrics"] = score_ed_lyrics_text(stf["lyrics"])
      tracks.push(trk)
    end
    kind = parsed["groups"].length > 0 ? parsed["groups"][0]["kind"] : "none"
    state["group"] = {"brace": "Brace", "bracket": "Bracket", "choir": "Bracket", "none": "None"}[kind] ?? "Bracket"
    state["tracks"] = tracks
    state["track"] = 0
    state["notes"] = tracks[0]["notes"]
    state["clef"] = tracks[0]["clef"]
    tracks[0]["notes"] = nil
    tracks[0]["clef"] = nil
    state["sel"] = state["notes"].length > 0 ? 0 : -1
    return state
  end
  got = score_ed_import(state, parsed["events"], true)
  state["tracks"] = [score_ed_track_new("")]
  state["tracks"][0]["lyrics"] = score_ed_lyrics_text(parsed["staves"][0]["lyrics"])
  state["track"] = 0
  state["clef"] = got["clef"]
  state["notes"] = got["notes"]
  state["sel"] = got["notes"].length > 0 ? 0 : -1
  state
end

def score_ed_import(state, events, first)
  notes = []
  clef = "Treble"
  # Settings before the first note are the piece's; after it, they are
  # changes, written on the note that follows them.
  pending = {}
  # Repeats come back as the two signs; the endings of an \alternative
  # come back as the notes they hold, without their brackets.
  rep_next = false
  for ev in events
    if first && (ev["k"] == "repeat_start" || (ev["k"] == "bar" && ev["v"].ends_with?("|:")))
      rep_next = true
    end
    if first && (ev["k"] == "repeat_end" || (ev["k"] == "bar" && ev["v"].starts_with?(":|"))) && notes.length > 0
      notes[-1]["rep_end"] = true
    end
    notes[-1]["brk"] = ev["page"] ? "page" : "line" if first && ev["k"] == "break" && notes.length > 0
    if ev["k"] == "clef"
      clef = {"treble": "Treble", "bass": "Bass", "alto": "Alto"}[ev["v"]] if notes.length == 0
    elsif !first && (ev["k"] == "key" || ev["k"] == "time" || ev["k"] == "tempo")
      next
    elsif ev["k"] == "key"
      key_name = SCORE_ED_KEYS[ev["fifths"] + 7]
      if notes.length == 0
        state["key"] = key_name
      else
        pending["key"] = key_name
      end
    elsif ev["k"] == "time"
      label = str(ev["n"]) + "/" + str(ev["d"])
      if SCORE_ED_TIMES.includes?(label)
        if notes.length == 0
          state["time"] = label
        else
          pending["time"] = label
        end
      end
    elsif ev["k"] == "tempo"
      bpm = ev["bpm"] > 0 ? ev["bpm"] : state["tempo"]
      beat_base = ev["base"] > 0 ? ev["base"] : 4
      if notes.length == 0
        state["tempo"] = bpm
        state["tempo_base"] = beat_base
        state["tempo_text"] = ev["text"]
        state["mark_tempo"] = ev["bpm"] > 0
      else
        pending["tempo"] = {"bpm": bpm, "text": ev["text"], "base": beat_base}
      end
    elsif ev["k"] == "note" || ev["k"] == "rest"
      if pending.keys.length > 0
        ev["set"] = pending
        pending = {}
      end
      fresh = {
        "rest": ev["k"] == "rest",
        "pitches": ev["pitches"].map { |pt| {"step": score_mod(pt["d"], 7), "oct": (pt["d"] - score_mod(pt["d"], 7)) / 7 + 3, "alter": pt["alter"]} },
        "base": ev["base"],
        "dots": score_min(ev["dots"], 1),
        "tie": ev["tie"] == true,
        "slur_on": ev["slur_on"] == true,
        "slur_off": ev["slur_off"] == true,
        "set": ev["set"] ?? {}
      }
      fresh["rep_start"] = true if rep_next
      fresh["dyn"] = ev["dyn"] if SCORE_ED_DYNAMICS.includes?(ev["dyn"] ?? "")
      fresh["hairpin"] = ev["hairpin"] unless ev["hairpin"].nil?
      fresh["hairpin_end"] = true if ev["hairpin_end"] == true
      fresh["scripts"] = (ev["scripts"] ?? []).map { |sc| {"name": sc["name"], "dir": sc["dir"]} } unless ev["scripts"].nil?
      fresh["texts"] = ev["texts"] unless ev["texts"].nil?
      unless ev["tuplet"].nil?
        fresh["tup"] = {"g": ev["tuplet"]["id"], "n": ev["tuplet"]["n"], "d": ev["tuplet"]["d"]}
        state["tup_seq"] = score_max(state["tup_seq"] ?? 0, ev["tuplet"]["id"])
      end
      rep_next = false
      notes.push(fresh)
      # R1*4 is four bars of rest in the model; the writer gathers them again.
      for _ in range(1, ev["count"] ?? 1)
        notes.push(fresh.merge({"set": {}, "rep_start": false}))
      end
    end
  end
  {"notes": notes, "clef": clef}
end

def score_ed_width(state)
  vw = (state["viewport"] ?? {})["width"] ?? 1100
  score_max(score_min(vw - score_ed_rail_w() - 1 - 2 * 24 - 2 * 16 - 2 - 14, 1180), 300)
end

def score_ed_rail_w()
  212
end

def score_ed_top_h()
  132
end

def score_ed_body_h(state)
  vh = (state["viewport"] ?? {})["height"] ?? 860
  score_max(vh - score_ed_top_h(), 240)
end

def score_ed_full_space(state)
  score_ed_space(state) * 0.65
end

def score_ed_space(state)
  width = score_ed_width(state)
  return 12 if width >= 900
  return 10 if width >= 560

  8
end

def score_ed_engrave(state)
  laid = score_ed_layout(state)
  a4 = state["view"] == SCORE_ED_VIEWS[1]
  sp = score_ed_space(state)
  engraved = nil
  problem = ""
  try
    if a4
      sheets = score_pages(laid["src"], {"width": score_ed_page_width(state)})
      engraved = sheets["engraved"]
      sp = sheets["sp"]
    else
      engraved = score_layout(laid["src"], float(score_ed_width(state)) / sp, {"page_h": score_ed_screen_page() / sp})
    end
  catch e
    problem = str(e)
  end
  {"engraved": engraved, "map": laid["map"], "map1": laid["map1"] ?? laid["map"], "src": laid["src"], "problem": problem, "sp": sp, "a4": a4}
end

def score_ed_page_width(state)
  score_min(score_ed_width(state), 820)
end

def score_ed_doc_bar(state)
  row({"gap": 3, "align": "center", "width": "100%", "wrap": "wrap"}, [
    score_ed_labelled("View", segmented(SCORE_ED_VIEWS, state["view"], "view")),
    {"k": "box", "s": {"grow": 1}},
    score_ed_save_button("Download PDF", "pdf_save", score_ed_file_name(state, "pdf"), state["notes"].length == 0),
    score_ed_save_button("Download MIDI", "midi_save", score_ed_file_name(state, "mid"), state["notes"].length == 0),
    select_sized(SCORE_ED_EXAMPLES, "Examples…", state["ex_open"] == true, "ex_open", "example", 150, false, {"key": "score_examples"}),
    score_ed_tool("Clear", "clear", {}, state["notes"].length == 0, nil)
  ])
end

def score_ed_save_button(label, on_save, name, disabled)
  button = score_ed_tool(label, on_save, {}, disabled, nil)
  kept = {}
  for kind in (button["on"] ?? {}).keys
    kept[kind] = button["on"][kind] unless kind == "click"
  end
  kept["file_save"] = on_save
  button["on"] = kept
  button["p"] = (button["p"] ?? {}).merge({"save": name}) unless disabled
  button
end

def score_ed_file_name(state, ext)
  title = ((state["header"] ?? {})["title"] ?? "").trim
  clean = title.chars().map { |ch| "/\\:*?\"<>|.".contains(ch) ? "" : (ch == " " ? "-" : ch) }.join("")
  (clean == "" ? "score" : clean) + "." + ext
end

def score_ed_rule()
  {"k": "box", "s": {"width": 1, "height": 24, "bg": "border.subtle"}}
end

def score_ed_panels(state)
  # The active tab pressed again folds the panel away: "none".
  panel = state["panel"] ?? SCORE_ED_PANELS[0]
  body = []
  if panel == SCORE_ED_PANELS[0]
    body = [score_ed_settings_bar(state)]
  elsif panel == SCORE_ED_PANELS[1]
    body = [score_ed_bars_panel(state)]
  elsif panel == SCORE_ED_PANELS[2]
    body = [score_ed_expression_panel(state)]
  elsif panel == SCORE_ED_PANELS[3]
    body = [score_ed_lyrics_panel(state)]
  elsif panel == SCORE_ED_PANELS[4]
    body = [score_ed_tracks_panel(state)]
  end
  card({"gap": 4, "pad": [2, 5, body.length > 0 ? 5 : 2, 5], "width": "100%"}, [tabs(SCORE_ED_PANELS, panel, "panel", {"key": "score_panels", "size": "sm"})] + body)
end

def score_ed_pin_button(state, grow, label, no_note)
  armed = (state["pin_from"] ?? -1) >= 0 && state["pin_grow"] == grow
  return score_ed_tool(label + "  " + grow, "hairpin", {"grow": grow}, no_note, grow) unless armed

  control({
    "key": "tool:hairpin:" + label,
    "tone": "accent",
    "size": "sm",
    "on": {"click": "hairpin"},
    "props": {"grow": grow},
    "shape": {"gap": 2, "pad": [1, 3, 1, 3]},
    "a11y": {"role": "button", "label": label + ": armed — press on the last note to end it", "pressed": true},
    "c": [text(label + " ●", {"size": 1, "weight": "medium", "fg": "accent.on"}), kbd(grow)]
  })
end

def score_ed_expression_panel(state)
  current = score_ed_selected(state)
  none = current.nil?
  dyns = SCORE_ED_DYNAMICS.map { |dyn| score_ed_glyph_button("dyn:" + dyn, "dyn", {"dyn": dyn}, score_ed_dyn_icon(dyn), !none && current["dyn"] == dyn, "", dyn) }
  armed = (state["pin_from"] ?? -1) >= 0
  pins = [
    score_ed_pin_button(state, "<", "Crescendo", none),
    score_ed_pin_button(state, ">", "Diminuendo", none)
  ]
  names = {"staccato": "Staccato", "accent": "Accent", "tenuto": "Tenuto", "marcato": "Marcato", "staccatissimo": "Staccatissimo", "portato": "Portato", "fermata": "Fermata"}
  glyphs = {"staccato": "articStaccatoAbove", "accent": "articAccentAbove", "tenuto": "articTenutoAbove", "marcato": "articMarcatoAbove", "staccatissimo": "articStaccatissimoAbove", "portato": "articTenutoStaccatoAbove", "fermata": "fermataAbove"}
  artics = SCORE_ED_ARTICS.map { |name| score_ed_glyph_button("artic:" + name, "artic", {"name": name}, score_ed_centred_icon(glyphs[name]), !none && (current["scripts"] ?? []).any? { |sc| sc["name"] == name }, "", names[name]) }
  side = score_ed_words_side(state)
  side_name = side < 0 ? "Above" : "Below"
  said = ""
  for tx in none ? [] : (current["texts"] ?? [])
    said = tx["text"] if tx["dir"] == side
  end
  # Keyed by the note and the side: another note selected is another field,
  # holding that note's words, never the last one's typing.
  field_key = "score_words:" + str(state["track"] ?? 0) + ":" + str(state["voice"] ?? 1) + ":" + str(state["sel"] ?? -1) + ":" + side_name
  marks = score_ed_word_marks().map { |mark| score_ed_tool(mark, "words_mark", {"text": mark}, none, nil) }
  column({"gap": 3}, [
    row({"gap": 3, "align": "center", "wrap": "wrap"}, [row({"gap": 1, "align": "center"}, dyns), score_ed_rule()] + pins),
    row({"gap": 3, "align": "center", "wrap": "wrap"}, [row({"gap": 1, "align": "center"}, artics)]),
    row({"gap": 3, "align": "center", "wrap": "wrap"}, [
      score_ed_labelled("Text", segmented(["Above", "Below"], side_name, "words_dir")),
      input(said, "words", {"key": field_key, "placeholder": none ? "Select a note first" : (side < 0 ? "dolce" : "cresc."), "props": {"dir": side < 0 ? "up" : "down"}, "style": {"width": 200}}),
      score_ed_tool("Clear", "words_clear", {}, none || said == "", nil)
    ]),
    row({"gap": 1, "align": "center", "wrap": "wrap"}, marks),
    muted(none ? "Select a note to give it a dynamic, a hairpin, an articulation or words." : (armed ? "A hairpin is armed: select the note it ends on and press it again." : "On the selected note; pressed again, each comes off. A hairpin, like a slur: once here, once on the note it ends on."))
  ])
end

def score_ed_dyn_icon(dyn)
  sp = 6.0
  paths = []
  x = 0.3
  for name in score_dyn_letters(dyn)
    g = score_glyph(name)
    paths.push(score_fill("text.default", g["fill"], x, 3.3, sp))
    x += g["advance"]
  end
  canvas(int((x + 0.5) * sp) + 1, 29, paths)
end

def score_ed_centred_icon(name)
  g = score_glyph(name)
  bb = g["bbox"]
  sp = 6.0
  canvas(int((bb[2] - bb[0] + 0.6) * sp) + 1, 29, [score_fill("text.default", g["fill"], 0.3 - bb[0], 2.4 - (bb[1] + bb[3]) / 2.0, sp)])
end

def score_ed_lyrics_panel(state)
  k = state["track"] ?? 0
  trk = score_ed_tracks(state)[k]
  count = score_ed_lyrics_count(state)
  tally = str(count["syllables"]) + " syllables for " + str(count["notes"]) + " notes that take one"
  tally += count["syllables"] > count["notes"] ? " — the last " + str(count["syllables"] - count["notes"]) + " are left out" : (count["syllables"] < count["notes"] && count["syllables"] > 0 ? " — the last " + str(count["notes"] - count["syllables"]) + " notes have none" : "")
  column({"gap": 2, "width": "100%"}, [
    textarea(trk["lyrics"] ?? "", "lyrics", {"key": "score_lyrics:" + str(k), "placeholder": "Frè -- re Jac -- ques, Frè -- re Jac -- ques", "rows": 3, "style": {"width": "100%"}}),
    muted(tally),
    muted("A syllable a note, in order, under the first voice: -- joins a word's syllables (Frè -- re), __ holds a syllable over the notes after it, _ skips a note. Tied and slurred notes hold the syllable before them.")
  ])
end

def score_ed_track_bar(state)
  tracks = score_ed_tracks(state)
  active = state["track"] ?? 0
  chips = []
  full = score_ed_full_view(state)
  if tracks.length > 1
    chips.push(control({
      "key": "track:full",
      "tone": full ? "accent" : "neutral",
      "size": "sm",
      "on": {"click": "full_view"},
      "shape": {"pad": [1, 4, 1, 4]},
      "a11y": {"role": "tab", "label": "Full score", "selected": full},
      "c": [text("Full score", {"size": 1, "weight": "semibold", "fg": full ? "accent.on" : "text.default"})]
    }))
  end
  for trk, k in tracks
    label = trk["name"] == "" ? "Track " + str(k + 1) : trk["name"]
    label = label + "  (muted)" if trk["mute"] == true
    chips.push(control({
      "key": "track:" + str(k),
      "tone": k == active && !full ? "accent" : "neutral",
      "size": "sm",
      "on": {"click": "track"},
      "props": {"track": k},
      "shape": {"pad": [1, 4, 1, 4]},
      "a11y": {"role": "tab", "label": label, "selected": k == active && !full},
      "c": [text(label, {"size": 1, "weight": k == active && !full ? "semibold" : "medium", "fg": k == active && !full ? "accent.on" : "text.default"})]
    }))
  end
  # The chips wrap inside a strip two rows high that scrolls, so an
  # orchestra's twelve staves do not push the score down the page. The
  # row the edited track is on is scrolled to when it changes — lang sends
  # `scroll_to` only then, so the person's own scrolling stays put.
  strip_w = score_ed_width(state) - 200
  strip = scroll({"max_height": 2 * SCORE_ED_CHIP_ROW - 2, "width": strip_w, "grow": 1}, [
    row({"gap": 1, "wrap": "wrap", "width": strip_w - 16}, chips)
  ])
  strip["key"] = "score_track_strip"
  strip["p"] = {"scroll_to": [0, score_ed_chip_row(tracks, active, strip_w - 16) * SCORE_ED_CHIP_ROW]}
  column({"gap": 1, "width": "100%"}, [
    row({"gap": 2, "align": "start", "width": "100%"}, [
      text("Track", {"size": 1, "weight": "medium", "fg": "text.muted", "margin": [2, 0, 0, 0]}),
      strip,
      score_ed_tool("+ Add track", "track_add", {}, false, nil)
    ]),
    tracks.length > 1 ? muted("Alt+↑ / Alt+↓ to switch") : muted("Add a track for a second staff: a piano's left hand, another instrument.")
  ])
end

def score_ed_chip_row(tracks, k, width)
  # "Full score" leads the strip when there are several tracks.
  x = tracks.length > 1 ? 10 * 7.6 + 32.0 : 0.0
  line = 0
  for trk, j in tracks
    label = trk["name"] == "" ? "Track " + str(j + 1) : trk["name"]
    label = label + "  (muted)" if trk["mute"] == true
    chip = label.length * 7.6 + 30.0
    if x > 0.0 && x + chip > width
      line += 1
      x = 0.0
    end
    return line if j == k

    x += chip + 2.0
  end
  line
end

def score_ed_tracks_panel(state)
  tracks = score_ed_tracks(state)
  k = state["track"] ?? 0
  trk = tracks[k]
  pan_name = SCORE_ED_PANS[[-100, -50, 0, 50, 100].index_of(trk["pan"] ?? 0)] ?? "Centre"
  rows = [
    row({"gap": 4, "align": "center", "wrap": "wrap"}, [
      score_ed_labelled("Name", input(trk["name"] ?? "", "track_name", {"key": "score_track_name", "placeholder": "Flute", "style": {"width": 170}})),
      score_ed_labelled("Short", input(trk["short"] ?? "", "track_short", {"key": "score_track_short", "placeholder": "Fl.", "style": {"width": 80}})),
      score_ed_labelled("Instrument", select(SCORE_ED_INSTRUMENTS, trk["instrument"] ?? "acoustic grand", state["inst_open"] == true, "inst_open", "track_instrument", {"key": "score_track_inst"}))
    ]),
    row({"gap": 4, "align": "center", "wrap": "wrap"}, [
      score_ed_labelled("Volume", input(str(trk["volume"] ?? 100), "track_volume", {"key": "score_track_volume", "style": {"width": 60}})),
      score_ed_labelled("Pan", segmented(SCORE_ED_PANS, pan_name, "track_pan")),
      score_ed_tool(trk["mute"] == true ? "Muted" : "Mute", "track_mute", {}, false, nil)
    ]),
    row({"gap": 2, "align": "center", "wrap": "wrap"}, [
      score_ed_tool("Move up", "track_up", {}, k == 0, nil),
      score_ed_tool("Move down", "track_down", {}, k + 1 >= tracks.length, nil),
      score_ed_tool("Remove track", "track_remove", {}, tracks.length < 2, nil),
      score_ed_rule(),
      score_ed_labelled("Full score", segmented(SCORE_ED_GROUPS, state["group"] ?? "Bracket", "group"))
    ]),
    muted("Volume is MIDI's 0–127; the pan and the instrument go into the MIDI file. A muted track is silent in Play, and still in the score and the file. Changes from a bar, repeats and breaks are the first track's, and every staff takes them.")
  ]
  column({"gap": 3}, rows)
end

def score_ed_conductor_card(state)
  return {"k": "box", "s": {"display": "column"}, "c": []} if score_ed_tracks(state).length < 2

  full = score_ed_conductor(state)
  width = score_ed_width(state)
  sp = score_ed_full_space(state)
  inner = nil
  pages = 1
  try
    engraved = score_ed_conductor_engraved(state, full)
    pages = engraved["pages"].length
    shown = score_ed_page_shown(state, engraved, "cond_page")
    inner = score_band_column(engraved, sp, {"colour": "text.default", "marks": score_ed_conductor_marks(state, full), "page_index": shown}, width, score_ed_page_height(engraved, shown, sp))
  catch e
    inner = text(str(e).replace("score: ", ""), {"fg": "danger.base", "size": 1})
  end
  heading = [text("Full score", {"size": 2, "weight": "semibold"}), muted("Every track, as the PDF and the MIDI have them. Click a note to edit it; a track's name above goes back to its staff.")]
  pager = score_ed_pager(state, "cond_page", pages)
  heading = heading + [{"k": "box", "s": {"grow": 1}}, pager] unless pager.nil?
  card({"gap": 3, "pad": 5, "width": "100%"}, [
    row({"gap": 3, "align": "center", "wrap": "wrap", "width": "100%"}, heading),
    {"k": "box", "s": {"display": "column", "width": width, "cursor": "pointer"}, "on": {"click": "conductor_pick"}, "p": {"role": "group", "label": "Full score"}, "c": [inner]}
  ])
end

def score_ed_bars_panel(state)
  current = score_ed_selected(state)
  column({"gap": 2}, [
    row({"gap": 2, "align": "center", "wrap": "wrap"}, [
      score_ed_tool("Repeat from here", "repeat_start", {}, current.nil?, "["),
      score_ed_tool("Repeat to here", "repeat_end", {}, current.nil?, "]"),
      score_ed_rule(),
      score_ed_tool("Line break after", "line_break", {}, current.nil?, nil),
      score_ed_tool("Page break after", "page_break", {}, current.nil?, nil)
    ]),
    muted("At the bar the selected note is in: a repeat starts there or ends after it, and a line or a page can be made to end after it. Press again to take it off.")
  ])
end

def score_ed_tempo_shown(state, beat)
  words = (state["tempo_text"] ?? "").trim
  speed = beat + " = " + str(state["tempo"])
  words == "" ? speed : words + " (" + speed + ")"
end

def score_ed_time_at(state, idx)
  last = idx < 0 ? state["notes"].length - 1 : idx
  time = state["time"]
  for nt, k in state["notes"]
    break if k > last

    changes = nt["set"] ?? {}
    time = changes["time"] if changes.has_key("time")
  end
  time
end

def score_ed_rail_group(label, width, kids)
  column({"gap": 2, "width": width}, [
    text(label, {"size": 0, "weight": "semibold", "fg": "text.muted"}),
    row({"gap": 1, "align": "center", "wrap": "wrap", "width": width}, kids)
  ])
end

def score_ed_duration_name(base)
  {"1": "Whole", "2": "Half", "4": "Quarter", "8": "Eighth", "16": "Sixteenth", "32": "32nd"}[str(base)]
end

def score_ed_slur_button(state, no_note)
  armed = (state["slur_from"] ?? -1) >= 0
  return score_ed_tool("Slur", "slur", {}, no_note, "S") unless armed

  control({
    "key": "tool:slur:Slur",
    "tone": "accent",
    "size": "sm",
    "on": {"click": "slur"},
    "shape": {"gap": 2, "pad": [1, 3, 1, 3]},
    "a11y": {"role": "button", "label": "Slur: on — S on the last note ends it", "pressed": true},
    "c": [text("Slur ●", {"size": 1, "weight": "medium", "fg": "accent.on"}), kbd("S")]
  })
end

def score_ed_field_bytes()
  4000
end

def score_ed_source_blocks(src)
  out = []
  for piece in src.split("\\new Staff")
    staff = out.length == 0 ? piece : "\\new Staff" + piece
    block = ""
    for word in staff.split(" ")
      if block.length + word.length + 1 > 3000
        out.push(block)
        block = ""
      end
      block = block == "" ? word : block + " " + word
    end
    out.push(block) if block.trim != ""
  end
  out
end

def check(label, got, want)
  assert_eq(got, want)
end

# The diatonic numbers a source's notes resolve to, in order.
def spec_pitches(src)
  out = []
  for ev in score_parse(src)["events"]
    out.push(ev["pitches"].map { |pt| pt["d"] }) if ev["k"] == "note"
  end
  out.map { |ds| ds.length == 1 ? ds[0] : ds }
end

# The error a source raises, or "" when it raises none.
def spec_refusal(src)
  said = ""
  try
    bars = score_measures(score_parse(src)["events"])
    score_beams(bars)
  catch e
    said = str(e)
  end
  said
end

# The steepest beam an engraving draws, end to end in staff spaces. A
# helper, so a failing test holds a number and not the engraving: a failed
# assert describes its frame, and an engraving is cyclic (a note holds its
# beam, which holds the note), so describing one never ends.
def spec_steepest_beam(src)
  steepest = 0.0
  for sys in score_engrave(src, 80.0)["systems"]
    for bar in sys["bars"]
      for ev in bar["items"]
        g = ev["beam"]
        steepest = score_max(steepest, (g["y1"] - g["y0"]).abs) unless g.nil?
      end
    end
  end
  steepest
end

# How an A4 layout of `src` went: pages, and whether every system stays
# inside the margins — numbers only, for the same reason.
def spec_a4_summary(src)
  sheets = score_pages(src, {"width": 600})
  paper = score_a4()
  inside = true
  for sys in sheets["engraved"]["systems"]
    inside = false if sys["bottom"] > paper["h"] - paper["bottom"] + 0.01
    inside = false if sys["right"] > paper["w"] - paper["right"] + 0.01
  end
  {"pages": sheets["pages"].length, "inside": inside, "left": sheets["engraved"]["systems"][0]["left"].round(2), "want_left": (paper["left"] + paper["indent"]).round(2)}
end

# Each bar as [number, bar line, the alternative it is in, bars it stands for].
def spec_bars(src)
  score_measures(score_parse(src)["events"]).map { |b| [b["number"], b["bar"], b["volta_in"] ?? "", b["span"] ?? 1] }
end

# Every path in a tree's canvases, in order: a score is a column of them,
# one for each system.
def spec_tree_paths(node)
  out = []
  out = out + node["p"]["paths"] if node["k"] == "canvas"
  for kid in node["c"] ?? []
    out = out + spec_tree_paths(kid)
  end
  out
end

# Every path an engraving draws, flattened to [kind, numbers…].
def spec_paths(src, width)
  score_paths(score_engrave(src, float(width) / 8), 8, {})
end

def spec_state()
  score_ed_defaults({})
end

def spec_keys(state, keys)
  for k in keys
    state = score_ed_key(state, k, 0)
  end
  state
end

const SPEC_CHORALE = "\\relative c' { \\key g \\major \\time 4/4 g'4( a b c) | d2 b4 g | e'8[ d c b] a4 fis | g1 \\bar \"|.\" }"
const SPEC_RUN = "\\relative c'' { \\time 6/8 \\key d \\minor d8 e f g a bes | a16 g f e d cis d4. | bes'8. a16 g8 f4 e8 | d2. \\bar \"|.\" }"
const SPEC_BASS = "\\relative c { \\clef bass \\time 3/4 c4 e g | <c, e g c>2. ~ | <c e g c>4 r r | R2. | g'8 a b c d e | f2 r4 \\bar \"||\" }"
const SPEC_SUITE = "\\header { title = \"Petite suite\" composer = \"Anonyme\" } \\relative c'' { \\key g \\major \\time 3/4 \\tempo \"Allegretto\" 4 = 112 d4 b8 c d e | d4 g, g | e'4 c8 d e fis | g4 g, g | c4 d8 c b a | b4 c8 b a g | fis4 g8 a b g | a2. \\bar \"||\" \\key bes \\major \\time 4/4 \\tempo \"Andante\" 4 = 72 f4 d8 es f4 bes | a8 g f es d4 r | <d f>2 <es g>4. f8 | f1 \\bar \"||\" \\key d \\major \\time 6/8 a8 d fis a fis d | e cis a e' cis a | d4. r4. \\bar \"|.\" }"

describe("reading LilyPond", fn() {
  test("\\relative puts each note within a fourth of the one before", fn() {
    check("a scale from middle C", spec_pitches("\\relative c' { c d e f g a b c }"), [7, 8, 9, 10, 11, 12, 13, 14])
    check("down a fourth rather than up a fifth", spec_pitches("\\relative c' { c g }"), [7, 4])
    check("a mark moves it an octave", spec_pitches("\\relative c' { c g' }"), [7, 11])
    check("and a comma down", spec_pitches("\\relative c'' { c c, }"), [14, 7])
    check("a chord's first note leads what follows", spec_pitches("\\relative c' { <c e g> c }"), [ [7, 9, 11], 7 ])
  })

  test("without \\relative, a pitch is absolute: c is the C below middle C", fn() {
    check("absolute", spec_pitches("{ c c' d'' b, }"), [0, 7, 15, -1])
  })

  test("names, alterations and durations", fn() {
    evs = score_parse("{ fis'4. bes'8 eis''16 as'2 r1 }")["events"]
    check("sharp", evs[0]["pitches"][0]["alter"], 1)
    check("flat", evs[1]["pitches"][0]["alter"], -1)
    check("e sharp", evs[2]["pitches"][0]["alter"], 1)
    check("a flat, the short spelling", evs[3]["pitches"][0]["alter"], -1)
    check("a dotted quarter is three eighths", evs[0]["ticks"], score_whole() * 3 / 8)
    check("a whole rest", [evs[4]["k"], evs[4]["ticks"]], ["rest", score_whole()])
    check("items are numbered, rests included", evs.map { |ev| ev["i"] }, [0, 1, 2, 3, 4])
  })

  test("what it cannot draw is refused with its position", fn() {
    assert(spec_refusal("{ c'4 # }").includes?("'#'"))
    assert(spec_refusal("{ c'4 # }").includes?("character 6"))
    assert(spec_refusal("{ \\clef tenor c'4 }").includes?("tenor"))
    assert(spec_refusal("{ c'64 }").includes?("64"))
    assert(spec_refusal("{ ( c'4 }").includes?("must follow a note"))
    assert(spec_refusal("{ \\tuplet 3/2 { c'8 d' e' }").includes?("never closed"))
    assert(spec_refusal("{ c'2 d'1 }").includes?("runs past the bar line"))
    assert(spec_refusal("{ c'4 d'4 \\clef bass e4 f4 }").includes?("middle of a bar"))
    assert(spec_refusal("{ c'4 ").includes?("never closed"))
    check("a good score is not refused", spec_refusal(SPEC_CHORALE), "")
  })

  test("accidentals are drawn where the key and the bar do not already say them", fn() {
    bars = score_measures(score_parse("{ \\key g \\major fis'4 f'4 f'4 fis'4 | f'4 }")["events"])
    shown = bars[0]["items"].map { |ev| ev["heads"][0]["acc"] }
    check("F sharp is in the key; F natural is not, once; F sharp again is", shown, [nil, 0, nil, 1])
    check("a new bar starts from the key", bars[1]["items"][0]["heads"][0]["acc"], 0)
  })
})

describe("engraving", fn() {
  test("spacing grows with the duration, from the common shortest note", fn() {
    s16 = score_duration_space(16, 16)
    s8 = score_duration_space(32, 16)
    s4 = score_duration_space(64, 16)
    assert(s16 < s8 && s8 < s4)
    check("each doubling adds the 1.2-space increment", (s4 - s8).round(3), 1.2)
    assert(score_duration_space(8, 16) < s16)
    bars = score_measures(score_parse(SPEC_CHORALE)["events"])
    check("the chorale's common shortest is the quarter, held to a dotted eighth", score_shortest(bars), score_whole() * 3 / 16)
  })

  test("a stem goes against the note farthest from the middle line", fn() {
    check("below goes up", score_stem_up?([{"pos": -3}]), true)
    check("on the middle line goes down", score_stem_up?([{"pos": 0}]), false)
    check("above goes down", score_stem_up?([{"pos": 3}]), false)
    check("a chord follows its outer note", score_stem_up?([{"pos": -5}, {"pos": 3}]), true)
  })

  test("eighths are beamed by the metre", fn() {
    groups = fn(src) {
      bars = score_measures(score_parse(src)["events"])
      score_beams(bars)
      seen = []
      for ev in bars[0]["items"]
        seen.push(ev["beam"].nil? ? 1 : ev["beam"]["notes"].length) if ev["beam"].nil? || ev["beam"]["notes"][0]["n"] == ev["n"]
      end
      seen
    }
    check("4/4: by the half bar", groups("{ c'8 d' e' f' g' a' b' c'' }"), [4, 4])
    check("3/4: the whole bar", groups("{ \\time 3/4 c'8 d' e' f' g' a' }"), [6])
    check("6/8: by the dotted quarter", groups("{ \\time 6/8 c'8 d' e' f' g' a' }"), [3, 3])
    check("sixteenths by the beat in 4/4", groups("{ c'16 d' e' f' g' a' b' c'' c'2 }"), [4, 4, 1])
    check("a rest breaks a beam", groups("{ c'8 d' r e' f'2 }"), [2, 1, 1, 1])
  })

  test("a beam's slope is held to a space and a half and its ends are quanted", fn() {
    for src in [SPEC_CHORALE, SPEC_RUN, SPEC_BASS, SPEC_SUITE]
      assert(spec_steepest_beam(src) <= 1.5 + 0.001)
    end
    # Inside the staff a beam's top sits, straddles or hangs.
    for y in [0.3, 1.2, 2.6, 3.4]
      q = score_quant(y, -1)
      frac = (q - q.floor + 1.0) % 1.0
      assert(q <= y + 0.0001)
      # Sits (a beam and half a line above), straddles, or hangs (half a
      # line below): 0.47, 0.76 and 0.05 past a line with LilyPond's 0.48
      # beam and 0.1 line.
      assert([0.47, 0.76, 0.05].any? { |want| (frac - want).abs < 0.001 })
    end
  })

  test("a slur's height is LilyPond's: growing with its width, never past the limit", fn() {
    check("atan(1) is a quarter turn's half", score_atan(1.0).round(4), 0.7854)
    check("atan(3)", score_atan(3.0).round(4), 1.249)
    short = score_curve_height(2.0, 2.0, 0.25)
    long = score_curve_height(40.0, 2.0, 0.25)
    assert(short < long && long < 2.0)
  })

  test("every path is one a client paints, and the encoder takes the tree", fn() {
    for src in [SPEC_CHORALE, SPEC_RUN, SPEC_BASS]
      paths = spec_paths(src, 640)
      assert(paths.length > 30)
      for p in paths
        assert([1, 5].includes?(p[0]))
        assert(p.length > 3)
        for v, k in p
          assert(v.is_a?("int") || v.is_a?("float")) if k >= 2
        end
      end
      assert(!eui_render(score(src, {"width": 640})).nil?)
    end
  })

  test("a narrow score breaks into systems that stay inside the width", fn() {
    engraved = score_engrave(SPEC_RUN, 40.0)
    assert(engraved["systems"].length > 1)
    for sys in engraved["systems"]
      assert(sys["right"] <= 40.0 + 0.01)
    end
  })

  test("marks draw an item in another role", fn() {
    plain = spec_tree_paths(score(SPEC_CHORALE, {"width": 640}))
    lit = spec_tree_paths(score(SPEC_CHORALE, {"width": 640, "marks": {"0": "accent.base"}}))
    # Laid over the plain drawing, which stays as it was: lighting a note
    # changes the overlay, never the system under it.
    check("the plain paths as they were", lit.filter { |p| p[1] != "accent.base" }, plain)
    check("and the item's laid over them", lit.filter { |p| p[1] == "accent.base" }.length > 0, true)
    assert(!plain.any? { |p| p[1] == "accent.base" })
  })
})

describe("the editor", fn() {
  test("a length is written as the fewest values", fn() {
    eighth = score_whole() / 8
    check("a dotted half", score_ed_chunks(eighth * 6), [ [2, 1] ])
    check("a half and an eighth", score_ed_chunks(eighth * 5), [ [2, 0], [8, 0] ])
    check("a quarter", score_ed_chunks(eighth * 2), [ [4, 0] ])
    check("a whole and a quarter", score_ed_chunks(eighth * 10), [ [1, 0], [4, 0] ])
  })

  test("a note across a bar line is cut there and tied", fn() {
    st = spec_state()
    st["notes"] = [score_ed_note(0, 4, 0, 2, 1), score_ed_note(2, 4, 0, 2, 0)]
    laid = score_ed_layout(st)
    assert(laid["src"].includes?("c'2. e'4 ~ | e'4"))
    check("both pieces belong to the second note", laid["map"], [0, 1, 1])
    check("and the engraver takes it", spec_refusal(laid["src"]), "")
  })

  test("typing a letter writes the note the key means, near the one before", fn() {
    st = score_ed_settings(spec_state(), "key", "G")
    st["sel"] = 0
    st = spec_keys(st, ["f"])
    check("F in G major is F sharp", score_ed_selected(st)["pitches"][0]["alter"], 1)
    st = spec_keys(spec_state(), ["g"])
    check("G after middle C is the G below", score_ed_selected(st)["pitches"][0]["oct"], 3)
    st = score_ed_key(spec_state(), "g", 1)
    check("Shift adds to the chord instead", score_ed_selected(st)["pitches"].length, 2)
    st = spec_keys(spec_state(), ["G"])
    check("and so does a capital, whatever the modifiers say", score_ed_selected(st)["pitches"].length, 2)
  })

  test("a duration is for what comes next while typing, for the note once chosen", fn() {
    st = spec_keys(spec_state(), ["End", "a", "6"])
    check("straight after a note: the next one", [score_ed_selected(st)["base"], st["dur"]], [4, 2])
    st = spec_keys(st, ["b"])
    check("which it is", score_ed_selected(st)["base"], 2)
    st = spec_keys(st, ["ArrowLeft", "3"])
    check("after an arrow: the chosen note", score_ed_selected(st)["base"], 16)
  })

  test("the arrows, the accidentals and the dot", fn() {
    st = spec_keys(spec_state(), ["ArrowUp"])
    check("up a step of the key: D", [score_ed_selected(st)["pitches"][0]["step"], score_ed_selected(st)["pitches"][0]["alter"]], [1, 0])
    st = score_ed_key(st, "ArrowDown", 1)
    check("Shift+↓, a semitone: D flat", [score_ed_selected(st)["pitches"][0]["step"], score_ed_selected(st)["pitches"][0]["alter"]], [1, -1])
    st = score_ed_key(st, "ArrowDown", 1)
    check("then C", [score_ed_selected(st)["pitches"][0]["step"], score_ed_selected(st)["pitches"][0]["alter"]], [0, 0])
    st = spec_keys(st, ["ArrowUp"])
    st = score_ed_key(st, "ArrowUp", 2)
    check("Ctrl: up an octave", score_ed_selected(st)["pitches"][0]["oct"], 5)
    st = spec_keys(st, ["+", "+", "+"])
    check("a sharp, a double sharp, and no further", score_ed_selected(st)["pitches"][0]["alter"], 2)
    st = spec_keys(st, ["="])
    check("natural", score_ed_selected(st)["pitches"][0]["alter"], 0)
    st = spec_keys(st, ["."])
    check("dotted", score_ed_selected(st)["dots"], 1)
  })

  test("delete, undo and redo", fn() {
    st = spec_state()
    count = st["notes"].length
    st = spec_keys(st, ["End", "Delete", "Delete"])
    check("a note leaves a rest, the rest goes", st["notes"].length, count - 1)
    st = score_ed_key(st, "z", 2)
    check("undone", st["notes"].length, count)
    st = score_ed_key(st, "y", 2)
    check("redone", st["notes"].length, count - 1)
    st = score_ed_key(st, "z", 2)
    st = score_ed_key(st, "z", 3)
    check("Ctrl+Shift+Z redoes too", st["notes"].length, count - 1)
  })

  test("a slur takes two presses", fn() {
    st = spec_keys(spec_state(), ["Home", "s", "ArrowRight", "ArrowRight", "s"])
    assert(score_ed_layout(st)["src"].includes?("c'4( d'4 e'4)"))
  })

  test("S is a switch: on, nothing written yet; off where the slur ends", fn() {
    st = spec_keys(spec_state(), ["Home", "s"])
    check("armed on the first note", st["slur_from"], 0)
    check("no open slur in the source", score_ed_layout(st)["src"].includes?("("), false)
    st = spec_keys(st, ["s"])
    check("S on the same note puts it out", [st["slur_from"], score_ed_layout(st)["src"].includes?("(")], [-1, false])
    st = spec_keys(st, ["ArrowRight", "ArrowRight", "s", "Home", "s"])
    check("backwards: from the first to where it was armed", score_ed_layout(st)["src"].includes?("c'4( d'4 e'4)"), true)
    check("and off", st["slur_from"], -1)
  })

  test("the source reads back to the model it was written from", fn() {
    st = spec_state()
    st = score_ed_settings(st, "time", "3/4")
    src = score_ed_layout(st)["src"]
    back = score_ed_from_source(spec_state(), src)
    check("the same source", score_ed_layout(back)["src"], src)
    bad = score_ed_from_source(spec_state(), "{ c'4 # }")
    assert(bad["error"].includes?("'#'"))
    check("and the model is untouched", bad["notes"].length, spec_state()["notes"].length)
  })

  test("a click picks the note under it, and a second click moves it", fn() {
    st = spec_state()
    drawn = score_ed_engrave(st)
    sp = score_ed_space(st)
    sys = drawn["engraved"]["systems"][0]
    third = sys["bars"][0]["items"][2]
    at = [(third["x"] + 0.5) * sp, (sys["top"] + score_y(third["heads"][0]["pos"])) * sp]
    st = score_ed_pick(st, at, 0)
    check("the third note", st["sel"], 2)
    higher = [at[0], (sys["top"] + score_y(third["heads"][0]["pos"] + 2)) * sp]
    st = score_ed_pick(st, higher, 0)
    check("moved a third up: E to G", score_ed_selected(st)["pitches"][0]["step"], 4)
  })

  test("in insert mode a press writes a note where it lands, and moves none", fn() {
    st = spec_state()
    count = st["notes"].length
    st = score_ed_key(st, "n", 0)
    check("N: insert mode", st["tool"], SCORE_ED_TOOLS[1])
    drawn = score_ed_engrave(st)
    sp = score_ed_space(st)
    sys = drawn["engraved"]["systems"][0]
    second = sys["bars"][0]["items"][1]
    third = sys["bars"][0]["items"][2]
    # Between the second and the third note, on the staff's top line (F).
    between = [((second["x"] + third["x"]) / 2.0 + 0.6) * sp, sys["top"] * sp]
    st = score_editor({"event": "press", "params": {"payload": between, "props": {"page": 0}}, "state": st})
    check("one note more", st["notes"].length, count + 1)
    check("written third, and selected", st["sel"], 2)
    check("at the pitch under the press", score_ed_selected(st)["pitches"][0]["step"], 3)
    check("nothing picked up", st["dragging"], false)
    st = score_ed_key(st, "Escape", 0)
    check("Escape: the pointer again", st["tool"], SCORE_ED_TOOLS[0])
  })

  test("in insert mode a press on a note makes a chord, and on a rest fills it, moving nothing", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 r4 e''4 f''4 }")
    st = score_ed_flag(st, "tool", SCORE_ED_TOOLS[1])
    count = st["notes"].length
    drawn = score_ed_engrave(st)
    sp = score_ed_space(st)
    sys = drawn["engraved"]["systems"][0]
    items = sys["bars"][0]["items"]
    on_c = [(items[0]["x"] + 0.6) * sp, (sys["top"] + score_y(items[0]["heads"][0]["pos"] + 2)) * sp]
    st = score_editor({"event": "press", "params": {"payload": on_c, "props": {"page": 0}}, "state": st})
    check("no note more", st["notes"].length, count)
    check("C and E together", st["notes"][0]["pitches"].map { |pt| pt["step"] }, [0, 2])
    on_rest = [(items[1]["x"] + 0.6) * sp, sys["top"] * sp]
    st = score_editor({"event": "press", "params": {"payload": on_rest, "props": {"page": 0}}, "state": st})
    check("still no note more", st["notes"].length, count)
    check("the rest a note, F on the top line", [st["notes"][1]["rest"], st["notes"][1]["pitches"][0]["step"]], [false, 3])
    check("as long as the rest was", st["notes"][1]["base"], 4)
    check("selected", st["sel"], 1)
    again = score_editor({"event": "press", "params": {"payload": on_c, "props": {"page": 0}}, "state": st})
    check("a pitch it has only selects", again["notes"][0]["pitches"].length, 2)
    # A value chosen now is the next note's: the selected one keeps its own.
    st = score_ed_duration(st, 8)
    st = score_ed_dot(st)
    check("the selection unchanged", [st["notes"][1]["base"], st["notes"][1]["dots"]], [4, 0])
    check("the next note's value", [st["dur"], st["dot"]], [8, true])
  })

  test("in insert mode another value on a note writes a second voice: the quarter stays, the eighth sounds with it", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    st = score_ed_flag(st, "tool", SCORE_ED_TOOLS[1])
    st = score_ed_duration(st, 8)
    drawn = score_ed_engrave(st)
    sp = score_ed_space(st)
    sys = drawn["engraved"]["systems"][0]
    items = sys["bars"][0]["items"]
    on_d = [(items[1]["x"] + 0.6) * sp, sys["top"] * sp]
    st = score_editor({"event": "press", "params": {"payload": on_d, "props": {"page": 0}}, "state": st})
    check("editing the second voice now", st["voice"], 2)
    first = score_ed_v1(st)["notes"]
    check("the first voice untouched: four quarters", first.map { |nt| [nt["rest"], nt["base"]] }, [ [false, 4], [false, 4], [false, 4], [false, 4] ])
    check("the D still there", first[1]["pitches"][0]["step"], 1)
    check("the second voice: silence for a beat, then an F eighth", st["notes"].map { |nt| [nt["rest"], nt["spacer"] == true, nt["base"]] }, [ [true, true, 4], [false, false, 8] ])
    check("the F", st["notes"][1]["pitches"][0]["step"], 3)
    check("selected", st["sel"], 1)
    src = score_ed_layout(st)["src"]
    check("written as two voices", src.includes?("<< {") && src.includes?("\\\\"), true)
    bar = score_engrave(src, 100.0)["systems"][0]["bars"][0]
    eighth = bar["items"].filter { |ev| ev["voice"] == 2 && ev["k"] == "note" }[0]
    d_note = bar["items"].filter { |ev| ev["voice"] == 1 }[1]
    check("the eighth sounds with the D", eighth["start"], d_note["start"])
    check("over it, so the D stands a head to the right", d_note["x"] > eighth["x"], true)
    st = score_ed_undo(st)
    check("undone, the second voice is empty again", score_ed_voiced?(score_ed_v1(st)["notes2"]), false)
  })

  test("in insert mode another value on a rest writes over it: an eighth leaves a rest, a half covers two", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 r4 r4 f''4 }")
    st = score_ed_flag(st, "tool", SCORE_ED_TOOLS[1])
    st = score_ed_duration(st, 2)
    drawn = score_ed_engrave(st)
    sp = score_ed_space(st)
    sys = drawn["engraved"]["systems"][0]
    items = sys["bars"][0]["items"]
    on_rest = [(items[1]["x"] + 0.6) * sp, sys["top"] * sp]
    halved = score_editor({"event": "press", "params": {"payload": on_rest, "props": {"page": 0}}, "state": st})
    check("a half over both rests, in the first voice", [halved["voice"] ?? 1, halved["notes"].map { |nt| nt["base"] }], [1, [4, 2, 4] ])
    # `score_editor` changes the state it is given: a fresh one for the eighth.
    st = score_ed_flag(score_ed_from_source(spec_state(), "{ c''4 r4 r4 f''4 }"), "tool", SCORE_ED_TOOLS[1])
    st = score_ed_duration(st, 8)
    st = score_editor({"event": "press", "params": {"payload": on_rest, "props": {"page": 0}}, "state": st})
    check("an F eighth, then an eighth rest, where the rest was", st["notes"].map { |nt| [nt["rest"], nt["base"]] }, [ [false, 4], [false, 8], [true, 8], [true, 4], [false, 4] ])
    check("F still on the fourth beat", st["notes"].take(4).map { |nt| score_ed_ticks(nt) }.reduce(fn(acc, t) acc + t, 0), score_whole() * 3 / 4)
  })

  test("the frame: the score and the toolbar share the height under the top bar, the score the width beside the toolbar", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    st["viewport"] = {"width": 1400, "height": 900}
    check("the body is the height under the bar", score_ed_body_h(st), 900 - score_ed_top_h())
    check("the score's width leaves the toolbar room", score_ed_width(st) <= 1400 - score_ed_rail_w() - 80, true)
    check("a short window keeps a usable body", score_ed_body_h(score_ed_flag(st, "viewport", {"width": 800, "height": 200})), 240)
  })

  test("on the full score the toolbar drops what only a single staff can do: the insert tool and the voices", fn() {
    st = score_ed_from_source(spec_state(), "\\new StaffGroup << \\new Staff { c''4 d''4 e''4 f''4 } \\new Staff { \\clef bass c4 d4 e4 f4 } >>")
    check("two tracks", score_ed_tracks(st).length, 2)
    st = score_ed_set_voice(score_ed_flag(st, "tool", SCORE_ED_TOOLS[1]), 2)
    st = score_editor({"event": "full_view", "params": {}, "state": st})
    check("the full score: the pointer, the first voice", [score_ed_full_view(st), st["tool"], st["voice"] ?? 1], [true, SCORE_ED_TOOLS[0], 1])
    st = score_editor({"event": "tool", "params": {"props": {"option": SCORE_ED_TOOLS[1]}}, "state": st})
    st = score_ed_key(st, "n", 0)
    st = score_ed_key(st, "2", 12)
    check("neither a press nor a key brings them back", [st["tool"], st["voice"] ?? 1], [SCORE_ED_TOOLS[0], 1])
    st = score_editor({"event": "track", "params": {"props": {"track": 0}}, "state": st})
    st = score_editor({"event": "tool", "params": {"props": {"option": SCORE_ED_TOOLS[1]}}, "state": st})
    check("a track again: the insert tool works", st["tool"], SCORE_ED_TOOLS[1])
  })

  test("an undo step copies the track edited, not the orchestra, and is undone on that track", fn() {
    st = score_ed_from_source(spec_state(), "\\new StaffGroup << \\new Staff { c''4 d''4 e''4 f''4 } \\new Staff { \\clef bass c4 d4 e4 f4 } >>")
    st = score_ed_switch(st, 0)
    st["sel"] = 0
    st = score_ed_key(st, "ArrowUp", 0)
    step = st["undo"][-1]
    check("one track copied, and which", [step.has_key("tracks"), step["track"]], [false, 0])
    check("the C a D now", st["notes"][0]["pitches"][0]["step"], 1)
    st = score_ed_switch(st, 1)
    st = score_ed_undo(st)
    check("undone on the track it was made on", [st["track"], st["notes"][0]["pitches"][0]["step"]], [0, 0])
    check("the other track untouched", score_ed_tracks(st)[1]["notes"].length, 4)
    st = score_ed_switch(st, 1)
    st = score_ed_redo(st)
    check("redone there too", [st["track"], st["notes"][0]["pitches"][0]["step"]], [0, 1])
    st = score_ed_track_add(st)
    check("a track added: every track copied", st["undo"][-1].has_key("tracks"), true)
    st = score_ed_undo(st)
    check("and undone whole", score_ed_tracks(st).length, 2)
  })

  test("words on a note: a run of typing is one step, a mark goes on the side chosen, Clear takes it off", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    st["sel"] = 1
    before = st["undo"].length
    for typed in ["d", "do", "dol", "dolc", "dolce"]
      st = score_editor({"event": "words", "params": {"payload": typed, "props": {"dir": "up"}}, "state": st})
    end
    check("five keystrokes, one step to undo", st["undo"].length - before, 1)
    check("dolce over the D", st["notes"][1]["texts"], [ {"text": "dolce", "dir": -1} ])
    st = score_editor({"event": "words_dir", "params": {"props": {"option": "Below"}}, "state": st})
    st = score_editor({"event": "words_mark", "params": {"props": {"text": "cresc."}}, "state": st})
    check("cresc. under it, dolce kept", st["notes"][1]["texts"].map { |tx| [tx["text"], tx["dir"]] }, [ ["dolce", -1], ["cresc.", 1] ])
    check("both in the source", [score_ed_layout(st)["src"].includes?("^\"dolce\""), score_ed_layout(st)["src"].includes?("_\"cresc.\"")], [true, true])
    st = score_editor({"event": "words_clear", "params": {}, "state": st})
    check("Clear takes off the side chosen", st["notes"][1]["texts"].map { |tx| tx["text"] }, ["dolce"])
    st["sel"] = 2
    st = score_editor({"event": "words", "params": {"payload": "p", "props": {"dir": "down"}}, "state": st})
    check("another note: another step", st["undo"].length - before, 4)
    st = score_ed_undo(st)
    check("undone, the E has no words", st["notes"][2]["texts"] ?? [], [])
  })

  test("the tempo mark says what the score prints over the first bar", fn() {
    st = spec_state()
    st["tempo_text"] = "Moderato"
    st["tempo"] = 100
    check("words, then the speed", score_ed_tempo_shown(st, "♩"), "Moderato (♩ = 100)")
    st["tempo_text"] = "  "
    check("the speed alone", score_ed_tempo_shown(st, "♩"), "♩ = 100")
  })

  test("lyrics: a syllable a note, a tie or a slur holding one, -- and __ kept", fn() {
    staff = score_parse("{ c'4( d'4) e'4 ~ e'4 | f'4 g'4 a'4 b'4 } \\addlyrics { Frè -- re __ l'eau, _ \"a b\" ici }")["staves"][0]
    check("six syllables", staff["lyrics"].map { |sy| sy["text"] }, ["Frè", "re", "l'eau,", "", "a b", "ici"])
    check("the hyphen and the extender", [staff["lyrics"][0]["hyphen"], staff["lyrics"][1]["extend"]], [true, true])
    bar = score_engrave("{ c'4( d'4) e'4 ~ e'4 | f'4 g'4 a'4 b'4 } \\addlyrics { Frè -- re __ l'eau, _ \"a b\" ici }", 100.0)["systems"][0]["bars"][0]
    check("the slur and the tie hold the syllable before", bar["items"].map { |ev| ev["lyric"].nil? ? (ev["lyric_held"] == true ? "held" : "-") : ev["lyric"]["text"] }, ["Frè", "held", "re", "held"])
  })

  test("lyrics: notes make room for their syllables, on a line under the staff and everything below it", fn() {
    plain = score_engrave("{ c''4 d''4 e''4 f''4 }", 100.0)["systems"][0]
    sung = score_engrave("{ c''4 d''4 e''4 f''4 } \\addlyrics { Wonderfully extraordinarily long words }", 100.0)["systems"][0]
    gap = fn(sys) { sys["bars"][0]["items"][1]["x"] - sys["bars"][0]["items"][0]["x"] }
    check("a long syllable pushes the next note away", gap(sung) > gap(plain) + 2.0, true)
    check("no line where nothing is sung", plain.has_key("lyric_y"), false)
    check("the line under the staff", sung["lyric_y"] > 5.2, true)
    low = score_engrave("{ c'4 d'4 a4 g4 } \\addlyrics { la la la la }", 100.0)["systems"][0]
    check("and under low notes too", low["lyric_y"] > sung["lyric_y"], true)
    check("the system reaches past it", score_reach(sung)[1] > sung["lyric_y"], true)
  })

  test("lyrics: each staff of a choir its own, and one verse a staff", fn() {
    src = "\\new ChoirStaff << \\new Staff { c''4 d''4 e''2 } \\addlyrics { Ky -- ri -- e } \\new Staff { a'4 b'4 c''2 } \\addlyrics { e -- lei -- son } >>"
    parsed = score_parse(src)
    check("each staff's words", parsed["staves"].map { |stf| stf["lyrics"].map { |sy| sy["text"] }.join(" ") }, ["Ky ri e", "e lei son"])
    sys = score_engrave(src, 100.0)["systems"][0]
    check("a line under each staff", sys["staves"].map { |ss| ss.has_key("lyric_y") }, [true, true])
    check("one verse", (spec_refusal("{ c'4 } \\addlyrics { la } \\addlyrics { lo }") ?? "").includes?("one verse"), true)
    check("a lyric's letters are its own", spec_refusal("{ c'4 } \\addlyrics { Frère! }") ?? "", "")
  })

  test("lyrics in the editor: typed for a track, written after its music, read back, one step to undo", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    before = st["undo"].length
    for typed in ["Frè", "Frè --", "Frè -- re Jac -- ques"]
      st = score_editor({"event": "lyrics", "params": {"payload": typed}, "state": st})
    end
    check("a run of typing, one step", st["undo"].length - before, 1)
    src = score_ed_layout(st)["src"]
    check("the music braced, the words after it", src.includes?("} \\addlyrics { Frè -- re Jac -- ques }"), true)
    check("the engraving sings them", score_engrave(src, 100.0)["systems"][0]["bars"][0]["items"].map { |ev| ev["lyric"]["text"] }, ["Frè", "re", "Jac", "ques"])
    check("the count", score_ed_lyrics_count(st), {"syllables": 4, "notes": 4})
    back = score_ed_from_source(spec_state(), src)
    check("read back", score_ed_tracks(back)[0]["lyrics"], "Frè -- re Jac -- ques")
    st = score_ed_undo(st)
    check("undone", score_ed_tracks(st)[0]["lyrics"] ?? "", "")
    check("what would close the block or start a command is not written", score_ed_lyrics_ly("la {li} \\lo"), "la li lo")
  })

  test("lyrics in a full score: each track's after its staff, and each staff's read back as its track's", fn() {
    # Built track by track: reading a source of several staves checks it
    # with the server's native engraver, which knows lyrics only once lang
    # is built against this eui-score.
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''2 }")
    st = score_editor({"event": "lyrics", "params": {"payload": "Ky -- ri -- e"}, "state": st})
    st = score_ed_track_add(st)
    st = score_ed_key(score_ed_key(score_ed_key(st, "a", 0), "b", 0), "c", 0)
    st = score_editor({"event": "lyrics", "params": {"payload": "e -- lei -- son"}, "state": st})
    full = score_ed_full_source(st)
    check("both staves sing", [full.includes?("\\addlyrics { Ky -- ri -- e }"), full.includes?("\\addlyrics { e -- lei -- son }")], [true, true])
    check("and it engraves", score_engrave(full, 100.0)["systems"][0]["staves"].map { |ss| ss.has_key("lyric_y") }, [true, true])
    check("each staff's words read back", score_parse(full)["staves"].map { |stf| score_ed_lyrics_text(stf["lyrics"]) }, ["Ky -- ri -- e", "e -- lei -- son"])
  })

  test("a beam stops at a spacer, and voices that cross stand apart", fn() {
    bar = score_engrave("{ << { c'4 d'4 e'4 c'4 } \\\\ { c''8 s8 c''8 s8 s2 } >> }", 100.0)["systems"][0]["bars"][0]
    twos = bar["items"].filter { |ev| ev["voice"] == 2 }
    check("two eighths a beat apart, each its own flag", twos.map { |ev| ev["beam"].nil? }, [true, true])
    ones = bar["items"].filter { |ev| ev["voice"] != 2 }
    check("the stem-up voice under the stem-down one: a head to the right", [ones[0]["x"] > twos[0]["x"], ones[1]["x"] > twos[1]["x"]], [true, true])
    still = score_engrave("{ << { c'4 d'4 e'4 c'4 } \\\\ { c''8 d''8 s2. } >> }", 100.0)["systems"][0]["bars"][0]
    check("neighbours still share a beam", still["items"].filter { |ev| ev["voice"] == 2 }.map { |ev| ev["beam"].nil? }, [false, false])
    apart = score_engrave("{ << { e''4 f''4 g''2 } \\\\ { c'4 d'4 e'2 } >> }", 100.0)["systems"][0]["bars"][0]
    check("voices well apart share their column", apart["items"][0]["x"], apart["items"][1]["x"])
  })

  test("two voices on a staff: stems up and down, columns shared, rests out of the way", fn() {
    src = "\\relative c'' { \\time 4/4 << { e4 f g2 } \\\\ { c,4 d8 r e2 } >> }"
    bar = score_engrave(src, 100.0)["systems"][0]["bars"][0]
    items = bar["items"]
    check("both voices in the bar", items.length, 7)
    ones = items.filter { |ev| ev["voice"] == 1 }
    twos = items.filter { |ev| ev["voice"] == 2 }
    check("the first voice's stems up", ones.all? { |ev| ev["up"] }, true)
    check("the second's down", twos.filter { |ev| ev["k"] == "note" }.any? { |ev| ev["up"] }, false)
    check("what starts together stands together", ones[0]["x"], twos[0]["x"])
    rest = twos.find { |ev| ev["k"] == "rest" }
    check("the second voice's rest two spaces down", score_rest_lift(rest), 2.0)
    check("a second voice the same length, or refused", (spec_refusal("{ << { c'2 } \\\\ { d'4 } >> }") ?? "").includes?("not as long"), true)
  })

  test("a second voice in the editor: its own notes, written beside the first, every key and click working on it", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    st = score_ed_key(st, "2", 12)
    check("Ctrl+Alt+2: the second voice", st["voice"], 2)
    st = score_ed_key(st, "c", 0)
    check("a note written in it", st["notes"].length, 1)
    src = score_ed_layout(st)["src"]
    check("written beside the first", src.includes?("<< {") && src.includes?("\\\\"), true)
    check("filled with spacers to the first voice's end", src.includes?(" s"), true)
    laid = score_ed_layout(st)
    check("a click picks in the second voice", laid["map"].filter { |o| o >= 0 }.length, 1)
    check("the playhead lights the first", laid["map1"].filter { |o| o >= 0 }.length, 4)
    bar = score_engrave(src, 100.0)["systems"][0]["bars"][0]
    check("both voices engraved", bar["items"].length, 5)
    st = score_ed_key(st, "1", 12)
    check("Ctrl+Alt+1: the first voice again, untouched", st["notes"].length, 4)
    st = score_ed_undo(score_ed_key(st, "2", 12))
    check("undo keeps the voices apart", score_ed_v1(st)["notes"].length, 4)
  })

  test("in the second voice an insert-mode press writes at that moment, the silence around it kept", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    st = score_ed_set_voice(score_ed_flag(st, "tool", SCORE_ED_TOOLS[1]), 2)
    drawn = score_ed_engrave(st)
    sp = score_ed_space(st)
    sys = drawn["engraved"]["systems"][0]
    third = sys["bars"][0]["items"][2]
    at = [(third["x"] + 0.6) * sp, (sys["top"] + 5.0) * sp]
    st = score_editor({"event": "press", "params": {"payload": at, "props": {"page": 0}}, "state": st})
    check("silence for two beats, then the note", st["notes"].map { |nt| [nt["rest"], nt["spacer"] == true] }, [ [true, true], [false, false] ])
    check("on the third beat", score_ed_ticks(st["notes"][0]), score_whole() / 2)
    check("the first voice untouched", score_ed_v1(st)["notes"].length, 4)
  })

  test("a repeat from the first bar is written and drawn after the clef", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 | g''1 }")
    st["sel"] = 0
    st = score_ed_key(st, "[", 0)
    src = score_ed_full_source(st)
    check("written before the first note", src.includes?("\\bar \".|:\" c''4"), true)
    first = score_engrave(src, 100.0)["systems"][0]["bars"][0]
    check("drawn at the start of the line", first["open_repeat_x"].nil?, false)
    check("past the time signature", first["open_repeat_x"] > first["x0"], true)
    plain = score_engrave("{ \\repeat volta 2 { c''4 d''4 e''4 f''4 } g''1 }", 100.0)["systems"][0]["bars"][0]
    check("a volta from the start still draws none, as LilyPond", plain["open_repeat_x"].nil?, true)
  })

  test("the tune is a MIDI file the window plays", fn() {
    st = spec_state()
    played = score_ed_play(st)
    assert(!played["audio"]["asset"].nil?)
    check("a note starts where the one before ends", played["starts"].take(2), [0, 600])
    song = score_ed_sounds(played).find { |n| n["key"].starts_with?("song:") }
    check("with the bank beside it", song["p"]["soundfont"], score_ed_soundfont())
    played = score_ed_playhead(played, [700, 9000])
    check("the playhead lights the second note", played["play_at"], 1)
  })
})


describe("titles, tempo and changes", fn() {
  test("a header is read, and a field it does not know refused", fn() {
    head = score_parse(SPEC_SUITE)["header"]
    check("the title", head["title"], "Petite suite")
    check("the composer", head["composer"], "Anonyme")
    assert(spec_refusal("\\header { colour = \"red\" } { c'4 }").includes?("colour"))
  })

  test("the title is centred and the composer set right, LilyPond's way", fn() {
    head = score_header_lines({"title": "Suite", "composer": "Anonyme"}, 100.0)
    title = head["lines"][0]["cells"][0]
    composer = head["lines"][1]["cells"][0]
    check("the title is bold, four steps up", [title["weight"], title["em"].round(2)], ["bold", score_em(4.0).round(2)])
    check("centred", (title["x"] + score_text_width("Suite", "bold", title["em"]) / 2.0).round(2), 50.0)
    check("flush right", (composer["x"] + score_text_width("Anonyme", "regular", composer["em"])).round(2), 100.0)
    assert(head["lines"][1]["y"] - head["lines"][0]["y"] >= 3.49)
  })

  test("the titles stand clear of the margin above and of the music below", fn() {
    head = score_header_lines({"title": "Suite"}, 100.0)
    title = head["lines"][0]
    check("the title's top a pad under the margin", (title["y"] - 0.72 * score_em(4.0)).round(2), score_title_pad())
    check("the block a pad past the title's descent", (head["bottom"] - title["y"] - 0.25 * score_em(4.0)).round(2), score_title_pad())
    check("no titles, no room", score_header_lines({}, 100.0)["bottom"], 0.0)
  })

  test("a tempo mark lands on the note after it, over the staff", fn() {
    engraved = score_engrave(SPEC_SUITE, 100.0)
    marks = engraved["systems"].map { |sys| sys["marks"].length }.reduce(fn(acc, n) acc + n, 0)
    check("two marks", marks, 2)
    for sys in engraved["systems"]
      for mk in sys["marks"]
        assert(mk["y"] < -0.9)
      end
    end
    assert(spec_refusal("{ \\tempo 4 = 1000 c'4 }").includes?("1000"))
    assert(spec_refusal("{ \\tempo c'4 }").includes?("\\tempo"))
  })

  test("a key change cancels what the new key drops", fn() {
    check("sharps to flats: all of them", score_key_cancel(1, -2), 0)
    check("three sharps to one: the last two", score_key_cancel(3, 1), 1)
    check("one sharp to three: none", score_key_cancel(1, 3), -1)
    check("to C: all", score_key_cancel(-2, 0), 0)
    check("from C: none", score_key_cancel(0, 2), -1)
  })

  test("on A4 the music breaks into pages that stay inside the margins", fn() {
    summary = spec_a4_summary("\\relative c'' { " + ("c8 d e f g a b c | c b a g f e d c | " * 40) + "}")
    assert(summary["pages"] > 1)
    check("every system inside the margins", summary["inside"], true)
    check("the first system is indented", summary["left"], summary["want_left"])
  })
})

describe("the editor's titles, tempo and changes", fn() {
  test("the header and the tempo are written into the source", fn() {
    st = spec_state()
    st = score_ed_header_set(st, "subtitle", "pour piano")
    src = score_ed_layout(st)["src"]
    assert(src.includes?("\\header { title = \"Frère Jacques\" subtitle = \"pour piano\" composer = \"Traditional\" }"))
    assert(src.includes?("\\tempo \"Moderato\" 4 = 100"))
    st = score_ed_tempo(st, 132, "", false)
    assert(!score_ed_layout(st)["src"].includes?("\\tempo"))
    check("but the sound keeps the speed", st["tempo"], 132)
    check("and nobody plays at 900", score_ed_tempo(st, 900, "", true)["tempo"], 132)
  })

  test("a key or a metre from the selected bar is written where that bar starts", fn() {
    st = spec_state()
    st["scope"] = SCORE_ED_SCOPES[1]
    st["sel"] = 9
    st = score_ed_settings(st, "key", "D")
    src = score_ed_layout(st)["src"]
    assert(src.includes?("| \\key d \\major e'4"))
    check("the key in force at the selection", score_ed_key_at(st, 9), "D")
    check("and before it", score_ed_key_at(st, 3), "C")
    check("the engraver takes it", spec_refusal(src), "")
    st = score_ed_settings(st, "time", "3/4")
    assert(score_ed_layout(st)["src"].includes?("\\time 3/4"))
    check("still engraves", spec_refusal(score_ed_layout(st)["src"]), "")
  })

  test("a change waits for a bar line when the bar moved under it", fn() {
    st = spec_state()
    st["scope"] = SCORE_ED_SCOPES[1]
    st["sel"] = 4
    st = score_ed_settings(st, "key", "G")
    st["notes"][0]["base"] = 2
    src = score_ed_layout(st)["src"]
    check("still engraves", spec_refusal(src), "")
    assert(src.includes?("| \\key g \\major"))
  })

  test("the source reads back with its titles, tempo and changes", fn() {
    back = score_ed_from_source(spec_state(), SPEC_SUITE)
    check("the title", back["header"]["title"], "Petite suite")
    check("the opening tempo", [back["tempo"], back["tempo_text"]], [112, "Allegretto"])
    check("the opening key and metre", [back["key"], back["time"]], ["G", "3/4"])
    changes = back["notes"].filter { |nt| (nt["set"] ?? {}).keys.length > 0 }
    check("two changes on the notes", changes.length, 2)
    check("the second is D major in 6/8", [changes[1]["set"]["key"], changes[1]["set"]["time"]], ["D", "6/8"])
    again = score_ed_from_source(spec_state(), score_ed_layout(back)["src"])
    check("and round again to the same source", score_ed_layout(again)["src"], score_ed_layout(back)["src"])
  })

  test("a tempo keeps the note its beat is counted in", fn() {
    back = score_ed_from_source(spec_state(), "{ \\tempo \"Vivace\" 8 = 160 c'4 d' | \\tempo \"Presto\" 2 = 96 e'2 }")
    src = score_ed_layout(back)["src"]
    assert(src.includes?("\\tempo \"Vivace\" 8 = 160"))
    assert(src.includes?("\\tempo \"Presto\" 2 = 96"))
    check("eight to the minute at 160 is a quarter at 80", score_ed_note_ms(160, 8, score_ed_note(0, 4, 0, 4, 0)).round(1), 750.0)
  })

  test("A4 has pages, and a click on one picks on that page", fn() {
    st = spec_state()
    st["view"] = SCORE_ED_VIEWS[1]
    drawn = score_ed_engrave(st)
    check("one page", drawn["engraved"]["pages"].length, 1)
    sys = drawn["engraved"]["systems"][0]
    third = sys["bars"][0]["items"][2]
    at = [(third["x"] + 0.5) * drawn["sp"], (sys["top"] + score_y(third["heads"][0]["pos"])) * drawn["sp"]]
    check("the third note", score_ed_pick(st, at, 0)["sel"], 2)
  })
})

describe("repeats and bars of rest", fn() {
  test("a repeat with two endings: the signs, the brackets and the numbers", fn() {
    bars = spec_bars("\\relative c'' { c1 \\repeat volta 2 { d1 e1 } \\alternative { { f1 } { g1 } } a1 \\bar \"|.\" }")
    check("start repeat on the bar line before it", bars[0], [1, ".|:", "", 1])
    check("the first ending closes the repeat", bars[3], [4, ":|.", "1.", 1])
    check("the second ending follows it", bars[4], [5, "|", "2.", 1])
    check("and the music goes on", bars[5], [6, "|.", "", 1])
  })

  test("a repeat at the start draws no sign, and two in a row share one bar line", fn() {
    bars = spec_bars("\\relative c'' { \\repeat volta 2 { c1 d } \\repeat volta 2 { e f } }")
    check("nothing before the first bar", bars[0][1], "|")
    check("end and start back to back", bars[1][1], ":|.|:")
    check("the last end", bars[3][1], ":|.")
  })

  test("bars of rest are one bar each, or one bar with a count when compressed", fn() {
    check("spread", spec_bars("{ c''1 R1*4 c''1 }").length, 6)
    gathered = spec_bars("{ \\compressEmptyMeasures c''1 R1*4 c''1 }")
    check("gathered", gathered.length, 3)
    check("stands for four", gathered[1], [2, "|", "", 4])
    check("the next bar is counted after them", gathered[2][0], 6)
    assert(spec_refusal("{ \\compressEmptyMeasures \\time 3/4 c'2. R1*2 }").includes?("whole bar"))
    assert(spec_refusal("{ \\repeat unfold 2 { c'1 } }").includes?("volta"))
  })

  test("church rests up to ten bars, LilyPond's widths", fn() {
    check("four bars: one longa rest", score_church_width(4), 0.5)
    check("three: a breve and a whole rest", score_church_width(3).round(2), (1.1 + score_glyph("restWhole")["advance"]).round(2))
  })

  test("a start repeat on a line break moves to the next line", fn() {
    systems = score_engrave("\\relative c'' { c1 d e \\repeat volta 2 { f g a b } c }", 30.0)["systems"]
    tail = systems[0]["bars"][-1]
    check("the line ends with a plain bar line", tail["bar_drawn"], "|")
    check("the next opens with the start repeat", systems[1]["bars"][0]["open_repeat"], ".|:")
  })
})

describe("the editor's repeats and bars of rest", fn() {
  test("a repeat starts and ends at bar lines, and a second press takes it off", fn() {
    ed = spec_state()
    ed = score_ed_from_source(ed, "{ c''1 d''1 e''1 f''1 }")
    ed["sel"] = 1
    ed = score_ed_repeat(ed, "rep_start")
    ed["sel"] = 2
    ed = score_ed_repeat(ed, "rep_end")
    written = score_ed_layout(ed)["src"]
    assert(written.includes?("c''1 \\bar \".|:\" d''1 | e''1 \\bar \":|.\" f''1"))
    ed = score_ed_repeat(ed, "rep_end")
    assert(!score_ed_layout(ed)["src"].includes?(":|."))
  })

  test("an end and a start on one bar line make one sign", fn() {
    ed = spec_state()
    ed = score_ed_from_source(ed, "{ c''1 d''1 }")
    ed["sel"] = 0
    ed = score_ed_repeat(ed, "rep_end")
    ed["sel"] = 1
    ed = score_ed_repeat(ed, "rep_start")
    assert(score_ed_layout(ed)["src"].includes?("c''1 \\bar \":|.|:\" d''1"))
  })

  test("bars of rest in a row are written as one, and read back as bars", fn() {
    ed = spec_state()
    ed = score_ed_from_source(ed, "{ c''1 r1 r1 r1 d''1 }")
    laid = score_ed_layout(ed)
    assert(laid["src"].includes?("\\compressEmptyMeasures"))
    assert(laid["src"].includes?("R1*3"))
    check("the gathered bar is the first rest's", laid["map"], [0, 1, 4])
    again = score_ed_from_source(spec_state(), laid["src"])
    check("three rests again", again["notes"].length, 5)
    check("and the same source", score_ed_layout(again)["src"], laid["src"])
  })

  test("a repeat read from \\repeat volta comes back as its two signs", fn() {
    ed = score_ed_from_source(spec_state(), "\\relative c'' { c1 \\repeat volta 2 { d1 e1 } f1 }")
    check("starts", ed["notes"].map { |nt| nt["rep_start"] == true }, [false, true, false, false])
    check("ends", ed["notes"].map { |nt| nt["rep_end"] == true }, [false, false, true, false])
  })
})

describe("tuplets", fn() {
  test("a triplet lasts two thirds of what it says, a sextuplet four sixths", fn() {
    evs = score_parse("{ \\tuplet 3/2 { c'8 d' e' } \\tuplet 6/4 { c'16 d' e' f' g' a' } \\times 2/3 { c'4 d' e' } }")["events"]
    eighth = score_whole() / 8
    check("triplet eighth", evs[0]["ticks"], eighth * 2 / 3)
    check("sextuplet sixteenth", evs[3]["ticks"], eighth / 2 * 4 / 6)
    check("\\times is the same, upside down", evs[9]["ticks"], score_whole() / 4 * 2 / 3)
    check("one bar", score_measures(evs).length, 1)
  })

  test("a span makes a group of each beat's worth, each beamed alone", fn() {
    bars = score_measures(score_parse("{ \\tuplet 3/2 4 { c''8 d'' e'' f'' g'' a'' } c''2 }")["events"])
    score_beams(bars)
    items = bars[0]["items"]
    check("two tuplets", [items[0]["tuplet"]["id"], items[3]["tuplet"]["id"]], [1, 2])
    check("two beams", items[0]["beam"]["notes"].length, 3)
    assert(items[2]["beam"]["notes"][0]["i"] != items[3]["beam"]["notes"][0]["i"])
  })

  test("a beamed tuplet has its number only; a quarter-note one a bracket too", fn() {
    sys = score_engrave("{ \\tuplet 3/2 { c''8 d'' e'' } \\tuplet 3/2 { c''4 b' a' } c''4 }", 80.0)["systems"][0]
    check("two tuplets", sys["tuplets"].length, 2)
    check("under a beam, no bracket", sys["tuplets"][0]["bracket"], false)
    check("quarters, a bracket", sys["tuplets"][1]["bracket"], true)
    check("stems down, below", sys["tuplets"][1]["up"], false)
    assert(sys["tuplets"][1]["ya"] > 4.9)
  })

  test("what a tuplet cannot be is refused", fn() {
    assert(spec_refusal("{ \\tuplet 3 { c'8 d' e' } }").includes?("ratio"))
    assert(spec_refusal("{ \\tuplet 3/2 { \\tuplet 3/2 { c'8 d' e' } } }").includes?("inside"))
    assert(spec_refusal("{ \\time 2/4 c'4 \\tuplet 3/2 { c'4 d' e' } }").includes?("bar"))
    assert(spec_refusal("{ \\tuplet 11/8 { c'8 } }").includes?("cut"))
  })
})

describe("the editor's tuplets", fn() {
  test("Ctrl+3 makes a triplet of the next value, Ctrl+6 a sextuplet", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    ed["sel"] = 1
    ed = score_ed_key(ed, "3", 2)
    ed["sel"] = 4
    ed = score_ed_key(ed, "6", 2)
    src = score_ed_layout(ed)["src"]
    assert(src.includes?("\\tuplet 3/2 { d''8 d''8 d''8 }"))
    assert(src.includes?("\\tuplet 6/4 { e''16 e''16 e''16 e''16 e''16 e''16 }"))
    check("still one bar", score_ed_engrave(ed)["engraved"]["systems"][0]["bars"].length, 1)
  })

  test("the source reads back with its tuplets; a deleted note leaves a rest in its group", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 \\tuplet 3/2 { d''8 e'' f'' } g''2 }")
    check("three in the group", ed["notes"].filter { |nt| !nt["tup"].nil? }.length, 3)
    again = score_ed_from_source(spec_state(), score_ed_layout(ed)["src"])
    check("the same source", score_ed_layout(again)["src"], score_ed_layout(ed)["src"])
    ed["sel"] = 2
    ed = score_ed_delete(ed, false)
    check("still a triplet, with a rest", ed["notes"].filter { |nt| !nt["tup"].nil? }.map { |nt| nt["rest"] }, [false, true, false])
    ed = score_ed_delete(ed, false)
    check("the rest gone, no tuplet left", ed["notes"].filter { |nt| !nt["tup"].nil? }.length, 0)
  })
})

describe("forced breaks", fn() {
  test("\\break ends the line at its bar line, however much room is left", fn() {
    systems = score_engrave("{ c''1 d''1 \\break e''1 f''1 }", 200.0)["systems"]
    check("two lines", systems.map { |sys| sys["bars"].length }, [2, 2])
    assert(spec_refusal("{ c''2 \\break d''2 }").includes?("bar line"))
  })

  test("\\pageBreak starts a new page on A4, and a line on a screen", fn() {
    src = "{ c''1 d''1 \\pageBreak e''1 f''1 }"
    check("two pages", score_pages(src, {"width": 600})["engraved"]["pages"].length, 2)
    check("two lines on a screen", score_engrave(src, 200.0)["systems"].length, 2)
  })

  test("the editor sets a break after the selected bar, and reads it back", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''1 d''1 e''1 }")
    ed["sel"] = 0
    ed = score_ed_break(ed, "page")
    ed["sel"] = 1
    ed = score_ed_break(ed, "line")
    src = score_ed_layout(ed)["src"]
    assert(src.includes?("c''1 | \\pageBreak d''1 | \\break e''1"))
    again = score_ed_from_source(spec_state(), src)
    check("the same source", score_ed_layout(again)["src"], src)
    ed = score_ed_break(ed, "line")
    assert(!score_ed_layout(ed)["src"].includes?("\\break e"))
  })
})

describe("the cache", fn() {
  test("lighting a note recolours a copy of its paths and leaves the cached ones alone", fn() {
    engraved = score_engrave(SPEC_CHORALE, 80.0)
    again = score_engrave(SPEC_CHORALE, 80.0)
    check("one engraving for one source and width", again["memo_key"], engraved["memo_key"])
    plain = score_paths(engraved, 8, {})
    lit = score_paths(engraved, 8, {"marks": {"0": "accent.base"}})
    check("as many paths", lit.length, plain.length)
    assert(lit.filter { |pa| pa[1] == "accent.base" }.length > 0)
    check("the cached paths keep their ink", score_paths(engraved, 8, {}).filter { |pa| pa[1] == "accent.base" }.length, 0)
  })
})

describe("expression", fn() {
  test("dynamics, hairpins, articulations and words are read onto their notes", fn() {
    evs = score_parse("{ c''4\\p-. d''4\\< e''4-> f''4\\!^\"dolce\" g''1\\ff\\fermata }")["events"]
    check("a dynamic", evs[0]["dyn"], "p")
    check("a staccato", evs[0]["scripts"][0]["name"], "staccato")
    check("a hairpin", evs[1]["hairpin"], "<")
    check("its end", evs[3]["hairpin_end"], true)
    check("words above", evs[3]["texts"][0], {"text": "dolce", "dir": -1})
    check("two on one note", [evs[4]["dyn"], evs[4]["scripts"][0]["name"]], ["ff", "fermata"])
    assert(spec_refusal("{ c'4-% }").includes?("%") || spec_refusal("{ c'4-x }").includes?("articulation"))
  })

  test("dynamics sit below the staff, clear of the stems, on one line when they touch", fn() {
    sys = score_engrave("{ c''4\\pp\\< d'' e'' f'' | g''1\\sfz }", 80.0)["systems"][0]
    dys = sys["dynamics"]
    check("pp, a hairpin, sfz", dys.map { |dy| dy["kind"] }, ["dyn", "hairpin", "dyn"])
    check("one line", dys.map { |dy| dy["y"].round(3) }.uniq().length, 1)
    c_stem = sys["bars"][0]["items"][0]["stem_end"]
    assert(dys[0]["y"] + dys[0]["top"] >= c_stem + 0.59)
  })

  test("a staccato goes opposite the stem and into a space; a fermata above", fn() {
    sys = score_engrave("{ d''4-. a'4-. c''4\\fermata r4 }", 80.0)["systems"][0]
    check("d'' stem down: dot above, out of the staff", sys["scripts"][0]["y"], -0.5)
    check("a' stem up: dot below, in a space", sys["scripts"][1]["y"], 3.5)
    assert(sys["scripts"][2]["glyph"] == "fermataAbove")
  })
})

describe("the editor's expression", fn() {
  test("a dynamic, a hairpin, articulations and words are written after the note, and read back", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 | g''1 }")
    ed["sel"] = 0
    ed = score_ed_dynamic(ed, "p")
    ed = score_ed_hairpin(ed, "<")
    ed = score_ed_artic(ed, "staccato")
    ed["sel"] = 3
    ed = score_ed_hairpin(ed, "<")
    ed["sel"] = 2
    ed = score_ed_words(ed, "dolce", -1)
    ed["sel"] = 4
    ed = score_ed_dynamic(ed, "f")
    ed = score_ed_artic(ed, "fermata")
    src = score_ed_layout(ed)["src"]
    assert(src.includes?("c''4\\p-.\\<"))
    assert(src.includes?("f''4\\!"))
    assert(src.includes?("e''4^\"dolce\""))
    assert(src.includes?("g''1\\f-\\fermata"))
    again = score_ed_from_source(spec_state(), src)
    check("the same source", score_ed_layout(again)["src"], src)
  })

  test("pressed again, each comes off", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4\\p-. d''2. }")
    ed["sel"] = 0
    ed = score_ed_dynamic(ed, "p")
    ed = score_ed_artic(ed, "staccato")
    check("plain again", score_ed_layout(ed)["src"].includes?("c''4 d''2."), true)
  })
})

describe("a canvas for each system", fn() {
  test("the bands fill the page, and a changed note changes one band", fn() {
    long_src = "{ " + range(0, 16).map { |k| "c''4 d'' e'' f''" }.join(" | ") + " }"
    engraved = score_engrave(long_src, 60.0)
    bands = score_bands(engraved, 8, {}, 600)
    check("one band for the titles and one per system", bands.length, engraved["systems"].length + 1)
    check("they add up to the page", bands.map { |bd| bd["h"] }.reduce(fn(acc, h) acc + h, 0), 600)
    edited = score_engrave("{ " + range(0, 16).map { |k| k == 9 ? "c''4 b' e'' f''" : "c''4 d'' e'' f''" }.join(" | ") + " }", 60.0)
    again = score_bands(edited, 8, {}, 600)
    changed = range(0, bands.length).filter { |k| bands[k]["paths"] != again[k]["paths"] }.length
    check("one band redrawn", changed, 1)
  })

  test("the break search is not run again for the same widths", fn() {
    long_src = "{ " + range(0, 30).map { |k| "c''4 d'' e'' f''" }.join(" | ") + " }"
    first = score_engrave(long_src, 60.0)["systems"].map { |sys| sys["bars"].length }
    moved = score_engrave("{ " + range(0, 30).map { |k| k == 12 ? "c''4 b' e'' f''" : "c''4 d'' e'' f''" }.join(" | ") + " }", 60.0)["systems"].map { |sys| sys["bars"].length }
    check("the same lines", moved, first)
  })
})

describe("MIDI", fn() {
  test("a Standard MIDI File, a quarter 6 720 ticks, its notes where they are written", fn() {
    bytes = score_midi("{ \\time 3/4 c'4 e'4 g'4 }", {"bpm": 120})
    check("MThd, format 0, one track", bytes.take(12), [77, 84, 104, 100, 0, 0, 0, 6, 0, 0, 0, 1])
    check("the division", bytes[12] * 256 + bytes[13], 6720)
    check("then MTrk", bytes.take(18).drop(14), [77, 84, 114, 107])
    ons = range(0, bytes.length - 2).filter { |k| bytes[k] == 144 && bytes[k + 2] > 0 }.map { |k| bytes[k + 1] }
    check("C4, E4, G4", ons, [60, 64, 67])
  })

  test("a tie is one held note, and dynamics set its loudness", fn() {
    bytes = score_midi("{ c''2\\p ~ c''2 | d''1\\ff }")
    ons = range(0, bytes.length - 2).filter { |k| bytes[k] == 144 && bytes[k + 2] > 0 }.map { |k| [bytes[k + 1], bytes[k + 2]] }
    check("two attacks, p then ff", ons, [ [72, 64], [74, 114] ])
  })
})

describe("several staves", fn() {
  test("a piano staff, a staff group and plain << >>, with their names", fn() {
    parsed = score_parse("\\new PianoStaff \\with { instrumentName = \"Piano\" } << \\new Staff { c''1 } \\new Staff { \\clef bass c1 } >>")
    check("two staves", parsed["staves"].length, 2)
    check("under a brace", [parsed["groups"][0]["kind"], parsed["groups"][0]["name"]], ["brace", "Piano"])
    group = score_parse("\\new StaffGroup << \\new Staff \\with { instrumentName = \"Flûte\" midiInstrument = #\"flute\" } { c''1 } \\new Staff { \\set Staff.instrumentName = \"Cor\" c'1 } >>")
    check("a bracket", group["groups"][0]["kind"], "bracket")
    check("names, both ways", group["staves"].map { |stf| stf["props"]["instrumentName"] }, ["Flûte", "Cor"])
    check("an instrument", group["staves"][0]["props"]["midiInstrument"], "flute")
    assert(spec_refusal("<< { c'1 } { e'1 } >>").includes?("voices"))
    said = ""
    try
      score_engrave("<< \\new Staff { c'1 } \\new Staff { c'1 c'1 } >>", 80.0)
    catch e
      said = str(e)
    end
    assert(said.includes?("same bars"))
  })

  test("the staves share their columns, and stand nine spaces apart or more", fn() {
    engraved = score_engrave("\\new PianoStaff << \\new Staff { c''4 d''4 e''2 } \\new Staff { \\clef bass c2 g,2 } >>", 80.0)
    sys = engraved["systems"][0]
    up = sys["staves"][0]["bars"][0]["items"]
    down = sys["staves"][1]["bars"][0]["items"]
    check("the half note under the first quarter", down[0]["x"], up[0]["x"])
    check("the second half under the third quarter", down[1]["x"], up[2]["x"])
    assert(sys["offsets"][1] >= 9.0)
    assert(sys["staves"][0]["connect_down"] > 0.0)
  })

  test("a format-1 MIDI file, a track a staff, each with its instrument", fn() {
    bytes = score_midi("\\new StaffGroup << \\new Staff \\with { midiInstrument = \"flute\" } { c''1 } \\new Staff \\with { midiInstrument = \"cello\" } { \\clef bass c1 } >>")
    check("format 1, two tracks", bytes.take(12).drop(8), [0, 1, 0, 2])
    programs = range(0, bytes.length - 1).filter { |k| bytes[k] >= 192 && bytes[k] < 208 && (k == 0 || bytes[k - 1] == 0) }.map { |k| [bytes[k] - 192, bytes[k + 1]] }
    check("flute on 0, cello on 1", programs, [ [0, 73], [1, 42] ])
  })
})

describe("PDF", fn() {
  test("a PDF with a page per A4 page, its cross-reference where it says", fn() {
    pdf = score_pdf("\\header { title = \"Étude\" } { c''4 d''4 e''4 f''4 | g''1 }")
    assert(pdf.starts_with?("%PDF-1.4"))
    assert(pdf.includes?("/Count 1"))
    assert(pdf.includes?("/MediaBox [0 0 595.28 841.89]"))
    tail = pdf.split("startxref\n")[1]
    at = int(tail.split("\n")[0])
    check("startxref points at the xref", pdf.bytes().drop(at).take(4), [120, 114, 101, 102])
    assert(pdf.includes?("/Title <FEFF00C90074007500640065>"))
  })

  test("every page's footer: the title at the left, the page out of how many at the right", fn() {
    paper = score_a4()
    line_w = paper["w"] - paper["left"] - paper["right"]
    engraved = score_engrave_page("{ c''1 }", line_w, {"page_h": paper["h"], "top": paper["top"], "bottom": paper["bottom"], "left": paper["left"], "indent": paper["indent"], "gap": 12.0})
    foot = score_foot_paths(engraved, 1.0, 1, 3, "Etude", paper["h"] - paper["foot"])
    check("a fill for each of 2, /, 3 and E, t, u, d, e", foot.length, 8)
    number_x = foot[0][3]
    assert(number_x > paper["left"] + line_w - 5.0 && number_x < paper["left"] + line_w)
    assert(foot[3][3] < paper["left"] + score_em(-2.0))
    check("its baseline 6 mm up from the paper's edge", (paper["foot"] * 25.4 * 5.0 / 72.0).round(2), 6.0)
  })

  test("a title too long for the footer is cut short with an ellipsis, clear of the number", fn() {
    paper = score_a4()
    line_w = paper["w"] - paper["left"] - paper["right"]
    engraved = score_engrave_page("{ c''1 }", line_w, {"page_h": paper["h"], "top": paper["top"], "bottom": paper["bottom"], "left": paper["left"], "indent": paper["indent"], "gap": 12.0})
    foot = score_foot_paths(engraved, 1.0, 0, 1, "Variations " * 40, paper["h"] - paper["foot"])
    em = score_em(-2.0)
    number_w = score_text_width("1 / 1", "regular", em)
    assert(foot.length > 3)
    assert(foot.length < 3 + 400)
    last = foot[foot.length - 1]
    assert(last[3] < paper["left"] + line_w - number_w - em)
  })

  test("a long piece gives as many pages as its A4 layout", fn() {
    src = "\\relative c'' { " + ("c8 d e f g a b c | c b a g f e d c | " * 40) + "}"
    pages = score_pages(src, {"width": 600})["engraved"]["pages"].length
    assert(score_pdf(src).includes?("/Count " + str(pages)))
  })
})

describe("the editor's tracks", fn() {
  test("a track is added and edited alone; switching keeps each one's notes", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 | g''1 }")
    ed = score_ed_track_add(ed)
    check("on the new track", ed["track"], 1)
    check("empty", ed["notes"].length, 0)
    ed = score_ed_key(ed, "a", 0)
    ed = score_ed_key(ed, "ArrowUp", 4)
    check("back on the first with Alt+Up", ed["track"], 0)
    check("its notes", ed["notes"].length, 5)
    check("the other's kept", score_ed_all(ed)[1]["notes"].length, 1)
    ed = score_ed_undo(ed)
    check("undo comes back to where the edit was", ed["track"], 1)
  })

  test("the full score has a staff a track, the shorter filled with rests", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''1 | d''1 | e''1 }")
    ed = score_ed_track_add(ed)
    ed = score_ed_key(ed, "c", 0)
    src = score_ed_full_source(ed)
    assert(src.starts_with?("\\new StaffGroup << \\new Staff"))
    engraved = score_engrave(src, 100.0)
    check("two staves", engraved["systems"][0]["staves"].length, 2)
    check("three bars each", engraved["systems"].map { |sys| sys["staves"][1]["bars"].length }.reduce(fn(acc, n) acc + n, 0), 3)
  })

  test("a change from a bar is the first track's, and every staff writes it", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''1 | d''1 }")
    ed = score_ed_track_add(ed)
    ed = score_ed_key(ed, "7", 0)
    ed = score_ed_key(ed, "c", 0)
    ed = score_ed_key(ed, "c", 0)
    ed["scope"] = SCORE_ED_SCOPES[1]
    ed["sel"] = 1
    # Chosen on the second track — a note picked in the full score — it
    # lands on the first track's note that starts the same bar.
    ed = score_ed_settings(ed, "key", "G")
    check("no refusal", ed["error"], "")
    check("in both staves", score_ed_full_source(ed).split("\\key g \\major").length - 1, 2)
    ed = score_ed_undo(ed)
    check("one undo takes it back", score_ed_full_source(ed).includes?("\\key g"), false)
    ed = score_ed_switch(ed, 0)
    ed["sel"] = 1
    ed = score_ed_settings(ed, "key", "G")
    check("and from the first track as before", score_ed_full_source(ed).split("\\key g \\major").length - 1, 2)
  })

  test("staves read back as tracks, names and MIDI settings with them", fn() {
    src = "\\new PianoStaff << \\new Staff \\with { instrumentName = \"Right\" midiInstrument = \"harpsichord\" midiMaximumVolume = #0.5 midiPanPosition = #-0.5 } { c''1 } \\new Staff \\with { instrumentName = \"Left\" } { \\clef bass c1 } >>"
    ed = score_ed_from_source(spec_state(), src)
    tracks = score_ed_all(ed)
    check("two tracks", tracks.map { |trk| [trk["name"], trk["clef"]] }, [ ["Right", "Treble"], ["Left", "Bass"] ])
    check("its MIDI settings", [tracks[0]["instrument"], tracks[0]["volume"], tracks[0]["pan"]], ["harpsichord", 64, -50])
    check("a brace", ed["group"], "Brace")
    again = score_ed_from_source(spec_state(), score_ed_full_source(ed))
    check("the same source", score_ed_full_source(again), score_ed_full_source(ed))
    midi = score_midi(score_ed_full_source(ed))
    check("volume and pan as controllers", [midi.includes?(7) && midi.includes?(64), midi.includes?(10)], [true, true])
  })

  test("a click on the full score edits that staff's track, on that note", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    ed = score_ed_track_add(ed)
    ed = score_ed_key(ed, "c", 0)
    ed = score_ed_key(ed, "d", 0)
    ed = score_ed_switch(ed, 0)
    full = score_ed_conductor(ed)
    sp = score_ed_full_space(ed)
    sys = score_ed_conductor_engraved(ed, full)["systems"][0]
    second = sys["staves"][1]["bars"][0]["items"][1]
    at = [ (second["x"] + 0.5) * sp, (sys["top"] + sys["offsets"][1] + 2.0) * sp ]
    ed = score_ed_conductor_pick(ed, at)
    check("on the second track, its second note", [ed["track"], ed["sel"]], [1, 1])
  })

  test("while it plays, each track's sounding note is lit on the full score", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    ed = score_ed_track_add(ed)
    ed = score_ed_key(ed, "c", 0)
    ed = score_ed_key(ed, "5", 0)
    ed = score_ed_switch(ed, 0)
    ed["playing"] = true
    ed["starts_tracks"] = [ [0, 600, 1200, 1800], [0] ]
    ed["play_shown_ms"] = 650
    ed = score_ed_light_to(ed, 700)
    marks = score_ed_conductor_marks(ed, score_ed_conductor(ed))
    check("d'' on the first, the first note on the second", marks.keys.sort(), ["1", "4"])
  })
})


describe("sound in the window", fn() {
  test("a note written goes as MIDI commands, on its track's instrument", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 d''4 }")
    ed = score_ed_track_set(ed, "instrument", "violin")
    before = ed["blips"] ?? 0
    ed = score_ed_blip(ed, score_ed_note(0, 5, 0, 4, 0))
    check("program, on, off", ed["blip_notes"], [ [0, 192, 40, 0], [0, 144, 72, 100], [450, 128, 72, 0] ])
    check("and a new seq plays them", ed["blips"], before + 1)
    player = score_ed_sounds(ed).find { |n| n["key"] == "notes" }
    check("one player, keyed alike, its seq the count", [player["k"], player["p"]["notes_seq"], player["p"]["notes"].length], ["audio", before + 1, 3])
  })

  test("the playhead's map comes without mixing a sample", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''4 d''4 e''2 }")
    ed["tempo"] = 100
    check("a quarter at 100 is 600 ms", score_ed_timing(ed), [ [0, 600, 1200] ])
  })

  test("a muted track plays at no volume, its notes still where they were", fn() {
    ed = score_ed_from_source(spec_state(), "{ c''1 }")
    ed = score_ed_track_add(ed)
    ed = score_ed_key(ed, "c", 0)
    ed = score_ed_track_set(ed, "mute", true)
    check("silent when played", score_ed_full_source(ed, true).includes?("midiMaximumVolume = #0 "), true)
    check("but not when saved", score_ed_full_source(ed).includes?("midiMaximumVolume"), false)
    check("both tracks timed", score_ed_timing(ed).length, 2)
  })
})

describe("the arrows", fn() {
  test("a semitone at a time, spelled as the key and the direction want", fn() {
    st = spec_state()
    spell = fn(midi, by) { score_ed_spell(st, midi, by) }
    check("E up is F, in the key", spell(65, 1), [3, 0, 4])
    check("F up is F sharp", spell(66, 1), [3, 1, 4])
    check("G down is G flat", spell(66, -1), [4, -1, 4])
    check("B up is the next octave's C", spell(72, 1), [0, 0, 5])
    st["key"] = "F"
    check("A up in F major is B flat", spell(70, 1), [6, -1, 4])
  })

  test("↑ keeps to the key, Shift+↑ reaches every sharp", fn() {
    st = score_ed_from_source(spec_state(), "{ f'4 }")
    st["sel"] = 0
    up = score_ed_key(st, "ArrowUp", 0)
    check("G", score_ed_selected(up)["pitches"][0], {"step": 4, "oct": 4, "alter": 0})
    st = score_ed_from_source(spec_state(), "{ f'4 }")
    st["sel"] = 0
    shifted = score_ed_key(st, "ArrowUp", 1)
    check("F sharp", score_ed_selected(shifted)["pitches"][0], {"step": 3, "oct": 4, "alter": 1})
  })
})

describe("dragging a note", fn() {
  test("a held note follows the pointer line by line, and is one undo", fn() {
    st = spec_state()
    drawn = score_ed_engrave(st)
    sp = drawn["sp"]
    sys = drawn["engraved"]["systems"][0]
    first = sys["bars"][0]["items"][0]
    x = (first["x"] + 0.5) * sp
    on_head = (sys["top"] + score_y(first["heads"][0]["pos"])) * sp
    st = score_ed_press(st, [x, on_head, 0], 0)
    check("held", [st["sel"], st["dragging"]], [0, true])
    before = st["undo"].length
    same = score_ed_drag(st, [x, on_head + 0.2 * sp])
    check("within its line: nothing moves", score_ed_selected(same)["pitches"][0]["step"], 0)
    st = score_ed_drag(st, [x, on_head - sp])
    check("a third up: E", score_ed_selected(st)["pitches"][0]["step"], 2)
    st = score_ed_drag(st, [x, on_head - 1.5 * sp])
    check("then F", score_ed_selected(st)["pitches"][0]["step"], 3)
    check("one step to undo", st["undo"].length, before + 1)
    st = score_ed_flag(st, "dragging", false)
    check("let go, it stays", score_ed_drag(st, [x, on_head])["notes"][0]["pitches"][0]["step"], 3)
  })
})

describe("deleting", fn() {
  test("a note deleted leaves a rest of its length, and its slur goes", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4( d''2.) | e''1 }")
    st["sel"] = 1
    st = score_ed_key(st, "Delete", 0)
    gone = st["notes"][1]
    check("a half dotted rest", [gone["rest"], gone["base"], gone["dots"]], [true, 2, 1])
    check("the bar still counts four", score_ed_layout(st)["src"].includes?("r2."), true)
    check("no slur left open", st["notes"][0]["slur_on"] == true, false)
  })

  test("a last bar emptied by deleting goes; one of rests written by hand stays", fn() {
    st = score_ed_from_source(spec_state(), "{ c''1 | d''2 e''2 }")
    st["sel"] = 2
    st = score_ed_key(st, "Backspace", 0)
    check("one rest, the bar stays", st["notes"].length, 3)
    st = score_ed_key(st, "Backspace", 0)
    check("the bar is gone", st["notes"].length, 1)
    st = score_ed_from_source(spec_state(), "{ c''1 | r2 e''2 }")
    st["sel"] = 2
    st = score_ed_key(st, "Delete", 0)
    check("half of it written by hand: kept", st["notes"].length, 3)
  })
})

describe("the fields", fn() {
  test("a field keeps what is typed, a space before the next word included", fn() {
    st = score_ed_header_set(spec_state(), "title", "Frère ")
    check("as typed, for the field", st["header"]["title"], "Frère ")
    st = score_ed_header_set(st, "title", "Frère \"J\"")
    check("cleaned in the source", score_ed_layout(st)["src"].includes?("title = \"Frère ”J”\""), true)
    st = score_ed_tempo(st, 100, "Allegro ", true)
    check("the tempo words as typed", st["tempo_text"], "Allegro ")
    check("and trimmed in the source", score_ed_layout(st)["src"].includes?("\\tempo \"Allegro\" 4 = 100"), true)
  })
})

describe("the range", fn() {
  test("no note goes past five ledger lines off its staff", fn() {
    st = score_ed_from_source(spec_state(), "{ c'''4 }")
    st["sel"] = 0
    for _ in range(0, 30)
      st = score_ed_key(st, "ArrowUp", 0)
    end
    top = score_ed_selected(st)["pitches"][0]
    check("stopped within reach", score_ed_pos_of(st, top) <= 14, true)
    again = score_ed_key(st, "ArrowUp", 0)
    check("one more ↑ changes nothing", score_ed_selected(again)["pitches"][0], top)
    st = score_ed_key(st, "ArrowDown", 2)
    st = score_ed_key(st, "ArrowUp", 2)
    check("Ctrl+↑ refused past it too", score_ed_pos_of(st, score_ed_selected(st)["pitches"][0]) <= 14, true)
  })

  test("a click far above the staff writes the highest note in reach", fn() {
    st = spec_state()
    check("clamped to fourteen positions", score_ed_pos_of(st, score_ed_pitch_at(st, 40)), 14)
    check("and below", score_ed_pos_of(st, score_ed_pitch_at(st, -40)), -14)
  })
})

describe("the examples", fn() {
  test("an example replaces the whole score, and Ctrl+Z brings it back", fn() {
    st = score_ed_from_source(spec_state(), "{ c''1 | d''1 }")
    st = score_ed_track_add(st)
    st = score_ed_example(st, "Frère Jacques")
    check("one track, the tune", [score_ed_tracks(st).length, st["notes"].length, st["header"]["title"]], [1, 14, "Frère Jacques"])
    st = score_ed_key(st, "z", 2)
    check("undone: the two tracks", score_ed_tracks(st).length, 2)
  })

  test("Beethoven's exposition is twelve staves the editor reads back", fn() {
    st = score_ed_example(spec_state(), SCORE_ED_EXAMPLES[1])
    check("no complaint", st["error"] ?? "", "")
    check("twelve tracks, flutes to basses", [score_ed_tracks(st).length, score_ed_tracks(st)[0]["name"], score_ed_tracks(st)[11]["name"]], [12, "Flauti", "Basso"])
    again = score_ed_from_source(spec_state(), score_ed_full_source(st))
    check("the source reads back the same", score_ed_full_source(again), score_ed_full_source(st))
  })
})

describe("page by page", fn() {
  test("a long score is cut into pages and only the one shown is drawn", fn() {
    st = score_ed_example(spec_state(), SCORE_ED_EXAMPLES[1])
    # A window whose sheet is 1018 px wide, at 12 px a space, beside the toolbar.
    st["viewport"] = {"width": 1327, "height": 900}
    st = score_ed_switch(st, 7)
    drawn = score_ed_engrave(st)
    pages = drawn["engraved"]["pages"].length
    check("several pages", pages > 2, true)
    shown = score_ed_page_shown(st, drawn["engraved"], "page")
    on_page = drawn["engraved"]["systems"].filter { |sy| (sy["page"] ?? 0) == shown }.length
    check("a page's systems, not all", on_page < drawn["engraved"]["systems"].length, true)
    one = score_bands(drawn["engraved"], drawn["sp"], {"page_index": shown}, 900)
    check("the bands drawn are that page's", one.filter { |bd| bd["h"] > 0 }.length <= on_page + 1, true)
    check("a page past the last shows the last", score_ed_page_shown(score_ed_flag(st, "page", 99), drawn["engraved"], "page"), pages - 1)
  })

  test("the page follows the selection, and paging by hand holds until it moves", fn() {
    st = score_ed_example(spec_state(), SCORE_ED_EXAMPLES[1])
    st = score_ed_switch(st, 7)
    st["sel"] = st["notes"].length - 1
    st = score_ed_follow(st)
    last = score_ed_engrave(st)["engraved"]["pages"].length - 1
    check("the last note, the last page", st["page"], last)
    st = score_ed_flag(st, "page", 0)
    st = score_ed_follow(st)
    check("paged back by hand: stays", st["page"], 0)
    st["sel"] = 0
    st = score_ed_follow(st)
    check("a note chosen: its page", st["page"], 0)
  })
})

# Each note on of a format-0 file as [tick, key], and each note off.
def spec_midi_times(bytes)
  k = 22
  at = 0
  ons = []
  offs = []
  while k < bytes.length
    delta = 0
    while bytes[k] >= 128
      delta = delta * 128 + bytes[k] - 128
      k += 1
    end
    delta = delta * 128 + bytes[k]
    k += 1
    at += delta
    status = bytes[k]
    if status == 255
      len = bytes[k + 2]
      k += 3 + len
    elsif status >= 192 && status < 224
      k += 2
    else
      ons.push([at, bytes[k + 1]]) if status >= 144 && status < 160 && bytes[k + 2] > 0
      offs.push([at, bytes[k + 1]]) if status >= 128 && status < 144
      k += 3
    end
  end
  {"ons": ons, "offs": offs}
end

describe("fermatas in MIDI", fn() {
  test("a note under a fermata lasts twice, and what follows comes later", fn() {
    q = score_whole() / 4
    plain = spec_midi_times(score_midi("{ c'4 d'4 e'4 f'4 }", {"bpm": 60}))
    held = spec_midi_times(score_midi("{ c'4 d'4\\fermata e'4 f'4 }", {"bpm": 60}))
    check("unheld: a quarter apart", plain["ons"].map { |n| n[0] }, [0, q, 2 * q, 3 * q])
    check("held: e and f a quarter later", held["ons"].map { |n| n[0] }, [0, q, 3 * q, 4 * q])
    check("d sounds two quarters", held["offs"].filter { |n| n[1] == 62 }.map { |n| n[0] }, [3 * q])
  })

  test("the playhead waits the same", fn() {
    st = score_ed_from_source(spec_state(), "{ c'4 d'4\\fermata e'4 f'4 }")
    st["tempo"] = 100
    check("600 ms a quarter, 600 more held", score_ed_timing(st), [ [0, 600, 1800, 2400] ])
  })
})

describe("the full score entry", fn() {
  test("Full score shows every staff instead of one; a track goes back to its staff", fn() {
    st = score_ed_from_source(spec_state(), "{ c''1 }")
    st = score_ed_track_add(st)
    check("one staff at first", score_ed_full_view(st), false)
    st = score_editor({"event": "full_view", "params": {"props": {}}, "state": st})
    check("the full score", score_ed_full_view(st), true)
    st = score_editor({"event": "track", "params": {"props": {"track": 1}}, "state": st})
    check("back to the second track's staff", [score_ed_full_view(st), st["track"]], [false, 1])
  })
})

describe("a MIDI keyboard", fn() {
  test("each key writes a note at the palette's duration; keys together a chord", fn() {
    st = score_ed_from_source(spec_state(), "{ c'4 }")
    st["sel"] = 0
    st["dur"] = 8
    played = [ [1000, 144, 67, 90], [1300, 128, 67, 0], [2000, 144, 60, 90], [2010, 144, 64, 80], [2015, 144, 72, 0], [2400, 176, 64, 127] ]
    st = score_ed_midi_in(st, played)
    check("two notes after the first", st["notes"].length, 3)
    check("G, an eighth", [st["notes"][1]["pitches"][0]["step"], st["notes"][1]["base"]], [4, 8])
    check("then C and E together; the velocity-0 on is an off", st["notes"][2]["pitches"].map { |p| p["step"] }, [0, 2])
  })

  test("a black key is spelled as the key of the piece has it", fn() {
    st = spec_state()
    st["key"] = "F"
    st = score_ed_midi_in(st, [ [0, 144, 70, 90] ])
    check("B flat in F major", score_ed_selected(st)["pitches"][0], {"step": 6, "alter": -1, "oct": 4})
  })
})

describe("a part's bars of rest", fn() {
  test("an instrument's own staff gathers its empty bars; the full score keeps them", fn() {
    st = score_ed_from_source(spec_state(), "\\new StaffGroup << \\new Staff { c''1 | d''1 | e''1 | f''1 | g''1 } \\new Staff { c'1 | R1*3 | c'1 } >>")
    st = score_ed_switch(st, 1)
    part = score_ed_layout(st)["src"]
    check("one multi-bar rest of three", part.includes?("R1*3"), true)
    check("compressed", part.includes?("\\compressEmptyMeasures"), true)
    full = score_ed_full_source(st)
    check("the full score writes every bar", full.includes?("R1*3"), false)
    engraved = score_engrave(part, 100.0)
    check("three bars drawn as one", engraved["systems"].map { |sys| sys["bars"].length }.reduce(fn(acc, n) acc + n, 0), 3)
  })

  test("a run stops where a bar carries a mark", fn() {
    st = score_ed_from_source(spec_state(), "\\new StaffGroup << \\new Staff { c''1 | d''1 | \\key g \\major e''1 | f''1 } \\new Staff { c'1 | R1*3 } >>")
    st = score_ed_switch(st, 1)
    part = score_ed_layout(st)["src"]
    check("not over the key change", part.includes?("R1*3"), false)
  })
})

describe("the playhead", fn() {
  test("notes shorter than the gap between two reports are lit, not skipped", fn() {
    st = score_ed_from_source(spec_state(), "{ c''8 d''8 e''8 f''8 g''2 }")
    st = score_ed_play(st)
    st["starts_tracks"] = [ [0, 150, 300, 450, 600] ]
    st = score_ed_playhead(st, [400, 2000])
    check("c, d and e began by 400 ms: all three lit", st["play_lit"][0], [1, 2])
    st = score_ed_playhead(st, [650, 2000])
    check("then f and g", st["play_lit"][0], [3, 4])
  })

  test("between two reports the playhead goes on, at most 600 ms past the last", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 }")
    st = score_ed_play(st)
    st["starts_tracks"] = [ [0, 600] ]
    st = score_ed_playhead(st, [100, 1200])
    st["play_wall"] = score_ed_now() - 0.55
    st = score_ed_play_tick(st)
    check("d lit 550 ms on", st["play_lit"][0], [1])
    st["play_wall"] = score_ed_now() - 5.0
    st = score_ed_play_tick(st)
    check("never past 700 ms with no report", st["play_shown_ms"] <= 700, true)
  })

  test("the playhead waits for the sound: nothing moves before the window's first report", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 }")
    st = score_ed_play(st)
    st["starts_tracks"] = [ [0, 600] ]
    st = score_ed_play_tick(st)
    st = score_ed_play_tick(st)
    check("still on the first note while the window synthesizes", st["play_at"], 0)
    st = score_ed_playhead(st, [650, 1200])
    check("then where the sound is", st["play_at"], 1)
  })
})

describe("hairpins, like slurs", fn() {
  test("armed on one note, closed on another; the same note drops it", fn() {
    st = score_ed_from_source(spec_state(), "{ c''4 d''4 e''4 f''4 }")
    st["sel"] = 0
    st = score_ed_hairpin(st, "<")
    check("armed, nothing written", [st["pin_from"], score_ed_layout(st)["src"].includes?("\\<")], [0, false])
    st = score_ed_hairpin(st, ">")
    check("the other button switches it", st["pin_grow"], ">")
    st["sel"] = 2
    st = score_ed_hairpin(st, "<")
    check("closed: a diminuendo from c to e", score_ed_layout(st)["src"].includes?("c''4\\> d''4 e''4\\!"), true)
    st["sel"] = 0
    st = score_ed_hairpin(st, "<")
    check("pressed on its start: gone, end and all", score_ed_layout(st)["src"].includes?("\\!"), false)
    st["sel"] = 3
    st = score_ed_key(st, "<", 1)
    st["sel"] = 1
    st = score_ed_key(st, "<", 1)
    check("backwards with the key: from d to f", score_ed_layout(st)["src"].includes?("d''4\\< e''4 f''4\\!"), true)
  })
})
