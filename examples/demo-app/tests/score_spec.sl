      "5": {"a": 556, "f": [0,480,-274,3,480,-374,403,-446,294,-446,3,250,-446,218,-437,168,-413,1,224,-602,3,278,-591,320,-586,355,-586,3,456,-586,540,-645,540,-692,3,540,-698,536,-704,532,-704,3,532,-704,528,-703,522,-700,3,482,-683,448,-675,408,-675,3,349,-675,275,-685,203,-704,1,112,-383,3,81,-363,72,-352,72,-333,3,72,-314,88,-299,108,-299,3,134,-299,149,-318,152,-355,3,183,-379,216,-391,255,-391,3,329,-391,371,-345,371,-262,3,371,-132,287,-26,184,-26,3,126,-26,77,-54,77,-87,3,77,-98,120,-119,115,-115,3,132,-127,141,-145,141,-166,3,141,-198,116,-222,81,-222,3,37,-222,4,-185,4,-137,3,4,-49,81,15,187,15,3,348,15,480,-115,480,-274,4]},
