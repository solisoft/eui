<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="EUI is a binary protocol for applications served over HTTPS without HTML, CSS or JavaScript: the server sends a resolved interface tree, a native Rust client draws it on the GPU. A one-cell update is 22 bytes.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= public_path("css/site.css") %>">
</head>
<body>
    <%= yield %>
</body>
</html>
