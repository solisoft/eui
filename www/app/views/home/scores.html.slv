<main class="sheet">
    <%- partial("layouts/top", {"here": "scores"}) %>

    <section class="hero">
        <div class="mark">Scores<span>&sect;09</span></div>
        <div>
            <h1>Music in any page, engraved where it is read.</h1>
            <p class="lede">
                The engraver the EUI client draws a <code>score</code> with, compiled to
                WebAssembly and drawing SVG: a page shows LilyPond source with no session,
                no server and no GPU. One module of 804&nbsp;KB &mdash; 236&nbsp;KB with
                brotli &mdash; and one element, <code>&lt;eui-score&gt;</code>.
            </p>

            <p>
                It lays the music out to its own width and again when that changes, a page
                at a time, in the page's text colour &mdash; so the scores below follow this
                site into its dark theme without being told. What it draws is what the
                client draws for the same source: the same engraver, held to the
                catalogue's <code>score()</code> by its golden tests. <a href="#everything">Everything it reads</a> &mdash; voices, grace notes, clefs, marks, ornaments, repeats, chord names, drums and a tablature &mdash; is below, each with its source.
            </p>

            <div class="pane">
                <b>in a page</b>
<pre>&lt;script type="module" src="/eui-score/eui-score.js"&gt;&lt;/script&gt;
&lt;eui-score src="/scores/<span class="s">piece</span>.ly"&gt;&lt;/eui-score&gt;
&lt;eui-score&gt;&lt;script type="text/x-lilypond"&gt;{ &lt;c' e' g'&gt;2 }&lt;/script&gt;&lt;/eui-score&gt;</pre>
            </div>
        </div>
    </section>

    <%# A section here is the site's two-column grid — the rail, then the
        text — so the examples go in the text's column, under the hero's. %>
    <section class="scores">
        <div></div>
        <div>
        <h2>A tune</h2>
        <p>Written in the page, inside a <code>&lt;script type="text/x-lilypond"&gt;</code>: a chord's <code>&lt;c' e' g'&gt;</code> is a tag to the HTML parser as plain text.</p>
        <%# One source, shown and drawn: the markup in the code block is the
            markup the element below reads, so the two cannot drift apart. %>
        <% tune_src = "{ \\clef treble \\time 4/4 <c' e' g'>2 <d' f' a'>2 | <e' g' b'>2 <c' e' g' c''>2 }" %>
        <div class="pane">
            <b>the markup</b>
<pre><%= "<eui-score><script type=\"text/x-lilypond\">\n" + tune_src + "\n</script></eui-score>" %></pre>
        </div>
        <div class="scores__sheet">
            <eui-score><script type="text/x-lilypond"><%- tune_src %></script></eui-score>
        </div>

        <h2>As a file is written</h2>
        <p>A <code>\global</code> of the key and the pickup, the tune and its harmony in variables, chord names over the staff, the words sung to the voice that is named for them, and the same tune on a guitar's six strings: LilyPond as its users write it, read since protocol 11 and drawn as LilyPond draws it.</p>
        <% sheet_src = [
          "global = { \\key g \\major \\time 3/4 \\partial 4 }",
          "melody = \\relative c' {",
          "  \\global",
          "  d4 | g2 b8( g) | b2 a4 | g2 e4 | d2 d4 |",
          "  g2 b8( g) | b2 a8( b) | d2. \\bar \"|.\"",
          "}",
          "harmony = \\chordmode { \\global s4 | g2. | g:7 | c | g | e:m | d:7 | g }",
          "words = \\lyricmode {",
          "  A -- ma -- zing grace, how sweet the sound",
          "  that saved a wretch like me",
          "}",
          "\\score {",
          "  <<",
          "    \\new ChordNames \\harmony",
          "    \\new Staff \\new Voice = \"tune\" \\melody",
          "    \\new Lyrics \\lyricsto \"tune\" \\words",
          "    \\new TabStaff \\melody",
          "  >>",
          "}"
        ].join("\n") %>
        <div class="pane">
            <b>the source</b>
<pre><%= sheet_src %></pre>
        </div>
        <div class="scores__sheet">
            <eui-score staff-space="7"><script type="text/x-lilypond"><%- sheet_src %></script></eui-score>
        </div>

        <h2 id="everything">Everything it reads</h2>
        <p>Each construct protocol 11 reads, set as LilyPond 2.25 sets it &mdash; every one of these was drawn beside LilyPond's own engraving of the same source while the engraver learned it. The source is under each.</p>
<% demos = [
  {
    "id": "voices",
    "title": "Two voices and a global",
    "text": [
      "<code>\\new Voice</code> twice on one staff, <code>\\voiceOne</code> with its stems up and ",
      "<code>\\voiceTwo</code> down, and a <code>\\global</code> of the key and the metre set in ",
      "the first."
    ].join(""),
    "src": [
      "global = { \\key d \\major \\time 4/4 }",
      "\\new Staff <<",
      "  \\global",
      "  \\new Voice { \\voiceOne \\relative c'' { fis4 e d2 | e4 fis8 g a2 \\bar \"|.\" } }",
      "  \\new Voice { \\voiceTwo \\relative c' { d4 cis b2 | cis4 d8 e fis2 } }",
      ">>"
    ].join("\n")
  },
  {
    "id": "pitch",
    "title": "Pickup, names, transposition",
    "text": [
      "<code>\\language \"english\"</code>, <code>\\fixed c'</code>, a <code>\\partial 4</code> that ",
      "is bar 0 and <code>q</code> repeating the chord &mdash; all of it moved up a tone by ",
      "<code>\\transpose c d</code>."
    ].join(""),
    "src": [
      "\\language \"english\"",
      "melody = \\fixed c' { \\time 3/4 \\partial 4 g8 a | <c' e' g'>4 q q | bf2 fs4 | g2. \\bar \"|.\" }",
      "\\transpose c d \\melody"
    ].join("\n")
  },
  {
    "id": "grace",
    "title": "Grace notes",
    "text": [
      "<code>\\acciaccatura</code> slashed and slurred, <code>\\appoggiatura</code> slurred, ",
      "<code>\\grace</code> beamed when there are several, <code>\\slashedGrace</code>: small, ",
      "before their note, and taking none of its time."
    ].join(""),
    "src": [
      "\\relative c'' {",
      "  \\key g \\major",
      "  \\acciaccatura e8 d4 \\appoggiatura c8 b4 \\grace { a16 b } c4 \\slashedGrace e8 d4 |",
      "  \\grace { b16 c d } e2 \\acciaccatura fis8 g2 \\bar \"|.\"",
      "}"
    ].join("\n")
  },
  {
    "id": "clefs",
    "title": "Clefs and their keys",
    "text": [
      "Tenor, soprano, baritone, <code>\"treble_8\"</code>, <code>\"bass^8\"</code> and the French ",
      "violin clef, each key signature where LilyPond puts it for that clef."
    ].join(""),
    "src": [
      "{",
      "  \\clef tenor \\key d \\major d'4 e' fis' g' |",
      "  \\clef soprano \\key bes \\major bes'4 a' g' f' |",
      "  \\clef baritone \\key c \\major c4 d e f |",
      "  \\clef \"treble_8\" c'4 d' e' f' |",
      "  \\clef \"bass^8\" c4 d e f |",
      "  \\clef french g'1 \\bar \"|.\"",
      "}"
    ].join("\n")
  },
  {
    "id": "marks",
    "title": "Marks and words",
    "text": [
      "Fingerings, a phrasing slur over a slur, <code>\\markup</code> in italic and in bold, ",
      "rehearsal marks by <code>\\mark \\default</code>, an <code>\\ottava</code> bracket, a chord's",
      " fingers above and below it, and a segno."
    ].join(""),
    "src": [
      "\\relative c'' {",
      "  \\mark \\default",
      "  c4-1 d-2\\( e-3( f-4) | g2^\\markup { \\italic dolce } e4 c\\) |",
      "  \\mark \\default",
      "  \\ottava #1 c'4 d e f | g1 \\ottava #0 |",
      "  <c,, e g>2_\\markup { \\bold \"f\" sub. } <d f-3 a-5>2",
      "  \\mark \\markup { \\musicglyph \"scripts.segno\" } \\bar \"|.\"",
      "}"
    ].join("\n")
  },
  {
    "id": "ornaments",
    "title": "Ornaments",
    "text": [
      "<code>\\trill</code>, <code>\\prall</code>, <code>\\mordent</code>, <code>\\turn</code>, ",
      "<code>\\arpeggio</code>, <code>\\glissando</code>, and tremolo strokes &mdash; ",
      "<code>c4:16</code> &mdash; which the MIDI file plays as the repetition."
    ].join(""),
    "src": [
      "\\relative c'' {",
      "  g2\\trill a4\\prall b\\mordent | c1\\turn |",
      "  <c, e g c>2\\arpeggio <d f a d>2\\arpeggio |",
      "  c2\\glissando g'2 | c,4:16 d8:32 e f2:32 | c1:32 \\bar \"|.\"",
      "}"
    ].join("\n")
  },
  {
    "id": "repeats",
    "title": "Repeats and a cadenza",
    "text": [
      "<code>\\repeat unfold</code> written out, <code>volta</code> with its endings, ",
      "<code>percent</code> drawn as the sign, and a <code>\\cadenzaOn</code> with no bar line or ",
      "beam but the ones written."
    ].join(""),
    "src": [
      "\\relative c' {",
      "  \\repeat unfold 2 { c8 d e f } |",
      "  \\repeat volta 2 { g2 a4 b } \\alternative { { c2 c } { c1 } } |",
      "  \\repeat percent 2 { g4 a b c } |",
      "  \\cadenzaOn c8 d e f g a b c \\cadenzaOff \\bar \"|.\"",
      "}"
    ].join("\n")
  },
  {
    "id": "chords",
    "title": "Chord names",
    "text": [
      "<code>\\new ChordNames</code> over the chords themselves, named as LilyPond names them: m, ",
      "⁷, △, ø, °, sus, ♭⁹, a bass after the slash, N.C. for a rest."
    ].join(""),
    "src": [
      "harmony = \\chordmode {",
      "  c2 c:m | c:7 c:maj7 | c:m7 c:dim7 | c:aug c:sus4 |",
      "  c:9 c:m7.5- | c:7.9- c/e | bes:7 fis:m7 | aes:maj7 r",
      "}",
      "<< \\new ChordNames \\harmony \\new Staff \\harmony >>"
    ].join("\n")
  },
  {
    "id": "drums",
    "title": "A drum kit",
    "text": [
      "<code>\\drums</code>: the hi-hat, open and closed, over the bass drum, the snare and the ",
      "toms, each where LilyPond's <code>drums-style</code> puts it, in the shape of its head; ",
      "MIDI plays them on the percussion channel."
    ].join(""),
    "src": [
      "\\drums {",
      "  \\time 4/4",
      "  <<",
      "    { hh8 hh hh hh hho hh hhc hh | cymc4 hh8 hh tomh tomh toml toml }",
      "    \\\\",
      "    { bd4 sn bd8 bd sn4 | bd4 sn tomfh tomfl }",
      "  >>",
      "}"
    ].join("\n")
  },
  {
    "id": "tab",
    "title": "A tablature",
    "text": [
      "The same music on a guitar's six strings, each note on the highest string that reaches it;",
      " <code>\\2</code> and <code>\\4</code> name a string, circled on the staff."
    ].join(""),
    "src": [
      "melody = \\relative c { c4 e g c | e c\\2 g e | <c, e g c>1 | a'4 c e a\\4 | g1 \\bar \"|.\" }",
      "<< \\new Staff { \\clef \"treble_8\" \\melody } \\new TabStaff \\melody >>"
    ].join("\n")
  }
] %>
        <nav class="scores__jump" aria-label="What it reads">
<% for d in demos %>            <a href="#<%= d["id"] %>"><%= d["title"] %></a>
<% end %>        </nav>
<% for d in demos %>
        <h3 id="<%= d["id"] %>"><%= d["title"] %></h3>
        <p><%- d["text"] %></p>
        <div class="scores__sheet">
            <eui-score staff-space="7"><script type="text/x-lilypond"><%- d["src"] %></script></eui-score>
        </div>
        <details class="scores__source"><summary>The source</summary>
<pre><%= d["src"] %></pre>
        </details>
<% end %>

        <h2>A full score, a page at a time</h2>
        <p>Beethoven's Fifth, the exposition &mdash; thirteen staves, read from a file and laid out to pages the height of a screen. The element says how many pages there are, and this page builds its own pager from that.</p>
        <div class="scores__pager">
            <button type="button" data-turn="-1">Previous</button>
            <span class="scores__where" role="status">Page 1</span>
            <button type="button" data-turn="1">Next</button>
        </div>
        <div class="scores__sheet">
            <eui-score id="scores-beethoven" src="/eui-score/beethoven.ly" staff-space="6" page-height="900"></eui-score>
        </div>

        <h2>On paper</h2>
        <p><code>paper="a4"</code>: an A4 sheet at LilyPond's staff size, scaled to the width.</p>
        <div class="scores__sheet scores__sheet--a4">
            <eui-score paper="a4"><script type="text/x-lilypond">
\header { title = "Chords" }
{ \clef treble \time 3/4 <c' e' g'>2. | <d' f' a'>2. | <b d' g'>2 r4 | <c' e' g' c''>2. }
</script></eui-score>
        </div>
        </div>
    </section>
</main>

<style>
    .scores h2 { font-family: var(--serif); font-weight: 400; font-size: 1.75rem; margin: 3rem 0 0.5rem; }
    .scores h2:first-child { margin-top: 0; }
    .scores p { color: var(--ink-soft); max-width: var(--measure); }
    .scores__sheet { color: var(--ink); background: var(--paper-sunk); border: 1px solid var(--rule-faint); border-radius: 4px; padding: 1rem; margin: 1rem 0; }
    .scores__sheet--a4 { max-width: 40rem; }
    .scores h3 { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; margin: 2.25rem 0 0.4rem; scroll-margin-top: 1.5rem; }
    .scores__jump { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; margin: 1rem 0 0.5rem; font-family: var(--mono); font-size: 0.8rem; }
    .scores__jump a { color: var(--ink-soft); }
    .scores__source { margin: -0.5rem 0 0; }
    .scores__source summary { cursor: pointer; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
    .scores__source pre { margin-top: 0.6rem; padding: 0.85rem 1rem; background: var(--paper-sunk); border: 1px solid var(--rule-faint); border-radius: 4px; overflow-x: auto; }
    .scores__pager { display: flex; gap: 0.75rem; align-items: center; font-family: var(--mono); font-size: 0.875rem; color: var(--ink-soft); }
    .scores__pager button { font: inherit; color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 4px; padding: 0.25rem 0.75rem; cursor: pointer; }
    .scores__pager button:disabled { opacity: 0.4; cursor: default; }
</style>

<%# The element, imported from an inline module so it runs on every visit —
    the site swaps `<body>` on a link click, and a script tag in a swapped body
    is not a script that ran. The import is cached, the element is defined
    once, and every `<eui-score>` this page inserts is upgraded by the
    browser. The version is the one `xtask-web` stamped into the manifest
    beside the module, as /demo does for the client. The pager listens on the
    element it was built for and nothing else. %>
<script type="module">
    import <%- "\"/eui-score/eui-score.js?v=" + score_build + "\"" %>;
    const score = document.getElementById("scores-beethoven");
    const where = document.querySelector(".scores__where");
    const buttons = [...document.querySelectorAll(".scores__pager button")];
    if (score && !score.dataset.pagerWired) {
        score.dataset.pagerWired = "1";
        score.addEventListener("eui-score:engraved", (e) => {
            const { pages, page } = e.detail;
            where.textContent = `Page ${page + 1} of ${pages}`;
            buttons[0].disabled = page === 0;
            buttons[1].disabled = page + 1 >= pages;
        });
        for (const b of buttons) {
            b.addEventListener("click", () => {
                const next = Math.max(0, Number(score.getAttribute("page") || 0) + Number(b.dataset.turn));
                score.setAttribute("page", String(next));
            });
        }
    }
</script>
