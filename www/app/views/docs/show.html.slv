<main class="sheet docs">
    <%- partial("layouts/top", {"here": here}) %>

    <div class="docs-shell">
        <%# The rail is the whole table of contents, thirty titles long. Beside
            the page it costs nothing; above it, on a phone, it is a screen of
            links to scroll past before the first sentence. So a narrow window
            gets it folded into one line that says where you are, and opens it
            when asked; the two are the same list, and CSS shows one. %>
        <details class="docs-jump">
            <summary>Contents <span><%= title %></span></summary>
            <nav aria-label="Documentation"><%- partial("docs/rail_list", {"sections": sections, "slug": slug}) %></nav>
        </details>

        <nav class="docs-rail" aria-label="Documentation"><%- partial("docs/rail_list", {"sections": sections, "slug": slug}) %></nav>

        <article class="docs-page">
            <div class="prose"><%- html %></div>

            <%# A page that is not there (`DocsController#_missing`) has no file to
                be rendered from and nothing to edit. %>
            <% if !source.nil? %>
            <p class="colophon">
                Rendered from <code><%= source %></code> in the repository. The
                normative text is <code>spec/</code>; where it and a prose page
                disagree the spec wins, and that is a bug worth reporting.
                <a href="https://github.com/solisoft/eui/blob/main/<%= source %>">Edit this page</a>
            </p>
            <% end %>
        </article>
    </div>
</main>

<%# Only on a page that runs a session (`::: eui …` in its markdown); the
    script fetches nothing until a figure's button is pressed. %>
<% if !eui_build.nil? %>
<script type="module" src="<%= "/eui/eui-embed.js?v=" + eui_build %>"></script>
<% end %>
