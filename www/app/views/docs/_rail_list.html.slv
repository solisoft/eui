<% for section in sections %>
    <h2><%= section["title"] %></h2>
    <ol>
        <% for item in section["items"] %>
            <li>
                <a href="/<%= item["slug"] %>"<% if item["slug"] == slug %> aria-current="page"<% end %>><%= item["title"] %></a>
            </li>
        <% end %>
    </ol>
<% end %>
