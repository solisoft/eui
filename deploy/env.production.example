# Template for /home/rocky/sites/<domain>/.env (production).
#
#   install -m 0600 deploy/env.production.example /home/rocky/sites/eui.solisoft.net/.env
#   # then fill in the values.
#
# This file is never committed with values and never sent by the CI. Do not
# create a .env.production in the repository: the rsync would deliver it and
# Soli would load it over this one.

APP_ENV=production

# Required at boot in production (the server refuses to start without them).
# SOLI_APP_HOSTS is what the CSRF origin checks are made against.
SOLI_APP_HOSTS=eui.solisoft.net
# 32 characters minimum: `openssl rand -hex 32`
SOLI_SESSION_SECRET=

# Behind soli-proxy on the same machine: the X-Forwarded-* headers are honoured.
SOLI_TRUST_PROXY=1
SOLI_TRUSTED_PROXIES=127.0.0.1,::1

# This site has no database: no SOLIDB_* lines, no migrations, nothing to
# provision. It serves views and the Markdown under docs/ from disk.
